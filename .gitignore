# .gitignore —— 让 git 只跟踪"人和 agent 真正要改的东西"
#
# 取舍原则：
#   1. 大块只读资料区（原始资料/ refs/ 现场照片/ _toolchain_pkg/）不进 git —— 它们是原件与派生素材，占 ~96% 体积。
#   2. **hex 要进 git**：本工程的验收靠 hex 的 SHA256 指纹与"逐字节相同"比对，进 git 才看得出到底变没变。
#   3. 链接中间产物（.OBJ/.M51/.ABS/.LST）不进 git —— 可重建。
#   4. 报告 docx/pdf 是交付件，但体积大且二进制，不进 git；源在 docs/*.md 与 _hw_report_src/。

# 大件只读资料区
原始资料/
refs/
现场照片/
_toolchain_pkg/
Objects/
Listings/

# 工具运行的临时目录（pip 构建缓存等，权限还可能拒绝访问）
tools/_tmp/

# 固件构建的 scratch 目录（build_c_abs.ps1 的 $scratch = firmware/c51/_tmp）
# 里面是中间 .hex/.asm/.LST，每轮重编即重建
firmware/c51/_tmp/

# Python 字节码缓存
__pycache__/
*.pyc

# 办公文档与派生镜像
*.pdf
*.docx
*.doc
*.pptx
*.xlsx
*.htm
*.html
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.zip
*.rar
*.exe
*.DLL
*.dll
*.LIB
*.lib

# Keil 链接中间产物（hex 保留！）
*.OBJ
*.obj
*.M51
*.m51
*.ABS
*.abs
*.LST
*.lst

# 构建日志与串口日志
*.log

# Keil 工程 GUI 状态（每人不同，打开工程会自动重建）
*.uvopt
*.uvgui.*
*_uvopt.bak
*_uvproj.bak

# Word 临时锁文件
~$*

# git 自身
.gitignore.bak

# 会话/工具产生的临时物（报告生成、幻灯片预览、进度插件缓存）
.tmp_report/
.preview/
.lark-slides/
.workspace-progress/
/*.xml
/*.py

# 手工备份文件（历史交给 git 就够了）
*.bak
*.bak_*
