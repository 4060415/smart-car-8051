{
  "id": "fig6",
  "title": "图 6  示教录制流程",
  "width": 415,
  "height": 556,
  "nodes": [
    {
      "id": "t1",
      "kind": "term",
      "x": 80,
      "y": 36,
      "w": 135,
      "h": 22,
      "text": "按下录制键"
    },
    {
      "id": "d1",
      "kind": "dec",
      "x": 35,
      "y": 72,
      "w": 225,
      "h": 34,
      "text": "已经在录制了吗？"
    },
    {
      "id": "RB1",
      "kind": "proc",
      "x": 280,
      "y": 72,
      "w": 130,
      "h": 34,
      "text": [
        "结束录制：把最后一段存好",
        "显示恢复，响两声"
      ]
    },
    {
      "id": "p1",
      "kind": "proc",
      "x": 35,
      "y": 124,
      "w": 225,
      "h": 52,
      "text": [
        "开始录制：先停车",
        "清空上一次的记录，记下起点时间",
        "显示“r”，响一声"
      ]
    },
    {
      "id": "p2",
      "kind": "proc",
      "x": 35,
      "y": 188,
      "w": 225,
      "h": 34,
      "text": [
        "主循环每轮：只要在录制，就采集一次数据",
        "（放在避障判断之后）"
      ]
    },
    {
      "id": "d2",
      "kind": "dec",
      "x": 35,
      "y": 234,
      "w": 225,
      "h": 34,
      "text": "记录条数满了吗？"
    },
    {
      "id": "RB2",
      "kind": "proc",
      "x": 280,
      "y": 228,
      "w": 130,
      "h": 46,
      "text": [
        "自动结束录制：停车",
        "显示“F”并长响提示",
        "（已经录到的内容保留）"
      ]
    },
    {
      "id": "p3",
      "kind": "proc",
      "x": 35,
      "y": 286,
      "w": 225,
      "h": 34,
      "text": [
        "算出距离上次采集过了多久",
        "不到一个采样间隔就直接返回"
      ]
    },
    {
      "id": "p4",
      "kind": "proc",
      "x": 35,
      "y": 332,
      "w": 225,
      "h": 34,
      "text": [
        "更新计时起点",
        "把当前“动作 + 档位”打包成一个字节"
      ]
    },
    {
      "id": "d3",
      "kind": "dec",
      "x": 35,
      "y": 378,
      "w": 225,
      "h": 34,
      "text": "动作和档位没变吗？"
    },
    {
      "id": "RB3",
      "kind": "proc",
      "x": 280,
      "y": 372,
      "w": 130,
      "h": 46,
      "text": [
        "只把这一段的时间累加",
        "时间太长或计数溢出，就另起一条"
      ]
    },
    {
      "id": "p5",
      "kind": "proc",
      "x": 35,
      "y": 430,
      "w": 225,
      "h": 34,
      "text": [
        "变了：先把上一条存好",
        "再用新的动作另起一条"
      ]
    },
    {
      "id": "p6",
      "kind": "proc",
      "x": 35,
      "y": 476,
      "w": 225,
      "h": 64,
      "text": [
        "存储一条记录",
        "开头还没有动作时，不保存",
        "条数满了就停止保存",
        "否则写入动作、档位和时长，条数加 1"
      ]
    }
  ],
