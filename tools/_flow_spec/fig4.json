      ]
    },
    {
      "id": "p2",
      "kind": "proc",
      "x": 40,
      "y": 166,
      "w": 230,
      "h": 34,
      "text": [
        "测量起始低电平的持续时间",
        "顺便存下来，方便以后排查问题"
      ]
    },
    {
      "id": "d2",
      "kind": "dec",
      "x": 40,
      "y": 212,
      "w": 230,
      "h": 36,
      "text": "起始信号长度正常吗？"
