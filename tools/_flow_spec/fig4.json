      "id": "RB2",
      "kind": "proc",
      "x": 282,
      "y": 215,
      "w": 130,
      "h": 30,
      "text": [
        "记为“信号不合格”",
        "返回"
      ]
    },
    {
      "id": "p3",
      "kind": "proc",
      "x": 40,
      "y": 260,
      "w": 230,
      "h": 34,
      "text": "测量起始高电平的持续时间"
    },
    {
      "id": "d3",
      "kind": "dec",
      "x": 40,
      "y": 306,
      "w": 230,
      "h": 36,
      "text": "后面还有数据吗？"
    },
    {
      "id": "RB3",
      "kind": "proc",
      "x": 282,
      "y": 309,
      "w": 130,
      "h": 30,
      "text": [
        "记为“重复信号”",
        "（按键还按着）"
      ]
    },
    {
      "id": "p4",
      "kind": "proc",
      "x": 40,
      "y": 354.0,
      "w": 230,
      "h": 52,
      "text": [
        "逐位接收 32 位数据",
        "每一位先是一段短的低电平，再看高电平的长短",
        "高电平短的是 0，长的是 1",
        "哪一位等超时了，就判为接收失败"
      ]
    },
    {
      "id": "p5",
      "kind": "proc",
      "x": 40,
      "y": 418.0,
      "w": 230,
      "h": 34,
      "text": [
        "检查收到的两组数据是不是互为反码",
        "（用来确认信号没有收错）"
      ]
    },
    {
      "id": "d5",
      "kind": "dec",
      "x": 40,
      "y": 464.0,
      "w": 230,
      "h": 36,
      "text": "校验通过吗？"
    },
    {
      "id": "RB5",
      "kind": "proc",
      "x": 282,
      "y": 467.0,
      "w": 130,
      "h": 42,
      "text": [
        "按情况记为“重复信号”",
        "或“信号不合格”，返回"
      ]
    },
    {
      "id": "p6",
      "kind": "proc",
      "x": 40,
      "y": 512.0,
      "w": 230,
      "h": 34,
      "text": [
        "确认收到完整信号，取出按键编号",
        "交给按键处理，然后返回"
      ]
    }
