{
  "id": "fig7",
  "title": "图 7  示教回放流程",
  "width": 415,
  "height": 570,
  "nodes": [
    {
      "id": "t1",
      "kind": "term",
      "x": 80,
      "y": 36,
      "w": 135,
      "h": 22,
      "text": "按下回放键"
    },
    {
      "id": "d0",
      "kind": "dec",
      "x": 35,
      "y": 72,
      "w": 225,
      "h": 34,
      "text": "一条记录都没有吗？"
    },
    {
      "id": "RB0",
      "kind": "proc",
      "x": 280,
      "y": 72,
      "w": 130,
      "h": 34,
      "text": [
        "显示“E”并响两声",
        "不进入回放"
      ]
    },
    {
      "id": "p1",
      "kind": "proc",
      "x": 35,
      "y": 124,
      "w": 225,
      "h": 52,
      "text": [
        "进入回放：先记住当前档位（退出时恢复）",
        "暂停避障改写动作，从第 1 条开始",
        "显示“P”，响一声"
      ]
    },
    {
      "id": "p2",
      "kind": "proc",
      "x": 35,
      "y": 188,
      "w": 225,
      "h": 34,
      "text": [
        "主循环最前：只要在回放，就优先执行回放动作",
        "（不做避障判断，也不扫描按键）"
      ]
    },
    {
      "id": "p3",
      "kind": "proc",
      "x": 35,
      "y": 234,
      "w": 225,
      "h": 22,
      "text": "① 先做安全检查（最优先）"
    },
    {
      "id": "d1",
      "kind": "dec",
      "x": 35,
      "y": 268,
      "w": 225,
      "h": 34,
      "text": "前方有危险吗？"
    },
    {
      "id": "RB1",
      "kind": "proc",
      "x": 280,
      "y": 268,
      "w": 130,
      "h": 46,
      "text": [
        "立刻停车并结束回放",
        "响两声提示",
        "（不绕行、不接着播）"
      ]
    },
    {
      "id": "p4",
      "kind": "proc",
      "x": 35,
      "y": 320,
      "w": 225,
      "h": 34,
      "text": [
        "② 接收一次遥控信号（不等候）",
        "超声波隔一段时间才测一次，免得误判"
      ]
    },
    {
      "id": "d2",
      "kind": "dec",
      "x": 35,
      "y": 366,
      "w": 225,
      "h": 34,
      "text": "收到停止键或方向键吗？"
    },
    {
      "id": "RB2",
      "kind": "proc",
      "x": 280,
      "y": 360,
      "w": 130,
      "h": 46,
      "text": [
        "人工结束回放：停车退出",
        "（不执行按下的这个方向）"
      ]
    },
    {
      "id": "d3",
      "kind": "dec",
      "x": 35,
      "y": 418,
      "w": 225,
      "h": 34,
      "text": "③ 这条动作播完了吗？"
    },
    {
      "id": "RB3",
      "kind": "proc",
      "x": 280,
      "y": 418,
      "w": 130,
      "h": 34,
      "text": [
        "返回主循环",
        "继续播这一条"
      ]
    },
    {
      "id": "d4",
      "kind": "dec",
      "x": 35,
      "y": 470,
      "w": 225,
      "h": 34,
      "text": "④ 已经是最后一条吗？"
    },
    {
      "id": "RB4",
      "kind": "proc",
      "x": 280,
      "y": 470,
      "w": 130,
      "h": 34,
      "text": [
        "接着播下一条"
      ]
    },
    {
      "id": "p5",
      "kind": "call",
      "x": 35,
      "y": 522,
      "w": 225,
      "h": 34,
      "text": [
        "结束回放：停车，回到手动模式",
        "恢复原来的档位，刷新显示"
      ]
    }
