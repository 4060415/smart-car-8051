;     if (half_cycles == 0) {                 /* 关掉鸣叫 */
			; SOURCE LINE # 721
	MOV  	A,R7
	JNZ  	?C0032
;         ET0 = 0;
			; SOURCE LINE # 722
	CLR  	ET0
;         buz_left = 0;
			; SOURCE LINE # 723
	MOV  	buz_left,A
;         buz_quiet = 1;
			; SOURCE LINE # 724
	SETB 	buz_quiet
;         ET0 = 1;
			; SOURCE LINE # 725
	SETB 	ET0
	RET  	
;         return;
;     }
			; SOURCE LINE # 727
?C0032:
;     ET0 = 0;
			; SOURCE LINE # 728
	CLR  	ET0
;     buz_left = half_cycles;
			; SOURCE LINE # 729
	MOV  	buz_left,R7
;     buz_quiet = 0;                          /* 低电平 -> PNP 导通 -> 开始发声 */
			; SOURCE LINE # 730
	CLR  	buz_quiet
;     ET0 = 1;
			; SOURCE LINE # 731
	SETB 	ET0
; }
			; SOURCE LINE # 732
?C0033:
	RET  	
; END OF _beep

; 
; /*=========================================================================
;  * 十八、串口调试输出（9600 8N1）
;  *   DEBUG_UART = 0 时全部是空函数，调用点照旧，不占体积。
;  *=========================================================================*/
; #if DEBUG_UART
; static void put_char(char c)
; {
;     SBUF = c;
;     while (!TI)
;         ;
;     TI = 0;
; }
