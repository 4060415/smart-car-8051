; /* show_state —— 显示当前档位。
;  * 录制中固定显示 r，在这里统一拦一道，免得被档位数字盖掉。 */
; static void show_state(void)

	RSEG  ?PR?show_state?MAIN
L?0427:
	USING	0
	MOV  	R7,cur_act
	LCALL	_motor_set_core
show_state:
	USING	0
			; SOURCE LINE # 986
; {
			; SOURCE LINE # 987
;     P2 = d3_mix(recon ? DISP_R : gear_tab[gear]);
			; SOURCE LINE # 988
	JNB  	recon,?C0059
	MOV  	R7,#0F5H
	SJMP 	?C0060
?C0059:
	MOV  	A,gear
	MOV  	DPTR,#gear_tab
	MOVC 	A,@A+DPTR
	MOV  	R7,A
?C0060:
	LCALL	_d3_mix
	MOV  	P2,R7
; }
			; SOURCE LINE # 989
	RET  	
; END OF show_state

; 
; /* show_mode —— 按模式刷新数码管：手动显示档位，其它模式显示模式代号。 */
; static void show_mode(void)

	RSEG  ?PR?show_mode?MAIN
show_mode:
	USING	0
			; SOURCE LINE # 992
