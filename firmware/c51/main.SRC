?C0137:
	MOV  	R7,#0FFH
?C0138:
	RET  	
?C0136:
; 
;     /* ---- 3) 两次测距之间要留间隔，间隔不够就沿用上次的结果 ----
;      * 触发太密模块会不响应，那样每次都白等一回，车看起来就像不动。 */
;     if (us_seen && (unsigned char)(t10 - us_last10) < US_GAP_MS10)
			; SOURCE LINE # 1320
	JNB  	us_seen,?C0140
