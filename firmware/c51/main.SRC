			; SOURCE LINE # 997
?C0062:
; 
;     P2 = d3_mix(mode_tab[mode]);
			; SOURCE LINE # 999
	MOV  	A,mode
	MOV  	DPTR,#mode_tab
	MOVC 	A,@A+DPTR
	MOV  	R7,A
	LCALL	_d3_mix
	MOV  	P2,R7
; }
			; SOURCE LINE # 1000
?C0063:
	RET  	
; END OF show_mode

