	MOV  	A,mode
	CJNE 	A,#01H,?C0148
;         /* 寻光是自动跑的模式，离得太近时应该把控制权交回给人，而不是原地
;          * 锁死等人来按。所以这里不锁存、也不间歇响。 */
;         mode = MODE_MANUAL;
			; SOURCE LINE # 1356
	CLR  	A
	MOV  	mode,A
;         avst = AV_HUMAN;
			; SOURCE LINE # 1357
	MOV  	avst,#03H
;         cur_act = ACT_STOP;
			; SOURCE LINE # 1358
;         motor_set(ACT_STOP, 0);
			; SOURCE LINE # 1359
	LCALL	L?0424
;         show_mode();
			; SOURCE LINE # 1360
	LCALL	show_mode
;         beep(BEEP_KEY);                     /* 寻光：退回手动，响一声*/
			; SOURCE LINE # 1361
	SJMP 	?C0397
;         return;
;     }
			; SOURCE LINE # 1363
?C0148:
; 
;     /* ---- 手动：刹停 + 锁存 ---- */
;     avst = AV_HOLD;
			; SOURCE LINE # 1366
;     cur_act = ACT_STOP;
			; SOURCE LINE # 1367
;     motor_set(ACT_STOP, 0);
			; SOURCE LINE # 1368
	LCALL	L?0422
;     show_mode();
			; SOURCE LINE # 1369
	LCALL	show_mode
; 
;     av_beep_t = tick_get();                 /* 之后由 av_gate 按间隔继续响 */
			; SOURCE LINE # 1371
	LCALL	tick_get
	MOV  	av_beep_t,R6
	MOV  	av_beep_t+01H,R7
;     /* 声音只在“新一次遇到障碍”的时候响。读数抖动会让锁存反复解除又重立，
;      * 每次都响的话听起来就是隔一会儿又响一声。
;      * 计数只在障碍真的退远以后才清零。 */
;     if (av_beep_n == 0) {
			; SOURCE LINE # 1375
	MOV  	A,av_beep_n
	JNZ  	?C0147
;         av_beep_n = 1;                      /* 这声算第 1 声 */
			; SOURCE LINE # 1376
	MOV  	av_beep_n,#01H
;         beepwhy('H');                       /* 诊断：刹停入口那一声 */
;         beep(BEEP_KEY);                     /* 响一声：手动 = 刹停锁存 */
			; SOURCE LINE # 1378
?C0397:
	MOV  	R7,#018H
	LCALL	_beep
;     }
			; SOURCE LINE # 1379
; }
			; SOURCE LINE # 1380
?C0147:
	RET  	
; END OF av_gate_hold

