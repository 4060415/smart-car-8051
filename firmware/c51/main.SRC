; 
;     if (mode == MODE_LIGHT) {
			; SOURCE LINE # 1408
	MOV  	A,mode
	CJNE 	A,#01H,?C0153
;         /* 寻光是自动跑的模式，离得太近时应该把控制权交回给人，而不是原地
;          * 锁死等人来按。所以这里不锁存、也不间歇响。 */
;         mode = MODE_MANUAL;
			; SOURCE LINE # 1411
	CLR  	A
	MOV  	mode,A
;         avst = AV_HUMAN;
			; SOURCE LINE # 1412
	MOV  	avst,#03H
;         cur_act = ACT_STOP;
