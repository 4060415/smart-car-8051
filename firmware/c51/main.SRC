			; SOURCE LINE # 898
	MOV  	A,R5
	MOV  	DPTR,#arc_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_a,A
;         dirbits = DIR_FWD;
			; SOURCE LINE # 899
	SJMP 	?C0402
;         return;
;     }
			; SOURCE LINE # 901
?C0046:
;     if (act == ACT_ARC_R) {
			; SOURCE LINE # 902
	CJNE 	R7,#06H,?C0047
;         duty_b = arc_tab[g - 1];            /* 右弧线：内轮 = 右轮 */
			; SOURCE LINE # 903
	MOV  	A,R5
	MOV  	DPTR,#arc_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_b,A
;         dirbits = DIR_FWD;
			; SOURCE LINE # 904
?C0401:
	SJMP 	?C0402
;         return;
;     }
			; SOURCE LINE # 906
?C0047:
; 
;     switch (act) {
			; SOURCE LINE # 908
	MOV  	A,R7
	ADD  	A,#0FEH
	JZ   	?C0050
	DEC  	A
	JZ   	?C0051
	DEC  	A
	JZ   	?C0052
	ADD  	A,#03H
	JNZ  	?C0053
;     case ACT_FORWARD: dirbits = DIR_FWD;   break;
			; SOURCE LINE # 909
?C0049:
?C0402:
	MOV  	dirbits,#05H
	RET  	
;     case ACT_BACK:    dirbits = DIR_BACK;  break;
			; SOURCE LINE # 910
?C0050:
	MOV  	dirbits,#0AH
	RET  	
;     case ACT_LEFT:    dirbits = DIR_LEFT;  break;
			; SOURCE LINE # 911
?C0051:
	MOV  	dirbits,#06H
	RET  	
;     case ACT_RIGHT:   dirbits = DIR_RIGHT; break;
			; SOURCE LINE # 912
?C0052:
	MOV  	dirbits,#09H
	RET  	
;     default:                                /* ACT_STOP 及任何意外值都当停车 */
			; SOURCE LINE # 913
?C0053:
;         dirbits = DIR_STOP;
			; SOURCE LINE # 914
	CLR  	A
?C0400:
	MOV  	dirbits,A
;         duty_a = 0;
			; SOURCE LINE # 915
	MOV  	duty_a,A
;         duty_b = 0;
			; SOURCE LINE # 916
	MOV  	duty_b,A
;         break;
			; SOURCE LINE # 917
;     }
			; SOURCE LINE # 918
; }
			; SOURCE LINE # 919
?C0035:
