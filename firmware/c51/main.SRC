	CLR  	C
	SUBB 	A,#06H
	JNC  	?C0140
;         return us_valid ? us_last_d : US_FAR;
			; SOURCE LINE # 1321
	JNB  	us_valid,?C0141
	MOV  	R7,us_last_d
	RET  	
?C0141:
	MOV  	R7,#0FFH
?C0142:
	RET  	
?C0140:
; 
;     /* ---- 4) 空闲且够久：发一次触发，然后立刻返回 ---- */
