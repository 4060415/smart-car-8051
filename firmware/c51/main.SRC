			; SOURCE LINE # 1325
	SETB 	us_seen
;     us_trigger();
			; SOURCE LINE # 1326
	LCALL	us_trigger
;     return us_valid ? us_last_d : US_FAR;   /* 本次不给新值，等下一次来取 */
			; SOURCE LINE # 1327
	JNB  	us_valid,?C0143
	MOV  	R7,us_last_d
	SJMP 	?C0144
?C0143:
	MOV  	R7,#0FFH
?C0144:
; }
			; SOURCE LINE # 1328
?C0139:
	RET  	
; END OF us_read

