; /*=========================================================================
;  * 十二、全局变量
;  *   分成几组：中断里用的、时基、业务状态、录制回放。
;  *   中断和主循环都要用的，一律加 volatile。
;  *=========================================================================*/
; 
; /*---- 12.1 中断内维护 ----*/
; static unsigned char pwm_div;               /* PWM 分频计数 0..PWM_DIV-1 */
; static unsigned char pwm_cnt;               /* PWM 当前步 0..19 */
; /* 这里删掉了两个只写不读的变量，给直接寻址区腾地方：
;  *   buz_div  —— 蜂鸣器改成每个 PWM 步翻转一次以后就没人读它了；
;  *   ml_start —— 本来用来存量脉宽的起始时刻，实际是存进去又马上读出来，
;  *               直接赋给 t0 就行，不需要占一个全局。
;  * 直接寻址区只有 30H~7FH 共 80 字节，加变量时要留心别超了。 */
; static volatile unsigned char buz_left;     /* 蜂鸣器还剩几个半周期 */
; static bit buz_quiet;                       /* 1 = 静音（P0.6 为高，PNP 不导通）。
;                                              * 不写静态初值，那样会生成初始化段；
;                                              * 由 init_all() 在开中断之前置 1。 */
; static bit ena;                             /* 本步 ENA 使能 */
; static bit enb;                             /* 本步 ENB 使能 */
; static volatile unsigned char tick_l;       /* 100us 时基低字节 */
; static volatile unsigned char tick_h;       /* 100us 时基高字节（溢出周期 6.55s） */
; static volatile unsigned char ms10_l;       /* 10ms 时基低字节 */
; static volatile unsigned char ms10_h;       /* 10ms 时基高字节 */
; static unsigned char ms_div;                /* 10ms 分频计数 0..99 */
; /* 超声波测距：一个纯非阻塞的小状态机。
;  * 中断每 99.83us 推一步，主循环只管发触发、取结果，一次都不干等，
;  * 所以就算模块摆烂不响应，也拖不慢主循环，遥控不至于被饿死。
;  * 这些变量都不写静态初值——本工程不跑 C 运行期那段初始化，
;  * 初值一律由 us_init() 在开中断之前手动给。 */
; #define US_ST_IDLE    0                     /* 空闲：没在测（绝大多数 tick 停在这里，中断开销最小）*/
; #define US_ST_WAIT    1                     /* 已发触发，等回波上升沿 */
; #define US_ST_HIGH    2                     /* 回波已拉高，正在数宽度 */
; static volatile unsigned char us_st;        /* 状态机当前状态 US_ST_* */
; static volatile unsigned char us_wid;       /* 本次回波已持续几个 tick（中断里 +1）*/
; static volatile bit us_got;                 /* 1 = 刚量完，结果在 us_res（主循环取走后清 0）*/
; static volatile unsigned char us_res;       /* 量到的结果：tick 数 / US_FAR = 没量到 */
; static unsigned char us_wait;               /* 等上升沿已等了多少 tick（只由中断 +1）*/
; static bit us_valid;                        /* 0 = 还没量到过：一律按"够远"报（失效安全）*/
; static bit us_seen;                         /* 节流：是否触发过一次 */
; static unsigned char us_last10;             /* 节流：上次触发时的 10ms 计数 */
; static unsigned char us_last_d;             /* 节流：上次的结果 */
; #if AV_SCOPE
; static unsigned char us_stage;              /* 自测版用：0=上升沿超时 1=够远 2=量到了 */
; #endif
; 
; /*---- 12.2 电机与档位（主循环写、中断读）----*/
; static volatile unsigned char dirbits;      /* 方向位 D0~D3 */
; static volatile unsigned char duty_a;       /* 左轮 ENA 占空比 0..20 */
; static volatile unsigned char duty_b;       /* 右轮 ENB 占空比 0..20 */
; static unsigned char gear;                  /* 当前档位 0..5 */
; static unsigned char cur_act;               /* 当前动作码（D3 指示灯靠它判"在动"） */
; /* A：倒车限时（back_guard 用；中断不碰，只在主循环里读写）*/
; static bit back_on;                         /* 1 = 正在倒车且已开始计时 */
; static unsigned int back_t0;                /* 本次倒车的起始时刻 */
; /* 超声近距提示音（"倒车雷达"）的上次发声时刻 / 停车后计时 */
; static unsigned int prox_t;
; static bit prox_moving;                     /* 1 = 车在动（用来捕捉"刚停下"的那一刻）*/
; static bit prox_hold;                       /* 1 = 还在停车后 2 秒的宽限时间里；
;                                              * 到点以后一直是 0，直到车再次动起来。 */
; static unsigned int prox_stop_t;            /* 车停下的时刻（停车后还要响 2s）*/
