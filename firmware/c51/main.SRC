			; SOURCE LINE # 1308
	MOV  	us_last_d,us_res
;         us_got    = 0;
			; SOURCE LINE # 1309
	CLR  	us_got
;         us_valid  = 1;
			; SOURCE LINE # 1310
	SETB 	us_valid
;         ET0 = 1;
			; SOURCE LINE # 1311
	SETB 	ET0
;     }
			; SOURCE LINE # 1312
?C0135:
; 
;     /* ---- 2) 正在测：先把上次的结果给出去，绝不在这里等 ---- */
;     if (us_st != US_ST_IDLE)
			; SOURCE LINE # 1315
	MOV  	A,us_st
	JZ   	?C0136
;         return us_valid ? us_last_d : US_FAR;
			; SOURCE LINE # 1316
	JNB  	us_valid,?C0137
