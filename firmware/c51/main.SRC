; 
; /*=========================================================================
;  * 三十、避障
;  *   两路传感器，分工不同：
;  *
;  *   ① 车头红外对管（P3.7，量程 1~2cm）—— 最后一道兜底
;  *        触发后先倒车 + 原地右转让开（AV_BACK / AV_ATURN），最多连续
;  *        AV_MNV_MAX 轮；仍绕不开就刹停锁存。录制中改为直接刹停；
;  *        寻光模式全关。
;  *
;  *   ② 超声波（P1.2/P1.3，量程约 5~77cm）—— 受开关控制
;  *        < 5cm        刹停 + 锁存，等遥控接管
;  *        5~17cm       原地右转避让
;  *        17~24cm      弧线右绕（不停车，保留前进分量）
;  *        已进入避让后，要退到 69cm 才放行（滞回）
;  *        ≥ 69cm       放行
;  *        决策保持约 280ms，避免拿同一份旧读数每趟改动作。
;  *
;  *   模式差异：
;  *     手动：两路都参与（超声波可用开关关闭）；
;  *     循迹：超声波不参与（会把车推离黑线），车头红外只负责刹停；
;  *     寻光：默认全关（AV_OFF_IN_LIGHT）；
;  *     回放：不走本函数，遇障直接终止（见 play_safety）。
;  *
;  *   "锁存"= 只有遥控按键才能解除；障碍自己移开只是不响，车仍停着。
;  *   有障碍时遥控和按键照样响应（响铃、换显示、录制），只拦电机动作。
;  *=========================================================================*/
; 
; /*-------------------------------------------------------------------------
;  * ir_brake —— 车头红外触发时的处理：直接刹车，不转向也不改模式。
;  *   三种模式共用这一条路。
;  *   这里用停车锁存而不是改写动作，是因为改写会把任何动作都变成原地
;  *   右转，循迹模式下会把车推离黑线。
;  *   只在刚触发时调用一次，之后的间歇提醒由避障判断那一段管。
;  *-------------------------------------------------------------------------*/
; static void ir_brake(void)

	RSEG  ?PR?ir_brake?MAIN
ir_brake:
	USING	0
			; SOURCE LINE # 1380
; {
			; SOURCE LINE # 1381
;     if (avst == AV_HUMAN)
			; SOURCE LINE # 1382
	MOV  	A,avst
	XRL  	A,#03H
	JZ   	?C0150
?C0149:
;         return;                             /* 遥控已接管 -> 放行，别再压住*/
; 
;     avst = AV_HOLD;                         /* 锁存：决定权交回遥控 */
			; SOURCE LINE # 1385
;     cur_act = ACT_STOP;
			; SOURCE LINE # 1386
;     motor_set(ACT_STOP, 0);
			; SOURCE LINE # 1387
;     show_mode();                            /* 这里用 show_mode，循迹时能保住显示的模式代号 */
			; SOURCE LINE # 1388
	LCALL	L?0436
;     av_beep_t = tick_get();                 /* 之后由 av_gate 按间隔继续响（若允许）*/
			; SOURCE LINE # 1389
	LCALL	tick_get
	MOV  	av_beep_t,R6
	MOV  	av_beep_t+01H,R7
;     av_beep_n = 0;                          /* 本次锁存的已响次数从 0 起算 */
			; SOURCE LINE # 1390
	CLR  	A
	MOV  	av_beep_n,A
; #if !IR_BEEP_SILENT
;     av_beep_n = 1;                          /* 入口这一声也算一次 */
;     beep(BEEP_KEY);                         /* 静音时不出这一声 */
; #endif
; }
			; SOURCE LINE # 1395
?C0150:
	RET  	
; END OF ir_brake

; 
; /*-------------------------------------------------------------------------
;  * av_gate_hold —— 超声波判断出太近时触发。
;  *   手动模式：停车并锁存，等遥控操作；
;  *   寻光模式：退回手动模式，把控制权交还给人。
;  *   车头红外不走这里。
;  *-------------------------------------------------------------------------*/
