; /*#########################################################################
;  * 第 3 章  中断服务与时基
;  *   Timer0 每 99.83us 进一次：时基、PWM、蜂鸣器、10ms 节拍、超声波采样。
;  *   主循环只改变量，真正的引脚输出在中断里完成。
;  *#########################################################################*/
; /*=========================================================================
;  * 十四、Timer0 中断：100us 时基 + 软件 PWM + 蜂鸣器方波 + 10ms 节拍
;  *   using 1 换一组寄存器，这样进中断就不用存主循环的 R0~R7，省点时间。
;  *   正常一趟中断就两次加法一次比较，P0 每 5 个 tick 才重新组装一次。
;  *   一趟中断必须比 99.83us 短，不然就丢 tick，PWM 直接乱套。
;  *=========================================================================*/
CSEG	AT	0000BH
	LJMP	timer0_isr

; void timer0_isr(void) interrupt 1 using 1

	RSEG  ?PR?timer0_isr?MAIN
	USING	1
timer0_isr:
	PUSH 	ACC
	PUSH 	PSW
	USING	1
	MOV  	PSW,#08H
			; SOURCE LINE # 583
; {
;     unsigned char a;
; 
;     /* ---- ① 100us 系统时基：红外脉宽测量、各种超时都靠它，必须每次都加 ---- */
;     if (++tick_l == 0)
			; SOURCE LINE # 588
	INC  	tick_l
	MOV  	R7,tick_l
	MOV  	A,R7
	JNZ  	?C0001
;         tick_h++;
			; SOURCE LINE # 589
	INC  	tick_h
?C0001:
; 
;     /* ---- ② PWM：每 PWM_DIV 个 tick 走一步 ---- */
;     if (++pwm_div >= PWM_DIV) {
			; SOURCE LINE # 592
	INC  	pwm_div
	MOV  	A,pwm_div
	CLR  	C
	SUBB 	A,#05H
	JC   	?C0002
;         pwm_div = 0;
			; SOURCE LINE # 593
	MOV  	pwm_div,#00H
; 
;         if (++pwm_cnt >= PWM_STEPS)
			; SOURCE LINE # 595
	INC  	pwm_cnt
	MOV  	A,pwm_cnt
	SUBB 	A,#014H
	JC   	?C0003
;             pwm_cnt = 0;
			; SOURCE LINE # 596
	MOV  	pwm_cnt,#00H
?C0003:
; 
;         ena = (pwm_cnt < duty_a);
			; SOURCE LINE # 598
	MOV  	R7,duty_a
	MOV  	A,pwm_cnt
	CLR  	C
	SUBB 	A,R7
	JNC  	?C0004
	SJMP 	?C0005
?C0004:
	CLR  	C
?C0005:
	MOV  	ena,C
;         enb = (pwm_cnt < duty_b);
			; SOURCE LINE # 599
	MOV  	R7,duty_b
	MOV  	A,pwm_cnt
	CLR  	C
	SUBB 	A,R7
	JNC  	?C0006
	SJMP 	?C0007
?C0006:
	CLR  	C
?C0007:
	MOV  	enb,C
; 
;         /* ---- ③ 蜂鸣器方波：每个 PWM 步（500us）翻一次 = 1kHz ---- */
;         if (buz_left) {
			; SOURCE LINE # 602
	MOV  	A,buz_left
	JZ   	?C0008
;             buz_left--;
			; SOURCE LINE # 603
	DEC  	buz_left
;             buz_quiet = ~buz_quiet;
			; SOURCE LINE # 604
	CPL  	buz_quiet
;         } else {
			; SOURCE LINE # 605
	SJMP 	?C0009
?C0008:
;             buz_quiet = 1;                  /* 半周期用完 -> 静音 */
			; SOURCE LINE # 606
	SETB 	buz_quiet
;         }
			; SOURCE LINE # 607
?C0009:
; 
;         /* ---- ④ 组装 P0（主循环永不写 P0，只改上面这几个变量）---- */
;         a = 0x80;                           /* P0.7 恒 1（未使用，且 P0 是开漏口） */
			; SOURCE LINE # 610
;---- Variable 'a?040' assigned to Register 'R7' ----
	MOV  	R7,#080H
;         a |= dirbits;                       /* D0~D3 = IN1~IN4 方向 */
			; SOURCE LINE # 611
	MOV  	A,dirbits
	ORL  	AR7,A
;         if (ena) a |= 0x10;                 /* P0.4 = ENA */
			; SOURCE LINE # 612
	JNB  	ena,?C0010
	ORL  	AR7,#010H
?C0010:
;         if (enb) a |= 0x20;                 /* P0.5 = ENB */
			; SOURCE LINE # 613
	JNB  	enb,?C0011
	ORL  	AR7,#020H
?C0011:
;         if (buz_quiet) a |= 0x40;           /* P0.6 = 1 -> 静音 */
			; SOURCE LINE # 614
	JNB  	buz_quiet,?C0012
	ORL  	AR7,#040H
?C0012:
;         P0 = a;
			; SOURCE LINE # 615
	MOV  	P0,R7
;     }
			; SOURCE LINE # 616
?C0002:
; 
;     /* ---- ⑤ 10ms 节拍分频：每个 tick 都加 ----
;      * 放在写 P0 之后，对 PWM 时序没有影响。
;      * 必须放在中断里：主循环一趟最长会被收红外堵 25.6ms，用它数节拍会有
;      * 很大误差，录制回放的时长就不准了。 */
;     if (++ms_div >= MS10_DIV) {
			; SOURCE LINE # 622
	INC  	ms_div
	MOV  	A,ms_div
	CLR  	C
	SUBB 	A,#064H
	JC   	?C0013
;         ms_div = 0;
			; SOURCE LINE # 623
	MOV  	ms_div,#00H
;         if (++ms10_l == 0)
			; SOURCE LINE # 624
	INC  	ms10_l
	MOV  	R7,ms10_l
	MOV  	A,R7
	JNZ  	?C0013
;             ms10_h++;
			; SOURCE LINE # 625
	INC  	ms10_h
;     }
			; SOURCE LINE # 626
?C0013:
; 
;     /* ---- ⑥ 超声波回波采样（非阻塞状态机，也放在写 P0 之后）----
;      * 中断每 99.83us 准时跑一次，所以数出来的回波宽度和主循环快慢无关。
;      * 主循环只负责发触发和取结果，一次都不等。
;      * 开销很小：空闲时绝大多数 tick 只走一条判断就过去了。 */
;     if (us_st != US_ST_IDLE) {
			; SOURCE LINE # 632
	MOV  	A,us_st
	JZ   	?C0026
;         if (us_st == US_ST_WAIT) {
			; SOURCE LINE # 633
	MOV  	A,us_st
	CJNE 	A,#01H,?C0016
;             if (US_ECHO) {                  /* 上升沿到了：开始数宽度 */
			; SOURCE LINE # 634
	JNB  	US_ECHO,?C0017
;                 us_wid = 0;
			; SOURCE LINE # 635
	MOV  	us_wid,#00H
;                 us_st  = US_ST_HIGH;
			; SOURCE LINE # 636
	MOV  	us_st,#02H
;             } else if (us_wait < US_TOUT_TICKS) {
			; SOURCE LINE # 637
	SJMP 	?C0026
?C0017:
	MOV  	A,us_wait
	CLR  	C
	SUBB 	A,#0FAH
	JNC  	?C0398
;                 us_wait++;                  /* 还没来，接着等（主循环不受影响）*/
			; SOURCE LINE # 638
	INC  	us_wait
;             } else {                        /* 超时：模块没响应这次触发 */
			; SOURCE LINE # 639
	SJMP 	?C0026
?C0016:
;                 us_st  = US_ST_IDLE;
;                 us_res = US_FAR;
;                 us_got = 1;
; #if AV_SCOPE
;                 us_stage = 0;               /* 自测版 E：等不到上升沿 */
; #endif
;             }
;         } else {                            /* US_ST_HIGH：数回波宽度 */
;             if (US_ECHO) {
			; SOURCE LINE # 648
	JNB  	US_ECHO,?C0022
;                 if (us_wid < US_RANGE) {
			; SOURCE LINE # 649
	MOV  	A,us_wid
	CLR  	C
	SUBB 	A,#02DH
	JNC  	?C0023
;                     us_wid++;               /* 还没够远，接着数 */
			; SOURCE LINE # 650
	INC  	us_wid
;                 } else {                    /* 已经够远，不必再等下降沿 */
			; SOURCE LINE # 651
	SJMP 	?C0026
?C0023:
;                     us_st  = US_ST_IDLE;
			; SOURCE LINE # 652
?C0398:
	MOV  	us_st,#00H
;                     us_res = US_FAR;
			; SOURCE LINE # 653
	MOV  	us_res,#0FFH
;                     us_got = 1;
			; SOURCE LINE # 654
	SETB 	us_got
; #if AV_SCOPE
;                     us_stage = 1;           /* 自测版 H：回波超过量程上限（够远）*/
; #endif
;                 }
			; SOURCE LINE # 658
;             } else {                        /* 下降沿：宽度就是距离 */
			; SOURCE LINE # 659
	SJMP 	?C0026
?C0022:
;                 us_st  = US_ST_IDLE;
			; SOURCE LINE # 660
	MOV  	us_st,#00H
;                 us_res = us_wid;
			; SOURCE LINE # 661
	MOV  	us_res,us_wid
;                 us_got = 1;
			; SOURCE LINE # 662
	SETB 	us_got
; #if AV_SCOPE
;                 us_stage = 2;               /* 自测版：正常量到了 */
; #endif
;             }
			; SOURCE LINE # 666
;         }
			; SOURCE LINE # 667
;     }
			; SOURCE LINE # 668
; }
			; SOURCE LINE # 669
?C0026:
	POP  	PSW
	POP  	ACC
	RETI 	
; END OF timer0_isr

; 
; /*=========================================================================
;  * 十五、读系统时基（要原子）
;  *   16 位计数器分两个字节，读的时候如果被中断打断，可能读到一半新
;  *   一半旧的（比如低字节刚进位）。关中断只几个机器周期，不影响计时。
;  *=========================================================================*/
; static unsigned int tick_get(void)

	RSEG  ?PR?tick_get?MAIN
tick_get:
	USING	0
			; SOURCE LINE # 676
; {
			; SOURCE LINE # 677
;     unsigned int t;
;     ET0 = 0;
			; SOURCE LINE # 679
	CLR  	ET0
;     t = ((unsigned int)tick_h << 8) | tick_l;
			; SOURCE LINE # 680
	MOV  	R7,tick_h
	MOV  	A,R7
	MOV  	R6,A
	MOV  	R5,tick_l
	MOV  	A,R5
	MOV  	R7,A
;---- Variable 't?141' assigned to Register 'R6/R7' ----
;     ET0 = 1;
			; SOURCE LINE # 681
	SETB 	ET0
;     return t;
			; SOURCE LINE # 682
; }
			; SOURCE LINE # 683
?C0027:
	RET  	
; END OF tick_get

; 
; /* 读 10ms 时基（同样关中断保证原子）。 */
; static unsigned int ms10_get(void)

	RSEG  ?PR?ms10_get?MAIN
ms10_get:
	USING	0
			; SOURCE LINE # 686
; {
			; SOURCE LINE # 687
;     unsigned int t;
;     ET0 = 0;
			; SOURCE LINE # 689
	CLR  	ET0
;     t = ((unsigned int)ms10_h << 8) | ms10_l;
			; SOURCE LINE # 690
	MOV  	R7,ms10_h
	MOV  	A,R7
	MOV  	R6,A
	MOV  	R5,ms10_l
	MOV  	A,R5
	MOV  	R7,A
;---- Variable 't?242' assigned to Register 'R6/R7' ----
;     ET0 = 1;
			; SOURCE LINE # 691
	SETB 	ET0
;     return t;
			; SOURCE LINE # 692
; }
			; SOURCE LINE # 693
?C0028:
	RET  	
; END OF ms10_get

; 
; /*=========================================================================
;  * 十六、短延时
;  *   用系统时基来等，不用空循环：空循环的耗时随编译优化变，而这里要的
;  *   是实实在在的 20ms（按键去抖、提示音间隔）。
;  *   延时期间中断照常跑，电机不会停。
;  *=========================================================================*/
; static void d_20ms(void)

	RSEG  ?PR?d_20ms?MAIN
L?0434:
	USING	0
L?0435:
	MOV  	R7,#018H
	LCALL	_beep
d_20ms:
	USING	0
			; SOURCE LINE # 701
; {
			; SOURCE LINE # 702
;     unsigned int t0 = tick_get();
			; SOURCE LINE # 703
	LCALL	tick_get
;---- Variable 't0?343' assigned to Register 'R2/R3' ----
	MOV  	R3,AR7
	MOV  	R2,AR6
?C0029:
;     while ((unsigned int)(tick_get() - t0) < D20MS_TICKS)
			; SOURCE LINE # 704
	LCALL	tick_get
	CLR  	C
	MOV  	A,R7
	SUBB 	A,R3
	MOV  	R7,A
	MOV  	A,R6
	SUBB 	A,R2
	MOV  	R6,A
	CLR  	C
	MOV  	A,R7
	SUBB 	A,#0C8H
	MOV  	A,R6
	SUBB 	A,#00H
	JC   	?C0029
?C0030:
;         ;
; }
			; SOURCE LINE # 706
?C0031:
	RET  	
; END OF d_20ms

