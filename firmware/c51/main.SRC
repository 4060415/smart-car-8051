; /*=========================================================================
;  * 十四、Timer0 中断：100us 时基 + 软件 PWM + 蜂鸣器方波 + 10ms 节拍
;  *   using 1 换一组寄存器，这样进中断就不用存主循环的 R0~R7，省点时间。
;  *   正常一趟中断就两次加法一次比较，P0 每 5 个 tick 才重新组装一次。
;  *   一趟中断必须比 99.83us 短，不然就丢 tick，PWM 直接乱套。
;  *=========================================================================*/
CSEG	AT	0000BH
	LJMP	timer0_isr

; void timer0_isr(void) interrupt 1 using 1

	RSEG  ?PR?timer0_isr?MAIN
	USING	1
timer0_isr:
	PUSH 	ACC
	PUSH 	PSW
	USING	1
	MOV  	PSW,#08H
			; SOURCE LINE # 544
; {
;     unsigned char a;
; 
;     /* ---- ① 100us 系统时基：红外脉宽测量、各种超时都靠它，必须每次都加 ---- */
;     if (++tick_l == 0)
			; SOURCE LINE # 549
	INC  	tick_l
	MOV  	R7,tick_l
	MOV  	A,R7
	JNZ  	?C0001
;         tick_h++;
			; SOURCE LINE # 550
	INC  	tick_h
?C0001:
; 
;     /* ---- ② PWM：每 PWM_DIV 个 tick 走一步 ---- */
;     if (++pwm_div >= PWM_DIV) {
			; SOURCE LINE # 553
	INC  	pwm_div
	MOV  	A,pwm_div
	CLR  	C
	SUBB 	A,#05H
	JC   	?C0002
;         pwm_div = 0;
			; SOURCE LINE # 554
	MOV  	pwm_div,#00H
; 
;         if (++pwm_cnt >= PWM_STEPS)
			; SOURCE LINE # 556
	INC  	pwm_cnt
	MOV  	A,pwm_cnt
	SUBB 	A,#014H
	JC   	?C0003
;             pwm_cnt = 0;
			; SOURCE LINE # 557
	MOV  	pwm_cnt,#00H
?C0003:
; 
;         ena = (pwm_cnt < duty_a);
			; SOURCE LINE # 559
	MOV  	R7,duty_a
	MOV  	A,pwm_cnt
	CLR  	C
	SUBB 	A,R7
	JNC  	?C0004
	SJMP 	?C0005
?C0004:
	CLR  	C
?C0005:
	MOV  	ena,C
;         enb = (pwm_cnt < duty_b);
			; SOURCE LINE # 560
	MOV  	R7,duty_b
	MOV  	A,pwm_cnt
	CLR  	C
	SUBB 	A,R7
	JNC  	?C0006
	SJMP 	?C0007
?C0006:
	CLR  	C
?C0007:
	MOV  	enb,C
; 
;         /* ---- ③ 蜂鸣器方波：每个 PWM 步（500us）翻一次 = 1kHz ---- */
;         if (buz_left) {
			; SOURCE LINE # 563
	MOV  	A,buz_left
	JZ   	?C0008
;             buz_left--;
			; SOURCE LINE # 564
	DEC  	buz_left
;             buz_quiet = ~buz_quiet;
			; SOURCE LINE # 565
	CPL  	buz_quiet
;         } else {
			; SOURCE LINE # 566
	SJMP 	?C0009
?C0008:
;             buz_quiet = 1;                  /* 半周期用完 -> 静音 */
			; SOURCE LINE # 567
	SETB 	buz_quiet
;         }
			; SOURCE LINE # 568
?C0009:
; 
;         /* ---- ④ 组装 P0（主循环永不写 P0，只改上面这几个变量）---- */
;         a = 0x80;                           /* P0.7 恒 1（未使用，且 P0 是开漏口） */
			; SOURCE LINE # 571
;---- Variable 'a?040' assigned to Register 'R7' ----
	MOV  	R7,#080H
;         a |= dirbits;                       /* D0~D3 = IN1~IN4 方向 */
			; SOURCE LINE # 572
	MOV  	A,dirbits
	ORL  	AR7,A
;         if (ena) a |= 0x10;                 /* P0.4 = ENA */
			; SOURCE LINE # 573
	JNB  	ena,?C0010
	ORL  	AR7,#010H
?C0010:
;         if (enb) a |= 0x20;                 /* P0.5 = ENB */
			; SOURCE LINE # 574
	JNB  	enb,?C0011
	ORL  	AR7,#020H
?C0011:
;         if (buz_quiet) a |= 0x40;           /* P0.6 = 1 -> 静音 */
			; SOURCE LINE # 575
	JNB  	buz_quiet,?C0012
	ORL  	AR7,#040H
?C0012:
;         P0 = a;
			; SOURCE LINE # 576
	MOV  	P0,R7
;     }
			; SOURCE LINE # 577
?C0002:
; 
;     /* ---- ⑤ 10ms 节拍分频：每个 tick 都加 ----
;      * 放在写 P0 之后，对 PWM 时序没有影响。
;      * 必须放在中断里：主循环一趟最长会被收红外堵 25.6ms，用它数节拍会有
;      * 很大误差，录制回放的时长就不准了。 */
;     if (++ms_div >= MS10_DIV) {
			; SOURCE LINE # 583
	INC  	ms_div
	MOV  	A,ms_div
	CLR  	C
	SUBB 	A,#064H
	JC   	?C0013
;         ms_div = 0;
			; SOURCE LINE # 584
	MOV  	ms_div,#00H
;         if (++ms10_l == 0)
			; SOURCE LINE # 585
	INC  	ms10_l
	MOV  	R7,ms10_l
	MOV  	A,R7
	JNZ  	?C0013
;             ms10_h++;
			; SOURCE LINE # 586
	INC  	ms10_h
;     }
			; SOURCE LINE # 587
?C0013:
; 
;     /* ---- ⑥ 超声波回波采样（非阻塞状态机，也放在写 P0 之后）----
;      * 中断每 99.83us 准时跑一次，所以数出来的回波宽度和主循环快慢无关。
;      * 主循环只负责发触发和取结果，一次都不等。
;      * 开销很小：空闲时绝大多数 tick 只走一条判断就过去了。 */
;     if (us_st != US_ST_IDLE) {
			; SOURCE LINE # 593
	MOV  	A,us_st
	JZ   	?C0026
;         if (us_st == US_ST_WAIT) {
			; SOURCE LINE # 594
	MOV  	A,us_st
	CJNE 	A,#01H,?C0016
;             if (US_ECHO) {                  /* 上升沿到了：开始数宽度 */
			; SOURCE LINE # 595
	JNB  	US_ECHO,?C0017
;                 us_wid = 0;
			; SOURCE LINE # 596
	MOV  	us_wid,#00H
;                 us_st  = US_ST_HIGH;
			; SOURCE LINE # 597
	MOV  	us_st,#02H
;             } else if (us_wait < US_TOUT_TICKS) {
			; SOURCE LINE # 598
	SJMP 	?C0026
?C0017:
	MOV  	A,us_wait
	CLR  	C
	SUBB 	A,#0FAH
	JNC  	?C0389
;                 us_wait++;                  /* 还没来，接着等（主循环不受影响）*/
			; SOURCE LINE # 599
	INC  	us_wait
;             } else {                        /* 超时：模块没响应这次触发 */
			; SOURCE LINE # 600
	SJMP 	?C0026
?C0016:
;                 us_st  = US_ST_IDLE;
;                 us_res = US_FAR;
;                 us_got = 1;
; #if AV_SCOPE
;                 us_stage = 0;               /* 自测版 E：等不到上升沿 */
; #endif
;             }
;         } else {                            /* US_ST_HIGH：数回波宽度 */
;             if (US_ECHO) {
			; SOURCE LINE # 609
	JNB  	US_ECHO,?C0022
;                 if (us_wid < US_NEAR) {
			; SOURCE LINE # 610
	MOV  	A,us_wid
	CLR  	C
	SUBB 	A,#0CH
	JNC  	?C0023
;                     us_wid++;               /* 还没够远，接着数 */
			; SOURCE LINE # 611
	INC  	us_wid
;                 } else {                    /* 已经够远，不必再等下降沿 */
			; SOURCE LINE # 612
	SJMP 	?C0026
?C0023:
;                     us_st  = US_ST_IDLE;
			; SOURCE LINE # 613
?C0389:
	MOV  	us_st,#00H
;                     us_res = US_FAR;
			; SOURCE LINE # 614
	MOV  	us_res,#0FFH
;                     us_got = 1;
			; SOURCE LINE # 615
	SETB 	us_got
; #if AV_SCOPE
;                     us_stage = 1;           /* 自测版 H：回波够远 */
; #endif
;                 }
			; SOURCE LINE # 619
;             } else {                        /* 下降沿：宽度就是距离 */
			; SOURCE LINE # 620
	SJMP 	?C0026
?C0022:
;                 us_st  = US_ST_IDLE;
			; SOURCE LINE # 621
	MOV  	us_st,#00H
;                 us_res = us_wid;
			; SOURCE LINE # 622
	MOV  	us_res,us_wid
;                 us_got = 1;
			; SOURCE LINE # 623
	SETB 	us_got
; #if AV_SCOPE
;                 us_stage = 2;               /* 自测版：正常量到了 */
; #endif
;             }
			; SOURCE LINE # 627
;         }
			; SOURCE LINE # 628
;     }
			; SOURCE LINE # 629
; }
			; SOURCE LINE # 630
?C0026:
	POP  	PSW
	POP  	ACC
	RETI 	
; END OF timer0_isr

; 
; /*=========================================================================
;  * 十五、读系统时基（要原子）
;  *   16 位计数器分两个字节，读的时候如果被中断打断，可能读到一半新
;  *   一半旧的（比如低字节刚进位）。关中断只几个机器周期，不影响计时。
;  *=========================================================================*/
; static unsigned int tick_get(void)

	RSEG  ?PR?tick_get?MAIN
tick_get:
	USING	0
			; SOURCE LINE # 637
; {
			; SOURCE LINE # 638
;     unsigned int t;
;     ET0 = 0;
			; SOURCE LINE # 640
	CLR  	ET0
;     t = ((unsigned int)tick_h << 8) | tick_l;
			; SOURCE LINE # 641
	MOV  	R7,tick_h
	MOV  	A,R7
	MOV  	R6,A
	MOV  	R5,tick_l
	MOV  	A,R5
	MOV  	R7,A
;---- Variable 't?141' assigned to Register 'R6/R7' ----
;     ET0 = 1;
			; SOURCE LINE # 642
	SETB 	ET0
;     return t;
			; SOURCE LINE # 643
; }
			; SOURCE LINE # 644
?C0027:
	RET  	
; END OF tick_get

; 
; static unsigned int ms10_get(void)

	RSEG  ?PR?ms10_get?MAIN
ms10_get:
	USING	0
			; SOURCE LINE # 646
; {
			; SOURCE LINE # 647
;     unsigned int t;
;     ET0 = 0;
			; SOURCE LINE # 649
	CLR  	ET0
;     t = ((unsigned int)ms10_h << 8) | ms10_l;
			; SOURCE LINE # 650
	MOV  	R7,ms10_h
	MOV  	A,R7
	MOV  	R6,A
	MOV  	R5,ms10_l
	MOV  	A,R5
	MOV  	R7,A
;---- Variable 't?242' assigned to Register 'R6/R7' ----
;     ET0 = 1;
			; SOURCE LINE # 651
	SETB 	ET0
;     return t;
			; SOURCE LINE # 652
; }
			; SOURCE LINE # 653
?C0028:
	RET  	
; END OF ms10_get

; 
; /*=========================================================================
;  * 十六、短延时
;  *   用系统时基来等，不用空循环：空循环的耗时随编译优化变，而这里要的
;  *   是实实在在的 20ms（按键去抖、提示音间隔）。
;  *   延时期间中断照常跑，电机不会停。
;  *=========================================================================*/
; static void d_20ms(void)

	RSEG  ?PR?d_20ms?MAIN
L?0420:
	USING	0
L?0421:
	MOV  	R7,#018H
	LCALL	_beep
d_20ms:
	USING	0
			; SOURCE LINE # 661
; {
			; SOURCE LINE # 662
;     unsigned int t0 = tick_get();
			; SOURCE LINE # 663
	LCALL	tick_get
;---- Variable 't0?343' assigned to Register 'R2/R3' ----
	MOV  	R3,AR7
	MOV  	R2,AR6
?C0029:
;     while ((unsigned int)(tick_get() - t0) < D20MS_TICKS)
			; SOURCE LINE # 664
	LCALL	tick_get
	CLR  	C
	MOV  	A,R7
	SUBB 	A,R3
	MOV  	R7,A
	MOV  	A,R6
	SUBB 	A,R2
	MOV  	R6,A
	CLR  	C
	MOV  	A,R7
	SUBB 	A,#0C8H
	MOV  	A,R6
	SUBB 	A,#00H
	JC   	?C0029
?C0030:
;         ;
; }
			; SOURCE LINE # 666
?C0031:
	RET  	
; END OF d_20ms

; 
; /*=========================================================================
;  * 十七、蜂鸣器
;  *   入：half_cycles = 半周期个数（一个半周期 500us，听起来约 1kHz）。
;  *   这里只置计数，真正翻转由中断做，主循环不用等。
;  *   改计数和静音标志时短暂关一下中断，免得中断读到改了一半的状态。
;  *=========================================================================*/
; static void beep(unsigned char half_cycles)

	RSEG  ?PR?_beep?MAIN
_beep:
			; SOURCE LINE # 674
;---- Variable 'half_cycles?444' assigned to Register 'R7' ----
; {
