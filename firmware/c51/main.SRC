			; SOURCE LINE # 1301
;---- Variable 't10?2156' assigned to Register 'R6' ----
	MOV  	R6,ms10_l
; 
;     /* ---- 1) 中断刚量完，先把结果取走 ----
;      * 取结果和清标志一起做（中间关一下中断），免得出现取了值没清标志，
;      * 或者清了标志没取值的半截情况。 */
;     if (us_got) {
			; SOURCE LINE # 1306
	JNB  	us_got,?C0135
