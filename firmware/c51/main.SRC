;     if (half_cycles == 0) {                 /* 关掉鸣叫 */
			; SOURCE LINE # 676
	MOV  	A,R7
	JNZ  	?C0032
;         ET0 = 0;
			; SOURCE LINE # 677
	CLR  	ET0
;         buz_left = 0;
			; SOURCE LINE # 678
	MOV  	buz_left,A
;         buz_quiet = 1;
			; SOURCE LINE # 679
	SETB 	buz_quiet
;         ET0 = 1;
			; SOURCE LINE # 680
	SETB 	ET0
	RET  	
;         return;
;     }
			; SOURCE LINE # 682
?C0032:
;     ET0 = 0;
			; SOURCE LINE # 683
	CLR  	ET0
;     buz_left = half_cycles;
			; SOURCE LINE # 684
	MOV  	buz_left,R7
;     buz_quiet = 0;                          /* 低电平 -> PNP 导通 -> 开始发声 */
			; SOURCE LINE # 685
	CLR  	buz_quiet
;     ET0 = 1;
			; SOURCE LINE # 686
	SETB 	ET0
; }
			; SOURCE LINE # 687
?C0033:
	RET  	
; END OF _beep

