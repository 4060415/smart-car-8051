; /*=========================================================================
;  * 十九、驱动电机的统一出口 motor_set(动作, 档位)
;  *   入：act = 动作码，g = 档位 1..5（0 就是停）。
;  *   这里只改方向变量和占空比，真正输出交给定时器中断去干。
;  *   凡是要动电机的地方都走它，所以避障要改动作、还是要直接刹停，
;  *   只在这一个地方判断就行 —— 这也是有障碍时遥控照样能用
;  *   （响铃、换显示、记录制）的原因，只是车最后那一步真出不去。
;  *=========================================================================*/
; static void motor_set_core(unsigned char act, unsigned char g)

	RSEG  ?PR?_motor_set_core?MAIN
L?0422:
	USING	0
	MOV  	avst,#02H
L?0423:
	CLR  	A
L?0424:
	MOV  	cur_act,A
	MOV  	R5,A
	MOV  	R7,A
_motor_set_core:
	USING	0
			; SOURCE LINE # 808
;---- Variable 'g?546' assigned to Register 'R5' ----
;---- Variable 'act?545' assigned to Register 'R7' ----
; {
			; SOURCE LINE # 809
;     if (g == 0) {                           /* 速度 0 -> 停（本来就没让动，闸门不用管）*/
			; SOURCE LINE # 810
	MOV  	A,R5
	JNZ  	?C0034
;         dirbits = DIR_STOP;
			; SOURCE LINE # 811
;         duty_a = 0;
			; SOURCE LINE # 812
;         duty_b = 0;
			; SOURCE LINE # 813
	SJMP 	?C0391
;         return;
;     }
			; SOURCE LINE # 815
?C0034:
; 
;     /* ---- 避障闸门：按状态决定要不要改写动作 ---- */
; #if AV_L1
;     if (avst == AV_ARC) {
			; SOURCE LINE # 819
	MOV  	A,avst
	CJNE 	A,#04H,?C0036
;         act = ACT_ARC_R;                    /* 中区：弧线右绕，车继续走、不丢前进分量 */
			; SOURCE LINE # 820
	MOV  	R7,#06H
;     } else
			; SOURCE LINE # 821
	SJMP 	?C0037
?C0036:
; #endif
;     if (avst == AV_TURN) {
			; SOURCE LINE # 823
	MOV  	A,avst
	CJNE 	A,#01H,?C0038
;         act = ACT_RIGHT;                    /* 近区：一律改写成原地右转绕开 */
			; SOURCE LINE # 824
	MOV  	R7,#04H
;     } else if (avst == AV_HOLD) {           /* 太近：强制刹停（锁存，等遥控决定）*/
			; SOURCE LINE # 825
	SJMP 	?C0037
?C0038:
	MOV  	A,avst
	CJNE 	A,#02H,?C0037
;         cur_act = ACT_STOP;                 /* 真的停车了，当前动作也要清掉，
			; SOURCE LINE # 826
	CLR  	A
	MOV  	cur_act,A
;                                              * 否则寻光和循迹每趟都会把动作码设回来，
;                                              * 车虽然不动，指示灯却还亮着 */
;         dirbits = DIR_STOP;
			; SOURCE LINE # 829
?C0390:
;         duty_a = 0;
			; SOURCE LINE # 830
;         duty_b = 0;
			; SOURCE LINE # 831
	SJMP 	?C0391
;         return;
;     }
			; SOURCE LINE # 833
?C0037:
;     /* AV_FREE / AV_HUMAN -> 放行，按原动作走 */
; 
;     /* ---- 倒车限速（放在闸门之后，按最终动作判断）----
;      * 数码管显示的还是用户设的档位，这里只把实际出力封顶。 */
;     if (act == ACT_BACK && g > BACK_GEAR_MAX)
			; SOURCE LINE # 838
	CJNE 	R7,#02H,?C0041
	MOV  	A,R5
	SETB 	C
	SUBB 	A,#02H
	JC   	?C0041
;         g = BACK_GEAR_MAX;
			; SOURCE LINE # 839
	MOV  	R5,#02H
?C0041:
; 
;     duty_a = duty_tab[g - 1];               /* 1..5 -> 40/55/70/85/100% */
			; SOURCE LINE # 841
	MOV  	A,R5
	MOV  	DPTR,#duty_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_a,A
;     duty_b = duty_a;                        /* 默认两轮同速 */
			; SOURCE LINE # 842
	MOV  	duty_b,duty_a
; 
;     /* ---- 弧线转弯：两个轮子都正转，只把内轮的占空比调小 ----
;      * 左轮的占空比是 duty_a，右轮是 duty_b；
;      * 方向位用前进，而不是原地转的那两个方向。 */
;     if (act == ACT_ARC_L) {
			; SOURCE LINE # 847
	CJNE 	R7,#05H,?C0042
;         duty_a = arc_tab[g - 1];            /* 左弧线：内轮 = 左轮 */
			; SOURCE LINE # 848
	MOV  	A,R5
	MOV  	DPTR,#arc_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_a,A
;         dirbits = DIR_FWD;
			; SOURCE LINE # 849
	SJMP 	?C0393
;         return;
;     }
			; SOURCE LINE # 851
?C0042:
;     if (act == ACT_ARC_R) {
			; SOURCE LINE # 852
	CJNE 	R7,#06H,?C0043
;         duty_b = arc_tab[g - 1];            /* 右弧线：内轮 = 右轮 */
			; SOURCE LINE # 853
	MOV  	A,R5
	MOV  	DPTR,#arc_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_b,A
;         dirbits = DIR_FWD;
			; SOURCE LINE # 854
?C0392:
	SJMP 	?C0393
;         return;
;     }
			; SOURCE LINE # 856
?C0043:
; 
;     switch (act) {
			; SOURCE LINE # 858
	MOV  	A,R7
	ADD  	A,#0FEH
	JZ   	?C0046
	DEC  	A
	JZ   	?C0047
	DEC  	A
	JZ   	?C0048
	ADD  	A,#03H
	JNZ  	?C0049
;     case ACT_FORWARD: dirbits = DIR_FWD;   break;
			; SOURCE LINE # 859
?C0045:
?C0393:
	MOV  	dirbits,#05H
	RET  	
;     case ACT_BACK:    dirbits = DIR_BACK;  break;
			; SOURCE LINE # 860
?C0046:
	MOV  	dirbits,#0AH
	RET  	
;     case ACT_LEFT:    dirbits = DIR_LEFT;  break;
			; SOURCE LINE # 861
?C0047:
	MOV  	dirbits,#06H
	RET  	
;     case ACT_RIGHT:   dirbits = DIR_RIGHT; break;
			; SOURCE LINE # 862
?C0048:
	MOV  	dirbits,#09H
	RET  	
;     default:                                /* ACT_STOP 及任何意外值都当停车 */
			; SOURCE LINE # 863
?C0049:
;         dirbits = DIR_STOP;
			; SOURCE LINE # 864
	CLR  	A
?C0391:
	MOV  	dirbits,A
;         duty_a = 0;
			; SOURCE LINE # 865
	MOV  	duty_a,A
;         duty_b = 0;
			; SOURCE LINE # 866
	MOV  	duty_b,A
;         break;
			; SOURCE LINE # 867
;     }
			; SOURCE LINE # 868
; }
			; SOURCE LINE # 869
?C0035:
	RET  	
; END OF _motor_set_core

; 
; /*-------------------------------------------------------------------------
;  * 诊断包装（只在 DEBUG_UART=1 编入）
;  *   把每次真正下发给电机的指令打出来。下面四个值就是定时器中断组装 P0
;  *   所用的全部输入，再带上 cur_act 看"当前动作码"有没有被改写过：
;  *     act = 当前动作码   dir = 方向位 IN1..IN4（P0 低 4 位）
;  *     A   = 左轮 ENA 占空比                B = 右轮 ENB 占空比
;  *   判读：A 和 B 相等 = 两轮同速；只有一个非 0、或其中一个明显偏小
;  *   （唯一能产生这种情况的正常路径是弧线 arc_tab）就是"单轮"。
;  *   只在"值有变化"时才打：避障决策保持期间每趟主循环都会调 motor_set，
;  *   不做变化过滤会直接刷屏，而打印本身是阻塞的，会反过来拖慢主循环。
;  *   普通版这一整块不存在，退化成下面那个宏。
;  *-------------------------------------------------------------------------*/
; #if DEBUG_UART
; static unsigned char ms_p_act, ms_p_dir, ms_p_a, ms_p_b;
; static bit           ms_p_seen;
; 
; static void ms_dbg(void)
; {
;     if (ms_p_seen && ms_p_act == cur_act && ms_p_dir == dirbits &&
;         ms_p_a == duty_a && ms_p_b == duty_b)
;         return;
;     ms_p_seen = 1;
;     ms_p_act  = cur_act;
;     ms_p_dir  = dirbits;
;     ms_p_a    = duty_a;
;     ms_p_b    = duty_b;
;     prt_str("\r\n! MS act="); prt_hex(cur_act);
;     prt_str(" dir=");         prt_hex(dirbits);
;     prt_str(" A=");           prt_hex(duty_a);
;     prt_str(" B=");           prt_hex(duty_b);
; }
; 
; static void motor_set(unsigned char act, unsigned char g)
; {
;     motor_set_core(act, g);
;     ms_dbg();
; }
; #else
; #define motor_set(act, g)       motor_set_core((act), (g))
; #endif
; 
; /* d3_mix —— D3 指示灯的唯一下游
;  * D3 现在表示避障开关的状态：亮 = 开着，灭 = 关着。
;  * 所有写 P2 的地方都要经过这里，不然总有某一处会把 D3 写错。
;  * P2.0 是 D3，写 0 才亮；P2 和数码管段码共用，只能整字节写。 */
; static unsigned char d3_mix(unsigned char seg)

	RSEG  ?PR?_d3_mix?MAIN
_d3_mix:
	USING	0
			; SOURCE LINE # 916
	MOV  	seg?647,R7
; {
			; SOURCE LINE # 917
;     if (avoid_off() == 0)                   /* 录制中避障不参与，D3 也跟着灭 */
			; SOURCE LINE # 918
	LCALL	avoid_off
	MOV  	A,seg?647
	JC   	?C0050
;         return (unsigned char)(seg & 0xFE);     /* D3 位清 0 = 亮 */
			; SOURCE LINE # 919
	ANL  	A,#0FEH
	MOV  	R7,A
	RET  	
?C0050:
;     return (unsigned char)(seg | 0x01);         /* D3 位写 1 = 灭 */
			; SOURCE LINE # 920
	ORL  	A,#01H
	MOV  	R7,A
; }
			; SOURCE LINE # 921
?C0051:
	RET  	
; END OF _d3_mix

; 
; /* avoid_off —— 判断超声波避障现在是否不参与。
;  * 规则只有一条：正在录制，或者用户把开关关了。
;  * 录制时为什么要关掉它：录制是人在教车走，如果超声波在近处把动作
;  * 改成原地右转，或者太近时直接刹停，录下来的就不是人想教的东西了，
;  * 甚至会把一条停止当成人的操作记进去。 */
; static bit avoid_off(void)

	RSEG  ?PR?avoid_off?MAIN
avoid_off:
			; SOURCE LINE # 928
; {
			; SOURCE LINE # 929
;     if (recon)
			; SOURCE LINE # 930
	JNB  	recon,?C0052
;         return 1;                           /* 录制中 -> 超声波这一路不参与 */
			; SOURCE LINE # 931
	SETB 	C
	RET  	
?C0052:
;     if (us_avoid_on)
			; SOURCE LINE # 932
	JNB  	us_avoid_on,?C0054
;         return 0;
			; SOURCE LINE # 933
	CLR  	C
	RET  	
?C0054:
;     return 1;                               /* 用户把开关关了 */
			; SOURCE LINE # 934
	SETB 	C
; }
			; SOURCE LINE # 935
?C0053:
	RET  	
; END OF avoid_off

; 
; /*=========================================================================
;  * 二十、apply_gear —— 把当前档位套到电机和数码管上
;  *   档位 0   停车，数码管显示 0
;  *   档位 1~5 前进，占空比 40/55/70/85/100%，数码管显示档位
;  *   （手动模式下档位不是 0 就前进，这是最早定下来的用法）
;  *=========================================================================*/
; static void apply_gear_core(void)

	RSEG  ?PR?apply_gear_core?MAIN
apply_gear_core:
	USING	0
			; SOURCE LINE # 943
; {
			; SOURCE LINE # 944
;     if (gear == 0)
			; SOURCE LINE # 945
	MOV  	A,gear
	JZ   	?apply_gear_core?stop
;         goto stop;
			; SOURCE LINE # 946
?C0055:
; 
;     /* 刹停锁存期间，本地加档也不许把车开起来 —— 锁存的意思是"决定权在遥控手里" */
;     if (avst == AV_HOLD)
			; SOURCE LINE # 949
	MOV  	A,avst
	XRL  	A,#02H
	JZ   	?apply_gear_core?stop
;         goto stop;
			; SOURCE LINE # 950
?C0057:
; 
;     /* 这里必须同时把 cur_act 也设上：避障用 cur_act 判断车本来在不在动，
;      * 如果车在走而 cur_act 是 0，避障会以为车停着，就不躲了。 */
;     cur_act = ACT_FORWARD;
			; SOURCE LINE # 954
	MOV  	cur_act,#01H
; 
;     duty_a = duty_tab[gear - 1];
			; SOURCE LINE # 956
	MOV  	A,gear
	MOV  	DPTR,#duty_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_a,A
;     duty_b = duty_a;
			; SOURCE LINE # 957
	MOV  	duty_b,duty_a
;     dirbits = DIR_FWD;
			; SOURCE LINE # 958
	MOV  	dirbits,#05H
; 
;     P2 = d3_mix(gear_tab[gear]);
			; SOURCE LINE # 960
	SJMP 	?C0394
;     return;
; 
; stop:
			; SOURCE LINE # 963
?apply_gear_core?stop:
;     cur_act = ACT_STOP;                     /* 真停车了就要清掉，否则 D3 会误亮 */
			; SOURCE LINE # 964
	CLR  	A
	MOV  	cur_act,A
;     duty_a = 0;
			; SOURCE LINE # 965
	MOV  	duty_a,A
;     duty_b = 0;
			; SOURCE LINE # 966
	MOV  	duty_b,A
;     dirbits = DIR_STOP;
			; SOURCE LINE # 967
	MOV  	dirbits,A
;     P2 = d3_mix(gear_tab[gear]);
			; SOURCE LINE # 968
?C0394:
	MOV  	A,gear
	MOV  	DPTR,#gear_tab
	MOVC 	A,@A+DPTR
	MOV  	R7,A
	LCALL	_d3_mix
	MOV  	P2,R7
; }
			; SOURCE LINE # 969
?C0058:
	RET  	
; END OF apply_gear_core

