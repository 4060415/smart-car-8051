			; SOURCE LINE # 1284
	MOV  	A,ir_inv
	JZ   	?C0140
;         if (IR_AVOID) return 1;
			; SOURCE LINE # 1285
	JNB  	IR_AVOID,?C0141
	SETB 	C
	RET  	
?C0141:
;         return 0;
			; SOURCE LINE # 1286
	CLR  	C
	RET  	
;     }
			; SOURCE LINE # 1287
?C0140:
;     if (IR_AVOID) return 0;                 /* 0 = 低电平表示检测到 */
			; SOURCE LINE # 1288
	JNB  	IR_AVOID,?C0143
	CLR  	C
	RET  	
?C0143:
;     return 1;
			; SOURCE LINE # 1289
	SETB 	C
; }
			; SOURCE LINE # 1290
?C0142:
	RET  	
; END OF ir_det

; 
; /*=========================================================================
;  * 三十、避障
;  *   避障分两路，各管各的：
;  *
;  *   ① 车头红外对管（量程就 1~2cm）—— 三种模式都生效
;  *        一贴到东西就直接刹车。它量程小，能检测到说明已经怼上去了，
;  *        这时候该停不该绕；而且循迹时往右绕会直接把车带出黑线。
;  *        它没有开关、关不掉，就是最后一道保命的。
;  *
;  *   ② 超声波（约 5~21cm）—— 有开关，只在手动和寻光模式干活
;  *        离得远（≥21cm）：放行；
;  *        离得较近（12~21cm）：弧线右绕 —— 车不停、保留前进分量；
;  *        已经近了（5~12cm）：原地右转绕开；
;  *        离得太近（<5cm）：直接停下锁死，等遥控来接管（障碍自己挪开也不会自己走）。
;  *        这几档的决定做出以后会保持约 280ms 再重判，不拿同一份旧读数
;  *        每趟主循环改一次动作（见主循环里 av_gate 的"决策保持"一段）。
;  *
;  *   循迹模式不让超声波参与：它本来就贴着线跑，被推开就跑偏了。
;  *   红外没这毛病，它只刹车不改动作，所以循迹也留着它。
;  *
;  *   "锁存"啥意思：只有你按遥控键才能解除。障碍自己移开只是不响了，
;  *   车照样停在那等人操作。
;  *   有障碍时遥控和按键照样响应（响铃、换显示、录录制），不能全拦住；
;  *   只有车本来就在动的时候才主动躲，省得停着自己突然窜出去拐弯。
;  *=========================================================================*/
; 
; /*-------------------------------------------------------------------------
;  * ir_brake —— 车头红外触发时的处理：直接刹车，不转向也不改模式。
;  *   三种模式共用这一条路。
;  *   这里用停车锁存而不是改写动作，是因为改写会把任何动作都变成原地
;  *   右转，循迹模式下会把车推离黑线。
;  *   只在刚触发时调用一次，之后的间歇提醒由避障判断那一段管。
;  *-------------------------------------------------------------------------*/
; static void ir_brake(void)

	RSEG  ?PR?ir_brake?MAIN
ir_brake:
	USING	0
			; SOURCE LINE # 1325
; {
			; SOURCE LINE # 1326
;     if (avst == AV_HUMAN)
			; SOURCE LINE # 1327
	MOV  	A,avst
	XRL  	A,#03H
	JZ   	?C0145
?C0144:
;         return;                             /* 遥控已接管 -> 放行，别再压住*/
; 
;     avst = AV_HOLD;                         /* 锁存：决定权交回遥控 */
			; SOURCE LINE # 1330
;     cur_act = ACT_STOP;
			; SOURCE LINE # 1331
;     motor_set(ACT_STOP, 0);
			; SOURCE LINE # 1332
	LCALL	L?0422
;     show_mode();                            /* 这里用 show_mode，循迹时能保住显示的模式代号 */
			; SOURCE LINE # 1333
	LCALL	show_mode
;     av_beep_t = tick_get();                 /* 之后由 av_gate 按间隔继续响（若允许）*/
			; SOURCE LINE # 1334
	LCALL	tick_get
	MOV  	av_beep_t,R6
	MOV  	av_beep_t+01H,R7
;     av_beep_n = 0;                          /* 本次锁存的已响次数从 0 起算 */
			; SOURCE LINE # 1335
	CLR  	A
	MOV  	av_beep_n,A
; #if !IR_BEEP_SILENT
;     av_beep_n = 1;                          /* 入口这一声也算一次 */
;     beep(BEEP_KEY);                         /* 静音时不出这一声 */
; #endif
; }
			; SOURCE LINE # 1340
?C0145:
	RET  	
; END OF ir_brake

