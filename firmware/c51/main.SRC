			; SOURCE LINE # 1416
	SJMP 	?C0406
;         return;
;     }
			; SOURCE LINE # 1418
?C0153:
; 
;     /* ---- 手动：刹停 + 锁存 ---- */
;     avst = AV_HOLD;
			; SOURCE LINE # 1421
;     cur_act = ACT_STOP;
			; SOURCE LINE # 1422
;     motor_set(ACT_STOP, 0);
			; SOURCE LINE # 1423
;     show_mode();
			; SOURCE LINE # 1424
	LCALL	L?0436
; 
;     av_beep_t = tick_get();                 /* 之后由 av_gate 按间隔继续响 */
			; SOURCE LINE # 1426
	LCALL	tick_get
	MOV  	av_beep_t,R6
	MOV  	av_beep_t+01H,R7
;     /* 声音只在“新一次遇到障碍”的时候响。读数抖动会让锁存反复解除又重立，
;      * 每次都响的话听起来就是隔一会儿又响一声。
;      * 计数只在障碍真的退远以后才清零。 */
;     if (av_beep_n == 0) {
			; SOURCE LINE # 1430
	MOV  	A,av_beep_n
	JNZ  	?C0152
;         av_beep_n = 1;                      /* 这声算第 1 声 */
			; SOURCE LINE # 1431
	MOV  	av_beep_n,#01H
;         beepwhy('H');                       /* 诊断：刹停入口那一声 */
;         beep(BEEP_KEY);                     /* 响一声：手动 = 刹停锁存 */
			; SOURCE LINE # 1433
?C0406:
	MOV  	R7,#018H
	LCALL	_beep
;     }
			; SOURCE LINE # 1434
; }
			; SOURCE LINE # 1435
?C0152:
	RET  	
; END OF av_gate_hold

