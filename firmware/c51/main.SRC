	MOV  	ml_cap,A
;     ir_ledlo = 0;
			; SOURCE LINE # 1828
	MOV  	ir_ledlo,A
;     ir_ledhi = 0;
			; SOURCE LINE # 1829
	MOV  	ir_ledhi,A
;     ir_short = 0;
			; SOURCE LINE # 1830
	CLR  	ir_short
;     irstat = 1;                             /* 先当"连下降沿都没等到" */
			; SOURCE LINE # 1831
	MOV  	irstat,#01H
; }
			; SOURCE LINE # 1832
	RET  	
; END OF ir_reset

