;     /* ---- 弧线转弯：两个轮子都正转，只把内轮的占空比调小 ----
;      * 左轮的占空比是 duty_a，右轮是 duty_b；
;      * 方向位用前进，而不是原地转的那两个方向。 */
;     if (act == ACT_ARC_L) {
