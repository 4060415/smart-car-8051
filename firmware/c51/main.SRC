; 
; /*-------------------------------------------------------------------------
;  * 诊断包装（只在 DEBUG_UART=1 编入）
;  *   把每次真正下发给电机的指令打出来。下面四个值就是定时器中断组装 P0
;  *   所用的全部输入，再带上 cur_act 看"当前动作码"有没有被改写过：
;  *     act = 当前动作码   dir = 方向位 IN1..IN4（P0 低 4 位）
;  *     A   = 左轮 ENA 占空比                B = 右轮 ENB 占空比
;  *   判读：A 和 B 相等 = 两轮同速；只有一个非 0、或其中一个明显偏小
;  *   （唯一能产生这种情况的正常路径是弧线 arc_tab）就是"单轮"。
;  *   只在"值有变化"时才打：避障决策保持期间每趟主循环都会调 motor_set，
;  *   不做变化过滤会直接刷屏，而打印本身是阻塞的，会反过来拖慢主循环。
;  *   普通版这一整块不存在，退化成下面那个宏。
;  *-------------------------------------------------------------------------*/
; #if DEBUG_UART
; static unsigned char ms_p_act, ms_p_dir, ms_p_a, ms_p_b;
; static bit           ms_p_seen;
; 
; static void ms_dbg(void)
; {
;     if (ms_p_seen && ms_p_act == cur_act && ms_p_dir == dirbits &&
;         ms_p_a == duty_a && ms_p_b == duty_b)
;         return;
;     ms_p_seen = 1;
;     ms_p_act  = cur_act;
;     ms_p_dir  = dirbits;
;     ms_p_a    = duty_a;
;     ms_p_b    = duty_b;
;     prt_str("\r\n! MS act="); prt_hex(cur_act);
;     prt_str(" dir=");         prt_hex(dirbits);
;     prt_str(" A=");           prt_hex(duty_a);
;     prt_str(" B=");           prt_hex(duty_b);
; }
; 
; static void motor_set(unsigned char act, unsigned char g)
; {
;     motor_set_core(act, g);
;     ms_dbg();
; }
; #else
; #define motor_set(act, g)       motor_set_core((act), (g))
; #endif
; 
; /* d3_mix —— D3 指示灯的唯一下游
;  * D3 现在表示避障开关的状态：亮 = 开着，灭 = 关着。
;  * 所有写 P2 的地方都要经过这里，不然总有某一处会把 D3 写错。
;  * P2.0 是 D3，写 0 才亮；P2 和数码管段码共用，只能整字节写。 */
; static unsigned char d3_mix(unsigned char seg)

	RSEG  ?PR?_d3_mix?MAIN
_d3_mix:
	USING	0
			; SOURCE LINE # 966
	MOV  	seg?647,R7
; {
			; SOURCE LINE # 967
;     if (avoid_off() == 0)                   /* 录制中避障不参与，D3 也跟着灭 */
			; SOURCE LINE # 968
	LCALL	avoid_off
	MOV  	A,seg?647
	JC   	?C0054
;         return (unsigned char)(seg & 0xFE);     /* D3 位清 0 = 亮 */
			; SOURCE LINE # 969
	ANL  	A,#0FEH
	MOV  	R7,A
	RET  	
?C0054:
;     return (unsigned char)(seg | 0x01);         /* D3 位写 1 = 灭 */
			; SOURCE LINE # 970
	ORL  	A,#01H
	MOV  	R7,A
; }
			; SOURCE LINE # 971
?C0055:
	RET  	
; END OF _d3_mix

; 
; /* avoid_off —— 判断超声波避障现在是否不参与。
;  * 规则只有一条：正在录制，或者用户把开关关了。
;  * 录制时为什么要关掉它：录制是人在教车走，如果超声波在近处把动作
;  * 改成原地右转，或者太近时直接刹停，录下来的就不是人想教的东西了，
;  * 甚至会把一条停止当成人的操作记进去。 */
; static bit avoid_off(void)

	RSEG  ?PR?avoid_off?MAIN
avoid_off:
			; SOURCE LINE # 978
; {
			; SOURCE LINE # 979
;     if (recon)
			; SOURCE LINE # 980
	JNB  	recon,?C0056
;         return 1;                           /* 录制中 -> 超声波这一路不参与 */
			; SOURCE LINE # 981
	SETB 	C
	RET  	
?C0056:
;     if (us_avoid_on)
			; SOURCE LINE # 982
	JNB  	us_avoid_on,?C0058
;         return 0;
			; SOURCE LINE # 983
	CLR  	C
	RET  	
?C0058:
;     return 1;                               /* 用户把开关关了 */
			; SOURCE LINE # 984
	SETB 	C
; }
			; SOURCE LINE # 985
?C0057:
	RET  	
; END OF avoid_off

; 
; /*=========================================================================
;  * 二十、apply_gear —— 把当前档位套到电机和数码管上
;  *   档位 0   停车，数码管显示 0
;  *   档位 1~5 前进，占空比 40/55/70/85/100%，数码管显示档位
;  *   （手动模式下档位不是 0 就前进，这是最早定下来的用法）
;  *=========================================================================*/
; static void apply_gear_core(void)

	RSEG  ?PR?apply_gear_core?MAIN
apply_gear_core:
	USING	0
			; SOURCE LINE # 993
; {
			; SOURCE LINE # 994
;     /* 机动期间由闸门说了算：本函数直接写 dirbits/duty，若此时按板上
;      * S3/S4 加减档，会把正在倒车/转弯的车改成前进，所以直接返回。 */
;     if (av_mnv)
			; SOURCE LINE # 997
	JB   	av_mnv,?C0060
?C0059:
;         return;
; 
;     if (gear == 0)
			; SOURCE LINE # 1000
	MOV  	A,gear
	JZ   	?apply_gear_core?stop
;         goto stop;
			; SOURCE LINE # 1001
?C0061:
; 
;     /* 刹停锁存期间，本地加档也不许把车开起来 —— 锁存的意思是"决定权在遥控手里" */
;     if (avst == AV_HOLD)
			; SOURCE LINE # 1004
	MOV  	A,avst
	XRL  	A,#02H
	JZ   	?apply_gear_core?stop
;         goto stop;
			; SOURCE LINE # 1005
?C0063:
; 
;     /* 这里必须同时把 cur_act 也设上：避障用 cur_act 判断车本来在不在动，
;      * 如果车在走而 cur_act 是 0，避障会以为车停着，就不躲了。 */
;     cur_act = ACT_FORWARD;
			; SOURCE LINE # 1009
	MOV  	cur_act,#01H
; 
;     duty_a = duty_tab[gear - 1];
			; SOURCE LINE # 1011
	MOV  	A,gear
	MOV  	DPTR,#duty_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_a,A
;     duty_b = duty_a;
			; SOURCE LINE # 1012
	MOV  	duty_b,duty_a
;     dirbits = DIR_FWD;
			; SOURCE LINE # 1013
	MOV  	dirbits,#05H
; 
;     P2 = d3_mix(gear_tab[gear]);
			; SOURCE LINE # 1015
	SJMP 	?C0403
;     return;
; 
; stop:
			; SOURCE LINE # 1018
?apply_gear_core?stop:
;     cur_act = ACT_STOP;                     /* 真停车了就要清掉，否则 D3 会误亮 */
			; SOURCE LINE # 1019
	CLR  	A
	MOV  	cur_act,A
;     duty_a = 0;
			; SOURCE LINE # 1020
	MOV  	duty_a,A
;     duty_b = 0;
			; SOURCE LINE # 1021
	MOV  	duty_b,A
;     dirbits = DIR_STOP;
			; SOURCE LINE # 1022
	MOV  	dirbits,A
;     P2 = d3_mix(gear_tab[gear]);
			; SOURCE LINE # 1023
?C0403:
	MOV  	A,gear
	MOV  	DPTR,#gear_tab
	MOVC 	A,@A+DPTR
	MOV  	R7,A
	LCALL	_d3_mix
	MOV  	P2,R7
; }
			; SOURCE LINE # 1024
?C0060:
	RET  	
; END OF apply_gear_core

