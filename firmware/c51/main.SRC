			; SOURCE LINE # 870
	SJMP 	?C0037
?C0038:
	MOV  	A,avst
	CJNE 	A,#02H,?C0040
;         cur_act = ACT_STOP;                 /* 真的停车了，当前动作也要清掉，
			; SOURCE LINE # 871
	CLR  	A
	MOV  	cur_act,A
;                                              * 否则寻光和循迹每趟都会把动作码设回来，
;                                              * 车虽然不动，指示灯却还亮着 */
;         dirbits = DIR_STOP;
			; SOURCE LINE # 874
?C0399:
;         duty_a = 0;
			; SOURCE LINE # 875
;         duty_b = 0;
			; SOURCE LINE # 876
	SJMP 	?C0400
;         return;
;     } else if (avst == AV_BACK) {           /* 避障机动①：自动倒车
			; SOURCE LINE # 878
?C0040:
	MOV  	A,avst
	CJNE 	A,#05H,?C0042
;                                              * （倒车限速在下面统一封顶）*/
;         act = ACT_BACK;
			; SOURCE LINE # 880
	MOV  	R7,#02H
;     } else if (avst == AV_ATURN) {          /* 避障机动②：原地右转让开 */
			; SOURCE LINE # 881
	SJMP 	?C0037
?C0042:
	MOV  	A,avst
	CJNE 	A,#06H,?C0037
;         act = ACT_RIGHT;
			; SOURCE LINE # 882
	MOV  	R7,#04H
;     }
			; SOURCE LINE # 883
?C0037:
;     /* AV_FREE / AV_HUMAN -> 放行，按原动作走 */
; 
;     /* ---- 倒车限速（放在闸门之后，按最终动作判断）----
;      * 数码管显示的还是用户设的档位，这里只把实际出力封顶。 */
;     if (act == ACT_BACK && g > BACK_GEAR_MAX)
			; SOURCE LINE # 888
	CJNE 	R7,#02H,?C0045
	MOV  	A,R5
	SETB 	C
	SUBB 	A,#02H
	JC   	?C0045
;         g = BACK_GEAR_MAX;
			; SOURCE LINE # 889
	MOV  	R5,#02H
?C0045:
; 
;     duty_a = duty_tab[g - 1];               /* 1..5 -> 40/55/70/85/100% */
			; SOURCE LINE # 891
	MOV  	A,R5
	MOV  	DPTR,#duty_tab-01H
	MOVC 	A,@A+DPTR
	MOV  	duty_a,A
