/*=========================================================================
 * main.c  --  智能移动机器人 正式固件（C 版，课程设计交作业这份）
 *-------------------------------------------------------------------------
 * 姓名   : 李家乐
 * 学号   : 03231312
 * 芯片   : STC89C52RC，晶振 11.0592 MHz（就是这块最小系统板）
 * 编译   : Keil C51，构建脚本 firmware\c51\build_c_abs.ps1
 * 产物   : main.hex（正常版）、main_dbg.hex（带串口打印的调试版）
 *-------------------------------------------------------------------------
 * 这个小车都能干点啥（基本都是一行一行硬调出来的）
 *   1. 电机控制：软件 PWM 分 5 档调速，数码管显示档位，动一下蜂鸣器
 *   2. 红外遥控：NEC 协议自己硬解的，方向、加减速全靠它
 *   3. 模式切换：手动 / 寻光 / 循迹 三种，随时切
 *   4. 避障：超声波管远一点的距离，车头那个红外对管负责最后 1~2cm
 *   5. 录制回放：遥控数字键 7 开始/结束录，8 回放，9 清空
 *
 * 遥控按键（键值都是我一个一个按出来量的，别瞎改）
 *   46 前进   15 后退   44 左转   43 右转   40 停止
 *   5A 加档   08 减档
 *   0C 手动   18 寻光   5E 循迹
 *   1C 超声波避障开关
 *   42 录制   52 回放   4A 清空
 *
 * 板上按键
 *   S3 短按加档，长按约 1 秒切换模式
 *   S4 短按减档，长按约 1 秒开关超声波避障
 *-------------------------------------------------------------------------
 * 引脚（都实测核对过，现场以 firmware\car\config.h 为准）
 *   P0.0~P0.3 = 电机方向        P0.4 / P0.5 = 左右电机使能
 *   P0.6 = 蜂鸣器（低电平响）   P0.7 = 没用到，写 1
 *   P2.7~P2.1 = 数码管 a~g      P2.0 = D3 指示灯
 *   P3.2 = 按键 S4              P3.4 = 按键 S3
 *   P3.3 = 红外接收头输出       P3.7 = 车头红外对管
 *   P3.5 / P3.6 = 循迹左右探头  P1.0 / P1.1 = 右 / 左光敏
 *   P1.2 / P1.3 = 超声波 Echo / Trig   P3.1 = 串口发送（调试用）
 *-------------------------------------------------------------------------
 * 写这个程序时踩过几个坑，记在这里免得再犯
 *   1) 主循环不要直接写 P0。P0 只在定时器中断里组装：低 4 位是方向，
 *      P0.4 / P0.5 是两路使能，P0.6 是蜂鸣器，P0.7 固定写 1。
 *   2) 驱动电机都走 motor_set() 这一个出口，避障要改写动作还是刹停
 *      也都在这一个地方判断，别处不要再改方向变量。
 *   3) 中断和主循环都会用到的变量要加 volatile，不然会被优化进寄存器。
 *   4) 判断时间一律用系统时基（tick / ms10），不要用空循环凑时间，
 *      因为空循环的耗时随编译优化变，改个选项就不准了。
 *   5) 动作记录的 240 字节放在片内扩展 RAM，只能用 XBYTE[] 访问，
 *      不能用 pdata 指针（它会拿 P2 当高位地址，把数码管显示弄花）。
 *   6) 中断里的活要尽量少：C 的函数进出开销比汇编大，一次中断最好
 *      只做几次加法和比较。
 *=========================================================================*/

#include <reg52.h>
#include <absacc.h>             /* XBYTE[]：片内扩展 RAM 访问（生成 MOVX @DPTR） */
#include <intrins.h>            /* _nop_()：超声波触发脉冲要精确的 ~13µs */

/*=========================================================================
 * 一、编译开关
 *   这两个开关默认都是关的。串口打印巨占时间（9600 波特率下打一行
 *   40 个字符就要 42ms，可一帧遥控信号才 67ms），一边打印一边收遥控
 *   准漏帧，所以交作业用就别开，自己调程序时再打开。
 *   用 #ifndef 包起来是为了能在编译命令行里临时打开，不用翻源码改。
 *=========================================================================*/
#ifndef DEBUG_UART
#define DEBUG_UART  0           /* 1 = 编入串口打印（开发期用） */
#endif
#ifndef DIAG_IR
#define DIAG_IR     0           /* 1 = 编入数码管键值显示（排查"遥控没反应"用） */
#endif
/* 超声波自测版：只反复运行本文件里的 us_read()，把结果直接显示在数码管
 * 上，用来分清到底是测距本身不行，还是避障逻辑没用上。 */
#ifndef AV_SCOPE
#define AV_SCOPE    0
#endif

/* 松键停车：1 = 除了前进以外，松手约 0.3s 自动停；
 * 0 = 全部改成按一下就一直动。
 * 如果按住遥控键时小车一颠一颠的，说明这只遥控器不发重复帧，
 * 把这里改成 0 重新编译即可。 */
#define HOLD_MODE   1

/*=========================================================================
 * 二、引脚
 *=========================================================================*/
sbit KEY_S3  = P3^4;            /* 低 = 按下（短按加档 / 长按切模式） */
sbit KEY_S4  = P3^2;            /* 低 = 按下（短按减档 / 长按避障开关） */
sbit IR_IN   = P3^3;            /* 红外接收头输出：空闲是高，收到载波时变低 */

sbit LDR_LEFT  = P1^1;          /* 左光敏：见光 = 低 */
sbit LDR_RIGHT = P1^0;          /* 右光敏：见光 = 低 */

sbit TRACK_L = P3^5;            /* 循迹左探头：压黑线 = 高 */
sbit TRACK_R = P3^6;            /* 循迹右探头：压黑线 = 高 */

sbit US_TRIG = P1^3;            /* 超声波触发（输出，高脉冲 >= 10us） */
sbit US_ECHO = P1^2;            /* 超声波回波（输入，高电平宽度正比于距离） */

sbit IR_AVOID = P3^7;           /* 车头红外对管：量程只有 1~2cm（最后一道兜底） */

/*=========================================================================
 * 三、时间参数
 *   1 个 tick = 99.83us（Timer0 方式 2，重装值 164：256-164 = 92 机器周期）
 *=========================================================================*/
#define T0_RELOAD    164        /* Timer0 重装值 */
#define PWM_DIV      5          /* 每 5 个 tick 走一个 PWM 步 => 500us/步 */
#define PWM_STEPS    20         /* 20 步 = 10ms = 100Hz；占空比 5% 一档 */
#define BUZ_DIV      5          /* 蜂鸣器每 5 个 tick 翻一次 = 1kHz */
#define MAXGEAR      5          /* 档位 0（停）.. 5（100%） */

/* ---- 倒车安全限制（没办法，没装后向传感器，只能软件硬兜）----
 * 超声波和车头红外都装在车头、只能朝前看，倒车时它俩就是瞎的，
 * 所以倒车硬加了三条限制：
 *   ① 限速：倒车最多只给 BACK_GEAR_MAX 档（数码管照样显示你按的档位，
 *      只是实际出力偷偷封了顶）；
 *   ② 限时：一直倒超过 BACK_TMO_TICKS 就自动停下并响两声，
 *      想接着倒就松开再按一次后退键；
 *   ③ 倒车时超声波避障不参与，不然倒着倒着它自己原地转起来。
 * ---------------------------------------------------------------- */
#define BACK_GEAR_MAX  2        /* 倒车最高档：2/5 ≈ 40% 占空比 */
#define BACK_TMO_TICKS 30000    /* 连续倒车最长 3.0s（30000 × 99.83us ≈ 2.995s）*/

#define BEEP_TICKS   40         /* 提示音：40 个半周期 ≈ 20ms */
#define BEEP_KEY     24         /* 收到遥控键的短提示音 ≈ 12ms */

#define MS10_DIV     100        /* 100 tick = 9.983ms ≈ 10ms：录制/回放的节拍单位 */

/* 时基超时门限（单位 tick，换成时间见注释） */
#define LP_TMO_TICKS   9984     /* S3/S4 长按门限 39×256 ≈ 1.0s */
#define HOLD_TMO_TICKS 3000     /* 松键停车：11×256+184 = 3000 tick ≈ 300ms */
#define TRK_TMO_TICKS  4864     /* 循迹脱线超时 19×256 ≈ 0.5s */
#define ERRTMO_TICKS   2000     /* "帧被拒"诊断打印限流 ≈ 200ms */
#define AVBEEP_TICKS   6912     /* 刹停锁存期间间歇响的间隔 27×256 ≈ 0.69s */
/* 锁存的提醒音只响 AVBEEP_N 声就安静下来（含刹停那一声）。
 * 车还是照旧停着等遥控操作，只是不一直响了。
 * 想恢复成一直响到有人接管，把这个值改大即可。 */
#define AVBEEP_N       3
/* 障碍要持续退到 US_CLEAR 之外这么久，才算真的让开了。
 * 加这段是因为超声波贴得很近时读数会抖：一会儿读到很近，一会儿读不到
 * 回波，锁存会被反复重立，听起来就像过一会儿又响一声。 */
#define AV_CLEAR_TICKS 5000

/* 车头红外这一路的提示音是否静音（刹车功能保留）。
 * 1 = 静音（当前用这个）；0 = 也让红外这一路参与锁存提醒。
 * 注意这只影响声音，红外刹车仍然是全局的、关不掉的。 */
#define IR_BEEP_SILENT 1
#define D20MS_TICKS    200      /* 20ms：按键去抖 / 提示音间隔 */
#define US_TRIG_TICKS  2        /* 超声波触发脉冲宽度：2 tick ≈ 200us（规格要求 >= 10us） */

/*=========================================================================
 * 四、红外 NEC 门限（单位 tick，1 tick = 100us）
 *   完整帧：9ms 低 + 4.5ms 高，后面跟 32 位数据；
 *           每一位是 0.56ms 低 + 一段高电平，高电平 0.56ms 是 0，
 *           1.69ms 是 1。
 *   重复帧：9ms 低 + 2.25ms 高，之后一直是高，表示键还按着。
 *=========================================================================*/
#define IR_LEAD_MIN   70        /* 引导码低电平下限 7ms（标称 9ms，放宽） */
#define IR_LEAD_MAX   120       /* 引导码低电平上限 12ms */
#define IR_LEADHCAP   60        /* 引导码高电平只量到 6ms 就收手：到点还高 = 重复帧 */
#define IR_LEADH_MIN  25        /* 完整帧的引导码高电平至少 2.5ms */
#define IR_REP_MIN    12        /* >= 1.2ms 才可能是引导码，短于此当噪声 */
#define IR_BIT_TH     11        /* 位高电平 >= 1.1ms 判为位 1（0.56 / 1.69 的中间） */
#define IR_BITCAP     12        /* 最后一位只量到 1.2ms 就下结论（后面是空闲高电平） */

/*=========================================================================
 * 五、动作码与电机图案
 *=========================================================================*/
#define ACT_STOP      0x00
#define ACT_FORWARD   0x01
#define ACT_BACK      0x02
#define ACT_LEFT      0x03
#define ACT_RIGHT     0x04
#define ACT_ARC_L     0x05      /* 弧线左转：两轮都正转，左轮（内轮）慢 */
#define ACT_ARC_R     0x06      /* 弧线右转：两轮都正转，右轮（内轮）慢 */
#define ACT_NONE      0xFF      /* key2act 用：不认识的键 */

#define GEAR_DEFAULT  3         /* 挂在 0 档时按方向键 -> 自动跳到这一档（60%） */

/* P0 低 4 位方向图案（IN1..IN4） */
#define DIR_STOP      0x00
#define DIR_FWD       0x05      /* IN1 + IN3 -> 两轮同向正转 */
#define DIR_BACK      0x0A      /* IN2 + IN4 -> 两轮同向反转 */
#define DIR_LEFT      0x06      /* IN2 + IN3 -> 左轮反转 + 右轮正转 = 原地左转 */
#define DIR_RIGHT     0x09      /* IN1 + IN4 -> 左轮正转 + 右轮反转 = 原地右转 */

/*=========================================================================
 * 六、避障闸门的状态
 *   闸门只在手动和寻光两种模式下起作用，循迹模式不参与
 *   （循迹是自己找线跑，被推开就跑偏了）。
 *=========================================================================*/
#define AV_FREE       0         /* 放行：无障碍 */
#define AV_TURN       1         /* 近区：动作一律改写成"原地右转避让" */
#define AV_HOLD       2         /* 太近：刹停 + 锁存，车不动，决定权交给遥控 */
#define AV_HUMAN      3         /* 遥控已接管：完全放行；距离回到安全值后自动回 AV_FREE */

/* 超声波门限（1 tick ≈ 1.72cm：回波高电平 ≈ 58.3us/cm） */
#define US_NEAR       12        /* 12 tick ≈ 21cm：更近 -> 转向避让 */
#define US_STOP       3         /* 3 tick ≈ 5cm：更近 -> 刹停锁存 */
#define US_CLEAR      7         /* 7 tick ≈ 12cm：退到这儿才停止间歇响（滞回，防止抖动） */
#define US_TOUT_TICKS 250       /* 等回波上升沿最多等 250 tick，大约 25ms。
                                 * 模块正常 1ms 内就有回波，这个余量足够；
                                 * 超时由中断自己收场，不会把主循环堵住。 */
#define US_GAP_MS10   6         /* 两次测距之间至少隔 6 × 10ms = 60ms。
                                 * 模块要求测距周期不小于 60ms，测得太密它就不响应了，
                                 * 那样每一趟都白等一回，车看起来就像不动。 */
#define US_FAR        0xFF      /* 没回波 / 太远（> 255 tick ≈ 4.4m）：当作"够远" */
#define PSF_GAP       6         /* 回放中测距节流：6 × 10ms = 60ms（HC-SR04 规格要求） */

/*=========================================================================
 * 七、运行模式
 *   板上 S3 长按可以循环切换模式，遥控数字键 1 / 2 / 3 可以直接选。
 *   避障不是一个模式，它是所有模式下都在跑的判断。
 *=========================================================================*/
#define MODE_MANUAL   0
#define MODE_LIGHT    1         /* 寻光 */
#define MODE_TRACK    2         /* 循迹 */
#define NMODES        3         /* S3 长按循环只在这 3 个模式里转 */
#define MODE_PLAY     3         /* 回放模式。故意让它排在模式表最后，
                                 * 这样长按 S3 循环切模式永远切不到它，只能按遥控数字键 8 进入。 */

/*=========================================================================
 * 八、遥控键值（cmd 字节，全部实测确认）
 *=========================================================================*/
#define KEY_FORWARD   0x46
#define KEY_BACK      0x15
#define KEY_LEFT      0x44
#define KEY_RIGHT     0x43
#define KEY_STOP      0x40
#define KEY_SPD_UP    0x5A      /* 数字键 6 */
#define KEY_SPD_DN    0x08      /* 数字键 4 */
#define KEY_M1        0x0C      /* 数字键 1 -> 手动 */
#define KEY_M2        0x18      /* 数字键 2 -> 寻光 */
#define KEY_M3        0x5E      /* 数字键 3 -> 循迹 */
/* 数字键 5：超声波避障开关，和长按 S4 是一个功能（遥控上够得着，
 * 用起来方便）。它只管超声波，车头红外是全局的，这个键关不掉。
 * 遥控没电时还可以长按 S4 开关，两条路都在。 */
#define KEY_AVOID     0x1C      /* 数字键 5 -> 超声波避障开/关 */
#define KEY_REC       0x42      /* 数字键 7 -> 录制开/关 */
#define KEY_PLAY      0x52      /* 数字键 8 -> 回放 */
#define KEY_CLR       0x4A      /* 数字键 9 -> 清空记录 */
#define LASTCMD_NONE  0xFF      /* "还没收过键"的哨兵值 */

/*=========================================================================
 * 九、录制 / 回放的参数
 *   一条记录占 3 个字节：
 *     第 1 字节 = (动作码 << 4) | 档位
 *     第 2 字节 = 时长的低 8 位
 *     第 3 字节 = 时长的高 8 位（单位 10ms）
 *   最多 80 条，共 240 字节，放在片内扩展 RAM 的 0x0000~0x00EF。
 *=========================================================================*/
#define REC_BASE      0x0000    /* 记录区起点（XBYTE 的偏移基址） */
#define REC_MAX       80        /* 最多 80 条 */
#define REC_UNIT      3         /* 每条 3 字节 */
#define ACTPK_MASK    0xF0      /* Byte0 高 4 位 = 动作码 */
#define GEAR_MASK     0x0F      /* Byte0 低 4 位 = 档位 */
#define RECCAP_H      0x0B      /* 单条记录的时长上限，只看高字节：0x0B00 × 9.983ms 约 28 秒。
                                 * 只看高字节是为了省掉 16 位比较，这里不需要很精确。 */

/* 第 n 条记录的起始地址 = n × 3。
 * 这里写成移位加加法而不是直接乘 3，是为了不让编译器去调乘法库函数，
 * 少一个外部符号，手工排地址时省事。 */
#define REC_ADDR(idx)  ((unsigned int)(((unsigned int)(idx) << 1) + (idx)))

/*=========================================================================
 * 十、数码管段码
 *   共阳数码管，写 0 才亮。位序 bit7..bit1 对应 a~g，bit0 是 D3 指示灯。
 *   要注意段选顺序是反的：a 接在 P2.7，g 接在 P2.1；P2.0 不是段选。
 *=========================================================================*/
#define DISP_0  0x03
#define DISP_1  0x9F
#define DISP_2  0x25
#define DISP_3  0x0D
#define DISP_4  0x99
#define DISP_5  0x49
#define DISP_6  0x41
#define DISP_7  0x1F
#define DISP_8  0x01
#define DISP_L  0xE3            /* 寻光模式代号 "L" */
#define DISP_T  0xE1            /* 循迹模式代号 "t" */
#define DISP_R  0xF5            /* 录制中 "r"（只点 e+g） */
#define DISP_P  0x31            /* 回放中 "P" */
#define DISP_E  0x61            /* 空记录 / 拒绝 */
#define DISP_F  0x71            /* 已录满 80 条 */

/*=========================================================================
 * 十一、常量表（放程序存储器 code，不占 RAM）
 *=========================================================================*/
static const unsigned char code gear_tab[6] = {     /* 档位 0..5 的段码 */
    DISP_0, DISP_1, DISP_2, DISP_3, DISP_4, DISP_5
};

static const unsigned char code duty_tab[5] = {     /* 档位 1..5 -> PWM 档 0..20 */
    4, 8, 12, 16, 20                                 /* 20/40/60/80/100% */
};

/* 弧线转弯时内轮的占空比（外轮还是按 duty_tab 给）。
 * 内轮和外轮差别越小，转弯半径越大；内轮越小，弯越急。
 * 现在取的是外轮的 20%~25%，之前取 40% 时感觉转弯太慢，就调小了。 */
static const unsigned char code arc_tab[5] = { 1, 2, 2, 3, 4 };

static const unsigned char code mode_tab[4] = {     /* 索引 = 模式号 */
    DISP_0, DISP_L, DISP_T, DISP_P                   /* 0 手动 / 1 寻光 / 2 循迹 / 3 回放 */
};

#if DIAG_IR
static const unsigned char code hex_seg[16] = {     /* 0..F 段码（诊断显示用） */
    0x03, 0x9F, 0x25, 0x0D, 0x99, 0x49, 0x41, 0x1F,
    0x01, 0x09, 0x11, 0x81, 0x63, 0x85, 0x61, 0x71
};
#endif

/*=========================================================================
 * 十二、全局变量
 *   分成几组：中断里用的、时基、业务状态、录制回放。
 *   中断和主循环都要用的，一律加 volatile。
 *=========================================================================*/

/*---- 12.1 中断内维护 ----*/
static unsigned char pwm_div;               /* PWM 分频计数 0..PWM_DIV-1 */
static unsigned char pwm_cnt;               /* PWM 当前步 0..19 */
/* 这里删掉了两个只写不读的变量，给直接寻址区腾地方：
 *   buz_div  —— 蜂鸣器改成每个 PWM 步翻转一次以后就没人读它了；
 *   ml_start —— 本来用来存量脉宽的起始时刻，实际是存进去又马上读出来，
 *               直接赋给 t0 就行，不需要占一个全局。
 * 直接寻址区只有 30H~7FH 共 80 字节，加变量时要留心别超了。 */
static volatile unsigned char buz_left;     /* 蜂鸣器还剩几个半周期 */
static bit buz_quiet;                       /* 1 = 静音（P0.6 为高，PNP 不导通）。
                                             * 不写静态初值，那样会生成初始化段；
                                             * 由 init_all() 在开中断之前置 1。 */
static bit ena;                             /* 本步 ENA 使能 */
static bit enb;                             /* 本步 ENB 使能 */
static volatile unsigned char tick_l;       /* 100us 时基低字节 */
static volatile unsigned char tick_h;       /* 100us 时基高字节（溢出周期 6.55s） */
static volatile unsigned char ms10_l;       /* 10ms 时基低字节 */
static volatile unsigned char ms10_h;       /* 10ms 时基高字节 */
static unsigned char ms_div;                /* 10ms 分频计数 0..99 */
/* 超声波测距：一个纯非阻塞的小状态机。
 * 中断每 99.83us 推一步，主循环只管发触发、取结果，一次都不干等，
 * 所以就算模块摆烂不响应，也拖不慢主循环，遥控不至于被饿死。
 * 这些变量都不写静态初值——本工程不跑 C 运行期那段初始化，
 * 初值一律由 us_init() 在开中断之前手动给。 */
#define US_ST_IDLE    0                     /* 空闲：没在测（绝大多数 tick 停在这里，中断开销最小）*/
#define US_ST_WAIT    1                     /* 已发触发，等回波上升沿 */
#define US_ST_HIGH    2                     /* 回波已拉高，正在数宽度 */
static volatile unsigned char us_st;        /* 状态机当前状态 US_ST_* */
static volatile unsigned char us_wid;       /* 本次回波已持续几个 tick（中断里 +1）*/
static volatile bit us_got;                 /* 1 = 刚量完，结果在 us_res（主循环取走后清 0）*/
static volatile unsigned char us_res;       /* 量到的结果：tick 数 / US_FAR = 没量到 */
static unsigned char us_wait;               /* 等上升沿已等了多少 tick（只由中断 +1）*/
static bit us_valid;                        /* 0 = 还没量到过：一律按"够远"报（失效安全）*/
static bit us_seen;                         /* 节流：是否触发过一次 */
static unsigned char us_last10;             /* 节流：上次触发时的 10ms 计数 */
static unsigned char us_last_d;             /* 节流：上次的结果 */
#if AV_SCOPE
static unsigned char us_stage;              /* 自测版用：0=上升沿超时 1=够远 2=量到了 */
#endif

/*---- 12.2 电机与档位（主循环写、中断读）----*/
static volatile unsigned char dirbits;      /* 方向位 D0~D3 */
static volatile unsigned char duty_a;       /* 左轮 ENA 占空比 0..20 */
static volatile unsigned char duty_b;       /* 右轮 ENB 占空比 0..20 */
static unsigned char gear;                  /* 当前档位 0..5 */
static unsigned char cur_act;               /* 当前动作码（D3 指示灯靠它判"在动"） */
/* A：倒车限时（back_guard 用；中断不碰，只在主循环里读写）*/
static bit back_on;                         /* 1 = 正在倒车且已开始计时 */
static unsigned int back_t0;                /* 本次倒车的起始时刻 */
/* 超声近距提示音（"倒车雷达"）的上次发声时刻 / 停车后计时 */
static unsigned int prox_t;
static bit prox_moving;                     /* 1 = 车在动（用来捕捉"刚停下"的那一刻）*/
static bit prox_hold;                       /* 1 = 还在停车后 2 秒的宽限时间里；
                                             * 到点以后一直是 0，直到车再次动起来。 */
static unsigned int prox_stop_t;            /* 车停下的时刻（停车后还要响 2s）*/

/*---- 12.3 按键 ----*/
static unsigned char klast;                 /* 0 = 都松开 / 1 = S3 短 / 2 = S4 短 / 3 = S3 长 / 4 = S4 长 */

/*---- 12.4 红外解码 ----*/
static unsigned int  ml_dur;                /* 量到的时长（tick） */
static unsigned char ml_cap;                /* 量脉宽的限时；0 = 默认 25.6ms */
static unsigned char ml_level;              /* 要量的电平：0 = 低，1 = 高 */
static unsigned char ir_bits;               /* 剩余位数 */
static unsigned char ir_ptridx;             /* 当前字节序号 0..3 */
static unsigned char ir_maskb;              /* 当前位掩码 */
static unsigned char ir_ib0;                /* 地址 */
static unsigned char ir_ib1;                /* 地址取反 */
static unsigned char ir_ib2;                /* 命令 = 键值 */
static unsigned char ir_ib3;                /* 命令取反 */
static unsigned char irstat;                /* 0 完整帧 / 1 静默 / 2 被拒 / 3 重复帧 */
static unsigned char lastcmd;               /* 上次处理过的键值 */
static unsigned int  lastt;                 /* 最后一次收到红外帧的时刻 */
static unsigned char ir_ledlo;              /* 诊断：最近量到的引导码低电平 */
static unsigned char ir_ledhi;              /* 诊断：最近量到的引导码高电平 */
static unsigned int  last_err;              /* 上次打印"帧被拒"的时刻（限流） */
static bit ir_short;                        /* 1 = 本次引导码高电平是"短的"（1.2~2.5ms，待定） */
static unsigned char ir_inv;                /* 车头红外极性：0 = 低电平表示检测到 */
static bit us_avoid_on;                     /* 超声波避障开关，上电默认打开。
                                             * 它只管超声波；车头红外是全局的，关不掉。 */
static unsigned char avst;                  /* 避障闸门状态 AV_* */
static unsigned int  av_beep_t;             /* 上次"刹停提示音"的时刻 */
static unsigned char av_beep_n;             /* 本次锁存已经响了几声（到 AVBEEP_N 就安静）*/
static bit av_clear_on;                     /* 是否已开始计"障碍退远"的时间 */
static unsigned int av_clear_t;             /* 开始计时的时刻 */

/*---- 12.5 模式与板载计时 ----*/
static unsigned char mode;                  /* 当前模式 MODE_* */
static unsigned int  last_line;             /* 最后一次"探头看到黑线"的时刻 */

/*---- 12.6 录制 / 回放 ----*/
static bit recon;                           /* 1 = 正在录制（叠加在手动模式上的标志） */
static bit playerr;                         /* 1 = 上次回放因"安全"终止 */
static bit recfull;                         /* 1 = 已录满 80 条 */
static unsigned char pack;                  /* 待提交记录的 (动作<<4)|档位 —— 合并判定只看它 */
static unsigned int  cur_dur;               /* 当前记录已累计时长 */
static unsigned int  samp;                  /* 上次采样时刻（回放的安全检测也复用它） */
static unsigned char recn;                  /* 已提交记录数 0..80 */
static unsigned char playidx;               /* 回放索引 0..79 */
static unsigned int  play_dur;              /* 当前回放条目时长 */
static unsigned int  play_t0;               /* 当前回放条目起始时刻 */
static unsigned char play_gear0;            /* 进入回放前的档位（退出时恢复） */

#if DIAG_IR
static unsigned char diag_cmd;              /* 诊断：要显示的键值 */
static unsigned char diag_on;               /* 诊断：0 关 / 1 显示键值 / 2 显示被拒参数 */
static unsigned char diag_seq;              /* 诊断：0..7 */
static unsigned int  diag_t0;               /* 诊断：上一次换显示内容的时刻（600ms 一换） */
#endif

