/*=========================================================================
 * 十九、电机统一出口 motor_set(action, speed)  —— 报告里的 Motor_Set
 *   入：act = ACT_*；g = 档位 1..5（0 = 停）
 *   只改 dirbits / duty_a / duty_b，真正的输出由 Timer0 中断完成。
 *
 *   ★ 这里是避障闸门的**唯一出口**：所有驱动电机的调用都要经过它，
 *     所以"要不要改写动作 / 要不要刹停"只需要在这一个地方判。
 *     这也正是"不拦输入"能成立的原因 —— 有障碍时遥控照常响应（响铃、显示、
 *     记录），只是最后一步出不去。
 *=========================================================================*/
static void motor_set(unsigned char act, unsigned char g)
{
    if (g == 0) {                           /* 速度 0 -> 停（本来就没让动，闸门不用管）*/
        dirbits = DIR_STOP;
        duty_a = 0;
        duty_b = 0;
        return;
    }

    /* ---- 避障闸门：按状态决定要不要改写动作 ---- */
    if (avst == AV_TURN) {
        act = ACT_RIGHT;                    /* 近区：一律改写成原地右转绕开 */
    } else if (avst == AV_HOLD) {           /* 太近：强制刹停（锁存，等遥控决定）*/
        cur_act = ACT_STOP;                 /* 真停了 -> 当前动作也要清零，
                                             * 否则寻光/循迹每趟都会把动作码设回来，
                                             * 车虽不动但 D3 会误亮"在动" */
        dirbits = DIR_STOP;
        duty_a = 0;
        duty_b = 0;
        return;
    }
    /* AV_FREE / AV_HUMAN -> 放行，按原动作走 */

    /* ---- ★ A：倒车限速（放在闸门之后，所以按"最终动作"判）----
     * 数码管显示的仍是用户设的档位，这里只封顶**实际出力**。 */
    if (act == ACT_BACK && g > BACK_GEAR_MAX)
        g = BACK_GEAR_MAX;

    duty_a = duty_tab[g - 1];               /* 1..5 -> 20/40/60/80/100% */
    duty_b = duty_a;                        /* 默认两轮同速 */

    /* ---- 弧线转弯：两轮都正转，只把内轮占空比调小 ----
     * 左右轮映射：duty_a = 左轮（ENA / IN1-IN2），duty_b = 右轮（ENB / IN3-IN4）。
     * 方向位用 DIR_FWD 而不是原地转的 DIR_LEFT / DIR_RIGHT。 */
    if (act == ACT_ARC_L) {
        duty_a = arc_tab[g - 1];            /* 左弧线：内轮 = 左轮 */
        dirbits = DIR_FWD;
        return;
    }
    if (act == ACT_ARC_R) {
        duty_b = arc_tab[g - 1];            /* 右弧线：内轮 = 右轮 */
        dirbits = DIR_FWD;
        return;
    }

    switch (act) {
    case ACT_FORWARD: dirbits = DIR_FWD;   break;
    case ACT_BACK:    dirbits = DIR_BACK;  break;
    case ACT_LEFT:    dirbits = DIR_LEFT;  break;
    case ACT_RIGHT:   dirbits = DIR_RIGHT; break;
    default:                                /* ACT_STOP 及任何意外值都当停车 */
        dirbits = DIR_STOP;
        duty_a = 0;
        duty_b = 0;
        break;
    }
}

/*=========================================================================
 * ★ C10：d3_mix —— **D3 的唯一出口**
 *   2026-09-21 用户需求：D3 原来表示"电机在动"，改成表示**避障开关状态**：
 *       亮 = `us_avoid_on == 1`（超声波避障**开着**）
 *       灭 = `us_avoid_on == 0`（**关着**）
 *   ★ 所有写 P2 的地方都**必须**经过这里 —— 否则总有一处会把 D3 写错
 *     （改之前 `apply_gear` / `show_state` / `show_mode` 三处各自 `&= 0xFE`）。
 *   位定义：P2.0 = D3，**写 0 亮**；P2 与数码管段码共用，只能整字节写。
 *=========================================================================*/
static unsigned char d3_mix(unsigned char seg)
{
    if (avoid_off() == 0)                   /* ★ C14：录制中 D3 也会灭（避障此刻不参与）*/
        return (unsigned char)(seg & 0xFE);     /* D3 位清 0 = 亮 */
    return (unsigned char)(seg | 0x01);         /* D3 位写 1 = 灭 */
}

/*=========================================================================
 * ★ C14（2026-09-21 用户需求）：avoid_off —— **超声波避障"现在是否不参与"**
 *   规则只有这一处：**录制中一律不参与**（`recon == 1`），或者用户把开关关了。
 *
 *   用户原话："录制时默认关闭避障"。
 *   为什么录制要关它：**录制是"人在教"** —— 超声波那一路会在近区
 *     · 把动作**改写成原地右转**（AV_TURN），
 *     · 太近时**刹停 + 锁存**（AV_HOLD，而且它会把 `cur_act` 清成 STOP）
 *     ⇒ 前者让人莫名其妙、后者**直接污染记录**（录进去一条 STOP），
 *        "教"出来的轨迹就不是人开的轨迹了。
 *   ★ 用了"**实时等效屏蔽**"而不是"进录制时把它关掉、退出再打开"：
 *     · 退出录制的路径不止一条（`rec_exit` / `rec_fullstop` / `clr_key` / 进回放…），
 *       存/取值**很容易漏一处**；实时判定**不可能漏**；
 *     · 录制中按开关（数字键 5 / 长按 S4）只会改**离开录制之后**的状态，两边不打架。
 *   ★ 与循迹的区别：循迹是"超声波不参与、**但红外刹车仍在**"；
 *     录制**同理** —— **车头红外那道刹车不受这里影响**（C2/C3 冻结：全局、关不掉），
 *     录制时贴着东西照样会刹停（也会往记录里写一条 STOP）。 */
static bit avoid_off(void)
{
    if (recon)
        return 1;                           /* ★ 录制中 -> 超声波这一路不参与 */
    if (us_avoid_on)
        return 0;
    return 1;                               /* 用户把开关关了 */
}

/*=========================================================================
 * 二十、apply_gear —— 把当前档位套用到电机 + 数码管
 *   档位 0   -> 停车，数码管 "0"
 *   档位 1~5 -> 前进，占空比 20/40/60/80/100%，数码管显示档位
 *   （手动模式下"档位非 0 就是前进"是块① 定下的语义，一直沿用）
 *   ★ D3 不在这里决定 —— 它由 `d3_mix()` 按**避障开关**统一给（C10）。
 *=========================================================================*/
static void apply_gear(void)
{
    if (gear == 0)
        goto stop;

    /* 刹停锁存期间，本地加档也不许把车开起来 —— 锁存的语义是"决定权在遥控手里" */
    if (avst == AV_HOLD)
        goto stop;

    /* ★ 必须同时维护 cur_act：避障闸门用 "cur_act != 0" 判断"本来就在动"。
     * 若车在走而 cur_act = 0，闸门会以为车停着而直接放行 —— 车就不躲障碍了。 */
    cur_act = ACT_FORWARD;

    duty_a = duty_tab[gear - 1];
    duty_b = duty_a;
    dirbits = DIR_FWD;

    P2 = d3_mix(gear_tab[gear]);
    return;

stop:
    cur_act = ACT_STOP;                     /* 真停车了就要清掉，否则 D3 会误亮 */
    duty_a = 0;
    duty_b = 0;
    dirbits = DIR_STOP;
    P2 = d3_mix(gear_tab[gear]);
}

/*=========================================================================
 * 二十一、显示
 *=========================================================================*/
/* show_state —— 显示档位
 * ★ 录制中数码管固定显示 'r'：在出口统一拦一道，保证 'r' 不会被档位数字盖掉。
 * ★ D3 **不在这里决定** —— 由 `d3_mix()` 按避障开关统一给（C10）。 */
static void show_state(void)
{
    P2 = d3_mix(recon ? DISP_R : gear_tab[gear]);
}

/* show_mode —— 按模式刷新数码管：手动 = 档位；其它 = 模式代号
 * ★ D3 在任何模式下都只表示**避障开关状态**（C10），与"在动/模式"无关。 */
static void show_mode(void)
{
    if (mode == MODE_MANUAL) {
        show_state();
        return;
    }

    P2 = d3_mix(mode_tab[mode]);
}

/*=========================================================================
 * 二十二、按键扫描（20ms 去抖 + 松手才认下一次）
 *   出：0 = 无事件 / 1 = S3 短按（加档）/ 2 = S4 短按（减档）
 *       3 = S3 长按（切模式）/ 4 = S4 长按（避障开关）
 *   ★ S3/S4 都是"按下后计时等松手"：松手 < 1s = 短按；按住 >= 1s = 长按。
 *     不是"按下就动作"—— 否则长按切模式会顺带多加一档。
 * =========================================================================*/
static unsigned char key_scan(void)
{
    unsigned int t0;

    if (klast) {                            /* 上一次还按着 -> 先等松手 */
        if (klast == 2 || klast == 4) {
            if (KEY_S4) klast = 0;
        } else {
            if (KEY_S3) klast = 0;
        }
        return 0;
    }

    if (!KEY_S3) {
        d_20ms();
        if (KEY_S3) return 0;               /* 20ms 后已经松开 -> 抖动，不算 */
        t0 = tick_get();
        while (!KEY_S3) {                   /* 一直按住 -> 计时判长按 */
            if ((unsigned int)(tick_get() - t0) >= LP_TMO_TICKS) {
                klast = 3;
                return 3;
            }
        }
        klast = 1;
        return 1;                           /* 短按 = 加档 */
    }

    if (!KEY_S4) {
        d_20ms();
        if (KEY_S4) return 0;
        t0 = tick_get();
        while (!KEY_S4) {
            if ((unsigned int)(tick_get() - t0) >= LP_TMO_TICKS) {
                klast = 4;
                return 4;
            }
        }
        klast = 2;
        return 2;                           /* 短按 = 减档 */
    }

    return 0;
}

/*=========================================================================
 * 二十三、键值 -> 动作码
 *   出：动作码，或 ACT_NONE（不认识的键）
 *   ★ "正在前进/弧线中"时按左/右 = 弧线转弯；车停着按 = 原地转。
 * =========================================================================*/
static bit k_isfwd(void)
{
    if (cur_act == ACT_FORWARD) return 1;
    if (cur_act == ACT_ARC_L)   return 1;
    if (cur_act == ACT_ARC_R)   return 1;
    return 0;
}

static unsigned char key2act(unsigned char v)
{
    switch (v) {
    case KEY_FORWARD: return ACT_FORWARD;
    case KEY_BACK:    return ACT_BACK;
    case KEY_LEFT:    return k_isfwd() ? ACT_ARC_L : ACT_LEFT;
    case KEY_RIGHT:   return k_isfwd() ? ACT_ARC_R : ACT_RIGHT;
    case KEY_STOP:    return ACT_STOP;
    default:          return ACT_NONE;
    }
}

/*=========================================================================
 * 二十四、键值 -> 目标模式（遥控数字键 1/2/3 直接选模式）
 *   出：目标模式号，或 0xFF = 不是模式直选键
 * =========================================================================*/
static unsigned char key2mode(unsigned char v)
{
    switch (v) {
    case KEY_M1: return MODE_MANUAL;
    case KEY_M2: return MODE_LIGHT;
    case KEY_M3: return MODE_TRACK;
    default:     return 0xFF;
    }
}

/*=========================================================================
 * 二十五、模式切换与副作用
 *   mode_goto 是唯一的模式落地口：算下一个（mode_switch）和直选（遥控 1/2/3）
 *   都走它，保证两边的副作用一致。
 * =========================================================================*/
static void mode_goto(unsigned char m)
{
    mode = m;
    lastcmd = LASTCMD_NONE;

    if (m == MODE_MANUAL) {
        /* 回手动时**不停车、继续走**：手动模式的语义本来就是"档位非 0 = 前进"，
         * 所以按当前档位接着走；档位 0 则照旧停。
         * ★ 必须同时把 cur_act 置上：闸门靠 cur_act != 0 判断"本来就在动"，
         *   若车在走而 cur_act = 0，避障会直接放行不躲。 */
        cur_act = gear ? ACT_FORWARD : ACT_STOP;
        motor_set(cur_act, gear);           /* gear = 0 时这个出口就是停车 */
        show_state();
    } else {
        cur_act = ACT_STOP;                 /* 进自主模式：先清掉遥控动作，交给模式动作接管 */
        if (gear == 0)
            gear = GEAR_DEFAULT;            /* 0 档进自主模式车不会动，补一个默认档 */
        last_line = tick_get();             /* 刷新"最后看到线"的时刻（循迹脱线超时的基准）*/
        show_mode();
    }

    beep(BEEP_TICKS);                       /* 切模式提示音 */
}

static void mode_switch(void)
{
    unsigned char m = mode;

    if (m == MODE_PLAY) {                   /* 回放中长按 S3 -> 直接回手动 */
        mode_goto(MODE_MANUAL);
        return;
    }
    m++;
    if (m >= NMODES)
        m = 0;                              /* 绕回手动 */
    mode_goto(m);
}

/*=========================================================================
 * 二十六、寻光（P1.1 左 / P1.0 右，见光 = 低）
 *   两边都见光 -> 直走；只有一边亮 -> 朝那边转；都遮住 -> 停。
 *   速度用当前档位，档位 0 时显式停车（不能直接返回，否则会保持上次动作）。
 * =========================================================================*/
static void light_step(void)
{
    unsigned char act;

    if (gear == 0) {
        act = ACT_STOP;
    } else if (!LDR_LEFT) {
        act = LDR_RIGHT ? ACT_LEFT : ACT_FORWARD;   /* 只有左边亮 -> 左转 */
    } else {
        act = LDR_RIGHT ? ACT_STOP : ACT_RIGHT;     /* 只有右边亮 -> 右转 */
    }

    cur_act = act;                          /* 记下当前动作，显示靠它点 D3 */
    motor_set(act, gear);
    show_mode();                            /* 每趟刷新（模式代号 + D3 动/停）*/
}

/*=========================================================================
 * 二十七、循迹（P3.5 左 / P3.6 右，压黑线 = 高）
 *   极性实测：白底/有反射 = 低，压黑线 = 高。
 *   ★ 转向规则按几何推，别凭手感记：
 *       11 两个都压线 = 骑在线上 -> 直走
 *       10 只有左探头压线 = 线在车左下方 = 车偏到线的右边 -> **左转**修正
 *       01 只有右探头压线 = 线在车右下方 = 车偏到线的左边 -> **右转**修正
 *       00 两个都白 = 脱线 -> 先直走找线，超过 0.5s 就停车
 * =========================================================================*/
static void track_step(void)
{
    unsigned char a = 0;
    unsigned char act;

    if (TRACK_L) a |= 0x02;                 /* bit1 = 左探头 */
    if (TRACK_R) a |= 0x01;                 /* bit0 = 右探头 */

    if (a == 0) {                           /* 脱线 */
        if ((unsigned int)(tick_get() - last_line) >= TRK_TMO_TICKS)
            act = ACT_STOP;                 /* 脱线超时 -> 停车 */
        else
            act = ACT_FORWARD;              /* 刚脱线 -> 先直走找回来 */
    } else {
        last_line = tick_get();             /* 至少一路压线 -> 刷新"最后看到线"的时刻 */
        if (a == 1)      act = ACT_RIGHT;   /* 只有右探头压线 */
        else if (a == 2) act = ACT_LEFT;    /* 只有左探头压线 */
        else             act = ACT_FORWARD; /* 两个都压线 */
    }

    cur_act = act;
    motor_set(act, gear);
    show_mode();
}

/*=========================================================================
 * 二十八、超声波测距（**完全非阻塞**，C7）
 *   出：回波高电平的 tick 数（≈1.72cm/tick）；US_FAR(0xFF) = 没量到 / 够远
 *   ★ 读不到回波一律当"够远"：这是**失效安全**的方向（不会因为传感器坏了就刹死）。
 *
 *   ★★★ 2026-09-21 第三次重写（C7）：从"带节流的阻塞式"改成**状态机**。
 *
 *   为什么要改（C6 实机仍然不行）：
 *     C6 把窗口收到 40ms 之后，"车不动/遥控抽风"是好了，但避障还是时灵时不灵 ——
 *     因为 `us_read()` 依旧是**阻塞**的：模块这一趟没回波，主循环就白等一整个窗口。
 *     而红外遥控一帧要 67ms，主循环一被拖，方向键就丢。
 *     ⇒ 根因不是"窗口多长"，而是**主循环里根本不该出现等待**。
 *
 *   现在改成三态状态机，**全部由中断推进**（见中断第 ⑥ 段）：
 *
 *       IDLE --us_trigger()--> WAIT --回波上升沿--> HIGH --下降沿--> IDLE（结果就绪）
 *                                |                              |
 *                                +-- US_TOUT_TICKS 超时 --------+
 *
 *   主循环只做两件事，都是几微秒级：
 *     ① 下一趟调 `us_read()` 时把中断量好的结果取走
 *     ② 距离上次触发 ≥60ms 且当前空闲，就发一个 ~13µs 的触发脉冲，然后**立刻返回**
 *   模块不响应时，WAIT 由中断在 ≈25ms 后自行超时收场，**主循环全程无等待**，
 *   遥控接收不再被打断 —— 这正是 C5/C6 两版都没解决的那个坑。
 * =========================================================================*/

/* 上电初始化：所有状态变量显式清零。
 * ⚠️ 不能用静态初值（那会生成 C 运行期初始化段 ?C_INITSEG，而本工程的启动代码
 *    不跑它，见 c51_link.py 的硬检查），所以必须在这里给。 */
static void us_init(void)
{
    ET0 = 0;                                /* 别让中断看到"改了一半"的状态 */
    us_st     = US_ST_IDLE;
    us_wid    = 0;
    us_wait   = 0;
    us_got    = 0;
    us_res    = US_FAR;
    us_valid  = 0;
    us_seen   = 0;
    us_last10 = 0;
    us_last_d = US_FAR;
#if AV_SCOPE
    us_stage  = 0;
#endif
    US_TRIG   = 0;                          /* 触发脚平时保持低 */
    ET0 = 1;
}

/* 发一个触发脉冲（低 ~9µs → 高 ~13µs → 低）并把状态机挂到 WAIT。
 * ★ 时序是与 usprobe.hex（能正常测距的那份）逐条对齐的：高电平必须是 ~13µs 量级。
 *   逐个 `_nop_()` 展开（每条正好 1 个机器周期 ≈ 1.085µs），不依赖循环优化的快慢。
 * ★ 顺序有讲究：先清计数、**最后**才写 us_st** —— 中断只在 us_st != IDLE 时才碰这些
 *   变量，所以这样写不会和中断抢；us_got 故意不在这里清（万一中断刚好量完，
 *   那个结果留给下一次 us_read 取走，不会白丢一次测量）。 */
static void us_trigger(void)
{
    US_TRIG = 0;
    _nop_(); _nop_(); _nop_(); _nop_(); _nop_(); _nop_(); _nop_(); _nop_();
    US_TRIG = 1;
    _nop_(); _nop_(); _nop_(); _nop_(); _nop_(); _nop_();
    _nop_(); _nop_(); _nop_(); _nop_(); _nop_(); _nop_();
    US_TRIG = 0;

    us_wid  = 0;
    us_wait = 0;
    us_st   = US_ST_WAIT;                   /* ← 最后写：中断从这里开始接管 */
}

/* 入口：**绝不阻塞**，主循环每趟都能放心调。
 *   出：最近一次量到的 tick 数（≈1.72cm/tick）；US_FAR = 够远 / 还没量到过 */
static unsigned char us_read(void)
{
    unsigned char t10 = ms10_l;             /* 10ms 计数（8 位够：60ms 内不会绕回）*/

    /* ---- 1) 中断刚量完？把结果取走 ----
     * 取结果 + 清标志要一起做（关中断只有几个机器周期），免得中断正好插在中间，
     * 出现"标志清了、值没取"或"值取了、标志没清"的半截状态。 */
    if (us_got) {
        ET0 = 0;
        us_last_d = us_res;
        us_got    = 0;
        us_valid  = 1;
        ET0 = 1;
    }

    /* ---- 2) 正在测：先把上次的结果给出去，**绝不在这里等** ---- */
    if (us_st != US_ST_IDLE)
        return us_valid ? us_last_d : US_FAR;

    /* ---- 3) 节流：距上次触发不到 60ms 就沿用上次结果 ----
     * HC-SR04 规格要求测距周期 ≥60ms；触发太密时模块**干脆不响应**，
     * 于是每一趟都白等一个窗口 —— 这正是"车不动"的根因（见 C6 的说明）。 */
    if (us_seen && (unsigned char)(t10 - us_last10) < US_GAP_MS10)
        return us_valid ? us_last_d : US_FAR;

    /* ---- 4) 空闲且够久：发一次触发，然后立刻返回 ---- */
    us_last10 = t10;
    us_seen   = 1;
    us_trigger();
    return us_valid ? us_last_d : US_FAR;   /* 本次不给新值，等下一次来取 */
}

/*=========================================================================
 * 二十九、车头红外近距检测（P3.7，量程只有 1~2cm）
 *   出：1 = 检测到（贴上了）；0 = 没东西
 *   ★ 极性不猜，上电时读一次 P3.7 当作"无反射"的参考电平（ir_inv），
 *     之后"检测到" ⇔ 当前电平与参考相反。不管硬件是"有反射=低"还是
 *     "有反射=高"，都自动正确。
 *   ⚠️ 前提：上电时车头 1~2cm 内不要有东西。
 *   ⚠️ 最坏情况（上电时正好贴着东西）只是这一路红外失效，**不会把车锁死**，
 *     失效方向是安全的。
 * =========================================================================*/
static bit ir_det(void)
{
    if (ir_inv) {                           /* 1 = 高电平表示检测到 */
        if (IR_AVOID) return 1;
        return 0;
    }
    if (IR_AVOID) return 0;                 /* 0 = 低电平表示检测到 */
    return 1;
}

/*=========================================================================
 * 三十、避障
 *
 *   ★★ 避障分**两条独立的通道**（2026-09-20 改动 C2 / C3）：
 *
 *   ① **车头红外对管**（P3.7，量程 1~2cm）—— **全局，三种模式都生效**
 *        作用范围：手动 / 寻光 / **循迹（也有）**
 *        触发时的动作：**直接刹车**（刹停 + 锁存 + 间歇响）
 *        ★★ 它**绝不**走"改写成原地右转"那套避让逻辑 ——
 *           量程只有 1~2cm，一旦检测到就等于**已经贴上了**，此时该停、不该绕；
 *           而且在循迹下"右转避让"会把车推离黑线，等于把循迹废掉。
 *        ★ 它**没有开关**，关不掉（这是"最后一道"的定位）。
 *
 *   ② **超声波**（5~21cm）—— **受手动开关控制**
 *        开关：板载 **长按 S4** 或 遥控 **数字键 5**（两条路等效）
 *        作用范围：手动 / 寻光（**循迹不参与**）
 *        三档行为：
 *          距离 >= 21cm          -> AV_FREE  放行，并把原动作重新套上
 *           5cm <= 距离 < 21cm   -> AV_TURN  改写成"原地右转避让"
 *           距离 < 5cm           -> AV_HOLD  刹停 + 锁存 + 间歇响，决定权交给遥控
 *
 *   ★ 为什么循迹**不要**超声波避障：循迹是"贴着线跑"的自主模式，
 *     超声波那一档"原地右转"会把车从线上推开；而且 avst 一旦卡在 AV_TURN，
 *     motor_set 会把循迹的**每一个**动作都改写成右转 -> 车原地打转、循迹彻底废掉。
 *     （红外没有这个问题：它只刹车、**不改写动作码**，所以放进循迹是安全的。）
 *
 *   锁存的语义（两条通道共用）：只有**遥控按键**能解除（-> AV_HUMAN）。
 *   障碍自己移开也不会让它重新动起来；障碍移开只**停响**，车仍然停着等遥控。
 *   ★ 不拦输入：遥控/按键照常响应（响铃、显示、记动作），否则有障碍时遥控就"聋"了。
 *   ★ 只有"本来就在动"（cur_act != 0）才主动避让，免得车停着自己拐走。
 * =========================================================================*/

/*-------------------------------------------------------------------------
 * ir_brake —— 车头红外触发：**直接刹车**，不转向避让、也不改模式
 *   ★ 手动 / 寻光 / 循迹 **三种模式共用**这一条路径。
 *   ★ 用 AV_HOLD 而不是 AV_TURN，这是关键：
 *       AV_TURN 会让 motor_set 把**任何**动作码都改写成"原地右转" ——
 *       在循迹下这会把车推离黑线，正是要避免的；
 *       AV_HOLD 是"强制刹停"，与动作码无关。
 *   ★ 本函数只在**刚触发**时调用一次（进入锁存）；之后每趟的间歇响
 *     由 av_gate 的 AV_HOLD 分支管 —— 所以这里不用担心重复响。
 *-------------------------------------------------------------------------*/
static void ir_brake(void)
{
    if (avst == AV_HUMAN)
        return;                             /* 遥控已接管 -> 放行，别再压住（R3 的语义）*/

    avst = AV_HOLD;                         /* 锁存：决定权交回遥控 */
    cur_act = ACT_STOP;
    motor_set(ACT_STOP, 0);
    show_mode();                            /* 用 show_mode：循迹下要保住 `t`，
                                             * 不能被 show_state 换成档位数字 */
    av_beep_t = tick_get();                 /* 之后由 av_gate 按间隔继续响（若允许）*/
    av_beep_n = 0;                          /* ★ C13：本次锁存的"已响次数"从 0 起算
                                             *   （红外路径入口静音，C11，所以是 0）*/
#if !IR_BEEP_SILENT
    av_beep_n = 1;                          /* 入口这一声也算一次 */
    beep(BEEP_KEY);                         /* ★ C11：静音时不出这一声 */
#endif
}

/*-------------------------------------------------------------------------
 * av_gate_hold —— **超声波**"太近"（< 5cm）触发
 *   手动 -> 刹停 + 锁存；寻光 -> 退回手动模式（R7：把控制权交还给人）
 *   ★ 车头红外**不走这里**，它走 ir_brake（只刹车、不改模式）。
 *-------------------------------------------------------------------------*/
static void av_gate_hold(void)
{
    if (avst == AV_HUMAN)
        return;                             /* 遥控已接管，不再反复刹停 */

    if (mode == MODE_LIGHT) {
        /* 寻光是自主模式，过近时应该把控制权**交还给人**，而不是原地锁死。
         * 用 AV_HUMAN（不是 AV_HOLD）正是关键：它不锁存、不间歇响，
         * 而且距离回到安全值后闸门会自动把它变回 AV_FREE（避障重新武装）。 */
        mode = MODE_MANUAL;
        avst = AV_HUMAN;
        cur_act = ACT_STOP;
        motor_set(ACT_STOP, 0);
        show_mode();
        beep(BEEP_KEY);                     /* 寻光：退回手动，响一声（语义不同，照旧）*/
        return;
    }

    /* ---- 手动：刹停 + 锁存 ---- */
    avst = AV_HOLD;
    cur_act = ACT_STOP;
    motor_set(ACT_STOP, 0);
    show_mode();

    av_beep_t = tick_get();                 /* 之后由 av_gate 按间隔继续响 */
    /* ★ C13（+修订）：**声音只在"新一次遭遇"时出**。
     *   读数抖动会让 `avst` 反复 AV_FREE -> 再锁存；若每次入口都出声，
     *   听起来就是"隔一会儿又响"。所以已经提醒过的这一次，**一声都不出**。
     *   （`av_beep_n` 只在障碍持续退远后才被清零，见 av_gate 的锁存分支。） */
    if (av_beep_n == 0) {
        av_beep_n = 1;                      /* 这声算第 1 声 */
        beepwhy('H');                       /* ★ 诊断：刹停入口那一声 */
        beep(BEEP_KEY);                     /* 响一声：手动 = 刹停锁存 */
    }
}

#if DEBUG_UART
/* 避障诊断（只在 -Debug 诊断版里编入）
 *   av_gate 每趟检查状态，**有变化**或**每 0.5s** 打一行，用来分清：
 *   是车头红外在刹、还是超声波没量到、还是开关被关了。
 *   格式：! IR=0 AV=1 D=08 OF=1 M=0
 *     IR = 车头红外是否检测到（0/1）
 *     AV = 闸门状态 0=FREE 1=TURN 2=HOLD 3=HUMAN
 *     D  = 最近一次超声波实测（单位 tick ≈1.72cm；FF = 读不到/够远）
 *     OF = 超声波开关（0/1）      M = 模式 0=手动 1=寻光 2=循迹
 *   ⚠️ 打印会占用串口时间，只在排查时烧这个版本。 */
static unsigned char av_dbg_seen;
static unsigned char av_dbg_ir, av_dbg_st, av_dbg_d, av_dbg_of, av_dbg_md;
static unsigned int  av_dbg_t;
#endif

static void av_gate(void)
{
    unsigned char d;

#if DEBUG_UART
    {
        unsigned char ir = ir_det() ? 1 : 0;
        if (!av_dbg_seen || ir != av_dbg_ir || avst != av_dbg_st ||
            (avoid_off() ? 0 : 1) != av_dbg_of || mode != av_dbg_md ||
            (unsigned int)(tick_get() - av_dbg_t) >= 5000) {    /* 5000 tick ≈ 0.5s */
            av_dbg_t  = tick_get();
            av_dbg_seen = 1;
            av_dbg_ir = ir;
            av_dbg_st = avst;
            av_dbg_of = avoid_off() ? 0 : 1;
            av_dbg_md = mode;
            prt_str("\r\n! IR="); put_char((char)('0' + ir));
            prt_str(" AV=");      put_char((char)('0' + avst));
            prt_str(" D=");       prt_hex(av_dbg_d);
            prt_str(" OF=");      put_char((char)('0' + (avoid_off() ? 0 : 1)));
            prt_str(" M=");       put_char((char)('0' + mode));
            prt_str(" T=");       prt_hex4(ms10_get());   /* ★ 开机计时：突然变小 = 复位过 */
        }
    }
#endif

    /* ---- ★ C14：**避障"不参与"时必须把旧锁存解开** ----
     *   录制期间（以及用户关掉开关时）超声波这一路不参与，
     *   但若 `avst` 还停在 `AV_HOLD`，`motor_set()` 会**一直把车按住** ⇒
     *   表现就是"一进录制车就走不动"。所以在这里就清掉。
     *   ⚠️ 车头红外**不受影响**：紧接着的 `ir_det()` 会重新刹停（C2/C3 冻结语义）。 */
    if (avoid_off() && avst == AV_HOLD)
        avst = AV_FREE;

    /* ---- 锁存态**必须放在最前面** ----
     * 否则"红外每趟都检测到 -> 每趟都调 ir_brake"会变成**连续鸣叫**，
     * 而不是设计要的"每 ≈0.7s 一声"。锁存期间这里只管"要不要继续响"。
     * ★ C11：**车头红外不再出声** —— 只要红外"贴着"，这里就静音
     *   （不管是它触发的锁存，还是超声波先锁存、之后红外又贴上）。 */
    if (avst == AV_HOLD) {
#if IR_BEEP_SILENT
        if (ir_det())
            return;                         /* ★ 红外贴着 -> 静音（C11）*/
#endif
        /* ---- 到这里：红外没贴着（或 IR_BEEP_SILENT=0）---- */

        /* ① 超声波不参与的情形 -> 没有该响的理由 */
        if (avoid_off() || mode == MODE_TRACK)
            return;

        /* ② 障碍退远了 -> **要持续 AV_CLEAR_TICKS 才算真走了**（C13 修订的滞回）*/
        if (us_read() >= US_CLEAR) {
            if (!av_clear_on) {             /* 刚开始"退远"计时 */
                av_clear_on = 1;
                av_clear_t = tick_get();
                return;
            }
            if ((unsigned int)(tick_get() - av_clear_t) >= AV_CLEAR_TICKS)
                av_beep_n = 0;              /* 真走了 -> 下次再靠近才会重新提醒 */
            return;                         /* 退到安全距离 -> 静音 */
        }
        av_clear_on = 0;                    /* 又近了 -> 撤销"已退远"的计时 */

        /* ③ 提醒音：**一次遭遇总共 AVBEEP_N 声**（含刹停那一声）*/
        if (av_beep_n >= AVBEEP_N)
            return;                         /* ★ C13：提醒够了 -> 安静（**锁存不变**，
                                             *   车仍然停着，按遥控才接管）*/
        if ((unsigned int)(tick_get() - av_beep_t) >= AVBEEP_TICKS) {
            av_beep_t = tick_get();
            av_beep_n++;                    /* ★ C13：记数，响够 AVBEEP_N 声就停 */
            beepwhy('L');                   /* ★ 诊断：锁存期间的间歇提醒 */
            beep(BEEP_KEY);
        }
        return;
        /* ⚠️ 只停响，车仍然停着等遥控 —— 锁存不解除。 */
    }

    /* ---- ① 车头红外：**全局**（手动 / 寻光 / 循迹 都生效），触发即刹车 ----
     * ★★ 放在这里、而且在"循迹早退"**之前** —— 循迹也受它保护。
     * ★ 走**独立的刹车路径**，绝不进"改写成原地右转"那套避让逻辑。 */
    if (ir_det()) {
        ir_brake();
        return;
    }

    /* ---- ② 循迹模式：**不参与超声波避障** ----
     * 必须显式清 avst：否则它会卡在 AV_TURN，motor_set 会把循迹的每一个动作
     * 都改写成"右转" -> 车一直原地转，循迹彻底废掉。
     * ⚠️ 注意循迹**不是"没有避障"**，而是"**只有红外刹车**、没有超声波避让" ——
     *    红外已经在上面处理过了。 */
    if (mode == MODE_TRACK) {
        avst = AV_FREE;
        return;
    }

    /* ---- ★ A：**倒车时不参与前向超声波避让** ----
     * 超声波只朝前 ⇒ 倒车时它的读数对"车在往后走"没有意义：
     *   若仍按近区改写成"原地右转"，表现就是"倒着倒着突然原地打转"；
     *   若仍按 <5cm 刹停锁存，连"倒车离开前方障碍"这种安全动作都会被拦下。
     * 所以倒车时让超声波这一路**直接放行**（与循迹下"超声波不参与"同一套思路）；
     * 倒车的安全由"限速 + 限时"兜（见 motor_set 与 back_guard）。
     * ⚠️ 车头红外在上面已经处理过，**仍是全局、关不掉的**（C2/C3 冻结语义）。 */
    if (cur_act == ACT_BACK) {
        avst = AV_FREE;
        motor_set(ACT_BACK, gear);          /* 把可能残留的"原地右转"改写回来 */
        return;
    }

    /* ---- ③ 超声波：受手动开关控制（长按 S4 / 遥控数字键 5）
     *      ★ C14：**录制中一律不参与**（`avoid_off()` 为真）---- */
    if (avoid_off()) {
        avst = AV_FREE;
        if (cur_act != 0) motor_set(cur_act, gear);
        return;
    }

    d = us_read();
#if DEBUG_UART
    av_dbg_d = d;                           /* 诊断：记下这次实测的距离 */
#endif
    if (d < US_STOP) {                      /* 太近（< 5cm）*/
        av_gate_hold();
        return;
    }

    /* ---- >= US_STOP：已脱离"太近"档，解除"遥控接管"态，避障重新武装 ---- */
    avst = AV_FREE;

    if (d < US_NEAR) {                      /* 近区：原地右转避让 */
        avst = AV_TURN;
        if (cur_act == 0) return;           /* 本来就没在动 -> 别自己窜出去 */
        motor_set(ACT_RIGHT, gear);
        return;
    }

    /* ---- 够远：放行，并把原动作重新套上（否则会一直右转下去）---- */
    if (cur_act == 0) return;
    motor_set(cur_act, gear);
}

/*=========================================================================
 * 三十一、**超声波**避障开关（板载长按 S4 / 遥控数字键 5）
 *   开 -> 响两声；关 -> 响一声长的。
 *   ★ 只管超声波：车头红外是**全局**的，关不掉（见 av_gate 的说明）。
 *   ★ 关的时候顺手把**锁存解掉** —— 否则 AV_HOLD 会一直卡着、车永远不动，
 *     "救急：关掉避障就能恢复"这条就失效了。
 *     ⚠️ 若此刻车头红外还贴着东西，下一趟 av_gate 会**立刻重新刹停** ——
 *        这正是"红外全局常开"该有的样子：**超声波能关，红外关不掉**。
 * =========================================================================*/
static void avoid_toggle(void)
{
    us_avoid_on = !us_avoid_on;
    beepwhy('T');                           /* ★ 诊断：避障开关被触发 */

    if (us_avoid_on) {
        beep(BEEP_KEY);                     /* 开：两声短响 */
        d_20ms();
        d_20ms();
        beep(BEEP_KEY);
    } else {
        avst = AV_FREE;                     /* 关：解开锁存（理由见上面）*/
        beep(BEEP_TICKS);                   /*     一声长响 */
    }

    /* ★ C10：**立刻**刷新 D3（亮 = 开 / 灭 = 关）。
     *   不刷的话，车静止时没有别的地方写 P2，D3 会一直停在旧状态上。 */
    show_mode();
}

/*=========================================================================
 * 三十二、量电平持续时间（红外解码的核心）
 *   入：ml_level = 0 量低电平（等它变高）；1 量高电平（等它变低）
 *       ml_cap   = 限时 tick 数；0 = 默认限时 25.6ms
 *   出：1 = 到限时还没变化（超时）；0 = 已经变化
 *       ml_dur = 量到的时长
 *
 *   ★★ 这是整个 C 版**对时序最敏感**的地方，两条纪律：
 *      1) 时基读取必须**内联**在这里，不能调 tick_get()：
 *         函数调用会把每一圈的耗时从几十个机器周期抬到上百个，
 *         而红外最短的脉宽只有 0.56ms，循环太慢会整圈跳过一次电平变化。
 *      2) 循环体里只做"读数 + 比较 + 判电平"，不要加任何别的东西。
 *   实测门限很宽（位判据 1.1ms 落在 0.56 / 1.69ms 中间），
 *   所以即使每圈有几十微秒的量化误差也完全够用。
 * =========================================================================*/
static bit meas_level(void)
{
    unsigned int t0;
    unsigned int d;
    unsigned char hi, lo;

    ET0 = 0;                                /* 起始时刻：内联原子读 */
    hi = tick_h;
    lo = tick_l;
    ET0 = 1;
    /* ★ C13 修订：原来这里是 `ml_start = ...; t0 = ml_start;`（存了又立刻读），
     *   那个全局已删掉为 DATA 段腾地方，直接赋给 t0 完全等价。 */
    t0 = ((unsigned int)hi << 8) | lo;

    for (;;) {
        ET0 = 0;                            /* 当前时刻：内联原子读 */
        hi = tick_h;
        lo = tick_l;
        ET0 = 1;
        d = (unsigned int)((((unsigned int)hi << 8) | lo) - t0);

        if (ml_cap) {                       /* 有明确限时：到点就算超时 */
            if (d >= ml_cap) {
                ml_dur = d;
                return 1;
            }
        } else {                            /* 没有限时：超过 25.6ms 就算超时 */
            if (d > 255) {
                ml_dur = d;
                return 1;
            }
        }

        if (ml_level) {                     /* 量高 -> 等它变低 */
            if (!IR_IN) {
                ml_dur = d;
                return 0;
            }
        } else {                            /* 量低 -> 等它变高 */
            if (IR_IN) {
                ml_dur = d;
                return 0;
            }
        }
    }
}

/*=========================================================================
 * 三十三、红外 NEC 解码
 *   0038 接收头输出：空闲高，收到 38kHz 载波为低。
 *
 *   完整帧 = 9ms 低（引导码） + 4.5ms 高 + 32 位数据
 *            每位 = 0.56ms 低 + 高电平（0.56ms = 位0，1.69ms = 位1），低位在前
 *            32 位 = 地址 + 地址取反 + 命令 + 命令取反（取反用来校验）
 *   重复帧 = 9ms 低 + 2.25ms 高，之后不再变低（表示"这个键还按着"）
 *
 *   出口 irstat：0 = 完整帧（键值在 ir_ib2）
 *                1 = 连下降沿都没等到（静默）
 *                2 = 见到边沿但没解成 NEC 帧
 *                3 = 重复帧（只表示"还按着"）
 *
 *   ⚠️ 这颗遥控器的"完整帧"引导码高电平实测偏短（1.2~2.5ms），
 *      与标准 NEC 的 4.5ms 不同，也和"重复帧"的 2.25ms 重叠。
 *      所以不能靠引导码高电平直接判重复帧，只能**打个标记继续解**：
 *      解出 32 位合法数据 = 完整帧，解不出来才算重复帧。
 * =========================================================================*/

/* 清掉一次接收的中间状态 */
static void ir_reset(void)
{
    ml_cap = 0;
    ir_ledlo = 0;
    ir_ledhi = 0;
    ir_short = 0;
    irstat = 1;                             /* 先当"连下降沿都没等到" */
}

/* 把当前位（1）写进 ir_ib0..ir_ib3 */
static void ir_setbit(unsigned char idx)
{
    switch (idx) {
    case 0:  ir_ib0 |= ir_maskb; break;
    case 1:  ir_ib1 |= ir_maskb; break;
    case 2:  ir_ib2 |= ir_maskb; break;
    default: ir_ib3 |= ir_maskb; break;
    }
}

/* 收 32 位数据并校验；出：1 = 得到合法完整帧 */
static bit ir_decode_bits(void)
{
    ir_ib0 = 0;
    ir_ib1 = 0;
    ir_ib2 = 0;
    ir_ib3 = 0;
    ir_bits = 32;
    ir_ptridx = 0;
    ir_maskb = 0x01;

    while (ir_bits) {
        /* ---- 每位先一段低电平（约 0.56ms），必须结束 ---- */
        ml_level = 0;
        ml_cap = 0;
        if (meas_level())
            return 0;

        /* ---- 再一段高电平：0.56ms = 位0，1.69ms = 位1 ---- */
        ml_level = 1;
        if (ir_bits == 1) {
            /* 最后一位后面是空闲高电平，不能等它变低：
             * 只量到 1.2ms 就下结论，到点还高着 = 位1 */
            ml_cap = IR_BITCAP;
            if (meas_level())
                ir_setbit(ir_ptridx);
        } else {
            ml_cap = 0;
            if (meas_level())
                return 0;
            if (ml_dur >= IR_BIT_TH)
                ir_setbit(ir_ptridx);
        }

        /* ---- 每收一位（含 0 位）都推进掩码 ---- */
        ir_maskb <<= 1;
        if (ir_maskb == 0) {
            ir_maskb = 0x01;
            ir_ptridx++;
        }
        ir_bits--;
    }

    /* ---- 校验：地址与地址取反、命令与命令取反必须互补 ---- */
    if ((unsigned char)~ir_ib0 != ir_ib1) return 0;
    if ((unsigned char)~ir_ib2 != ir_ib3) return 0;
    return 1;
}

/* 从"已经看到下降沿"开始解码，直到出结果 */
static void ir_decode(void)
{
    /* ---- 1) 引导码低电平，标称 9ms ---- */
    ml_level = 0;
    ml_cap = 0;
    if (meas_level()) {                     /* 低电平一直不结束 */
        irstat = 2;
        return;
    }
    ir_ledlo = (unsigned char)ml_dur;       /* 先存下来：不合格时诊断要用 */
    if (ml_dur > 255) {                     /* 超过 25.6ms -> 不是 NEC */
        irstat = 2;
        return;
    }
    if (ml_dur < IR_LEAD_MIN || ml_dur > IR_LEAD_MAX) {
        irstat = 2;
        return;
    }

    /* ---- 2) 引导码高电平：靠"会不会变低"区分完整帧和重复帧 ----
     * 完整帧后面紧接第 1 位的低电平 -> 会变低；
     * 重复帧之后是空闲高电平 -> 不会再变低。
     * 所以量到 6ms 就收手：提前变低 = 完整帧，到点还高 = 重复帧。
     * ⚠️ 不能像量低电平那样死等它变低：重复帧要等到下一帧才变低，
     *    死等必然超时 -> 被当成解码失败 -> "松键停车"永远刷不到时刻。 */
    ml_level = 1;
    ml_cap = IR_LEADHCAP;
    if (meas_level()) {                     /* 6ms 还高着 -> 重复帧 */
        ir_ledhi = (unsigned char)ml_dur;
        irstat = 3;
        return;
    }
    ir_ledhi = (unsigned char)ml_dur;
    if (ml_dur > 255) {
        irstat = 3;
        return;
    }
    if (ml_dur < IR_REP_MIN) {              /* < 1.2ms -> 噪声，不是引导码 */
        irstat = 2;
        return;
    }
    if (ml_dur < IR_LEADH_MIN)
        ir_short = 1;                       /* 1.2~2.5ms：待定，看 32 位解不解得出来 */

    /* ---- 3) 收 32 位 ---- */
    if (ir_decode_bits()) {
        irstat = 0;                         /* 完整帧，键值在 ir_ib2 */
        return;
    }

    /* ---- 32 位没解出来：区分"短引导码的帧解失败"和"重复帧" ---- */
    irstat = ir_short ? 3 : 2;
}

/*=========================================================================
 * 三十四、收一帧（阻塞版，手动模式用）
 *   等下降沿最长 25.6ms —— 这期间按键不响应，但 25ms 量级的延迟对手感没有影响，
 *   而"一直在听红外"是必须的：否则会从引导码中间才开始量，脉宽偏短、整帧被拒。
 * =========================================================================*/
static void ir_recv(void)
{
    unsigned int t0;

    ir_reset();

    /* ---- 等 IR_IN 下降沿 ---- */
    t0 = tick_get();
    while (IR_IN) {
        if ((unsigned int)(tick_get() - t0) > 255)
            return;                         /* 超过 25.6ms 还没边沿 -> 真没信号，保持 irstat=1 */
    }

    ir_decode();
}

/*=========================================================================
 * 三十五、收一帧（非阻塞版，回放专用）
 *   与 ir_recv 的唯一区别：把"阻塞等下降沿"换成**一次判断**，其余解码流程完全相同。
 *   ★ 可行性：引导码低电平有 9ms 宽，而回放主循环约 1~3ms ->
 *     最多晚 3ms 才进解码，量到的引导码低电平约 6~9ms，仍在 7~12ms 的窗口内。
 *   ★ 回放期间主循环不能有 25ms 级的阻塞，否则动作切换抖动会超过 ±5% 要求。
 * =========================================================================*/
static void ir_recv_nb(void)
{
    ir_reset();
    if (IR_IN)
        return;                             /* 空闲高 -> 没有帧，立刻返回 */
    ir_decode();
}

/* 把"最后一次收到红外帧的时刻"更新为现在 */
static void stamp_now(void)
{
    lastt = tick_get();
}

/* "见到边沿但没解成 NEC"时打一行实测脉宽（限流，避免刷屏）
 * 判读：NEC 应该 lo≈90、hi≈45（重复帧 hi≈22），单位 100us */
static void ir_errpr(void)
{
#if DEBUG_UART
    if ((unsigned int)(tick_get() - last_err) < ERRTMO_TICKS)
        return;
    last_err = tick_get();
    prt_str("\r\n! IR rej lo=");
    prt_hex(ir_ledlo);
    prt_str(" hi=");
    prt_hex(ir_ledhi);
    prt_str(" a=");
    prt_hex(ir_ib0);
    prt_str(" b=");
    prt_hex(ir_ib1);
    prt_str(" c=");
    prt_hex(ir_ib2);
    prt_str(" d=");
    prt_hex(ir_ib3);
#endif
}

/*=========================================================================
 * 三十六、处理一个"新键"
 *   顺序很重要，见每一步的说明。
 * =========================================================================*/
static void do_key(void)
{
    unsigned char tgt, act;

    /* ---- ① 遥控一按，决定权就交回给人 ----
     * 若闸门正处在"太近刹停"锁存态，就地解除（-> AV_HUMAN）。
     * 放在最前面，所以**任意**遥控键都算"人来接管"。
     * 之后闸门放行（不刹停、也不改写成右转），直到距离回到安全值才自动回 AV_FREE。 */
    if (avst == AV_HOLD)
        avst = AV_HUMAN;

    /* ---- ② 三个功能键优先处理，且不再往下走常规流程 ----
     *（不进 key2mode、不进 key2act，所以不会驱动电机，也不会被当成"不认识的键"）*/
    if (ir_ib2 == KEY_REC)  { rec_key();  return; }
    if (ir_ib2 == KEY_CLR)  { clr_key();  return; }
    if (ir_ib2 == KEY_PLAY) { play_key(); return; }

    prt_key();                              /* 打印原始键值（测其余键值就靠这一行）*/

    /* ---- ★ 遥控数字键 5 = **超声波**避障开关（与"长按 S4"同一个功能）----
     * 放在 prt_key() **之后**，所以诊断版能打出 `K=1C` —— 排查"按 5 没反应"就靠它。
     * ★ 这里**不设录制守卫**：录制中也可以开关避障。
     *   理由：录制记的是"人的操作意图"（动作 + 档位），避障状态根本不进记录，
     *   所以开关它不会污染记录；而"长按 S4"本来在录制中也照样生效，两边行为要一致。
     * ⚠️ 回放中按 5 不生效（回放走 play_step，只认停止/方向/回放键）——
     *   这是**故意**的：回放安全不归 AVOIDON 管（回放压根不进避障闸门），
     *   免得"以为关掉了避障"结果回放的安全行为没变、反而更迷惑。 */
    if (ir_ib2 == KEY_AVOID) {
        avoid_toggle();
        return;
    }

    /* ---- ③ 遥控数字键 1/2/3 直接选模式 ---- */
    tgt = key2mode(ir_ib2);
    if (tgt != 0xFF) {
        if (recon) {
            /* 录制中禁止切模式：录制中切到寻光/循迹这类自主模式没有合理语义
             * （它们不能被"示教"），而且模式动作会改写 cur_act -> 记录直接被污染。
             * 拒绝并响两声（与"进入录制"的一声区分：这里数码管不会变）。 */
            beep(BEEP_KEY);
            d_20ms();
            beep(BEEP_KEY);
            return;
        }
        if (tgt == mode) {                  /* 已经就是这个模式 -> 只响一声，不做动作 */
            beep(BEEP_KEY);
            return;
        }
        mode_goto(tgt);
        return;
    }

    /* ---- ④ 遥控加/减档（全局功能：任何模式下都生效）---- */
    if (ir_ib2 == KEY_SPD_UP) {
        if (gear >= MAXGEAR)
            return;
        gear++;
    } else if (ir_ib2 == KEY_SPD_DN) {
        if (gear == 0)
            return;
        gear--;
    } else {
        /* ---- ⑤ 方向键 / 停止键 -> 动作 ----
         * ★ 这里**不做"同键去重"**：同一个键的第二次真按键必须照常生效，
         *   否则加减档只能调一次、模式键连按失效。
         *   按住不放时遥控器发的是重复帧（irstat=3），根本到不了这里，
         *   所以能进来的必定是"完整的、刚按下去的"帧。 */
        act = key2act(ir_ib2);

        if (act == ACT_NONE) {              /* 不认识的键：只打印，不动电机 */
            prt_str(" UNKNOWN KEY (no motor change)");
            return;
        }

        if (act == ACT_STOP) {              /* 停止键：最高优先级 */
            cur_act = ACT_STOP;
            motor_set(ACT_STOP, 0);
        } else {
            if (gear == 0)
                gear = GEAR_DEFAULT;        /* 0 档按方向键 -> 自动跳默认档，否则车不动 */
            cur_act = act;
            motor_set(act, gear);
        }

        show_state();                       /* 显示档位，D3 亮 = 正在动 */
        prt_actname();
        beep(BEEP_KEY);                     /* 响一声（不用看串口也知道收到了）*/
        return;
    }

    /* ---- 加/减档的收尾：正在动就用新档位重新套用当前动作 ---- */
    if (cur_act != 0)
        motor_set(cur_act, gear);
    show_state();
    beep(BEEP_KEY);
    prt_gear();
}

/*=========================================================================
 * 三十七、松键停车
 *   最后一次收到红外帧后 300ms 内没有新帧 -> 视为松手。
 *   ★ 例外（用户要求）：**前进是"锁定式"** —— 按一下就一直走，
 *     直到按「停止」或按别的方向键。后退/左转/右转/弧线都是"按住才走"。
 *   ★ 例外之例外①：处于 AV_HUMAN（刚被刹停、遥控已接管、还没脱离危险区）时，
 *     前进也回到"按住才走"，更安全。这个接管态**只用一次**：
 *     本次动作结束时收回 AV_FREE，让避障重新武装。
 *     （否则只要前方读数一直很近，前进会永久变成"按住才走"而且不响。）
 *   ★★ 例外之例外②（C15，2026-09-21 用户需求）：**录制中前进也是"按住才走"**。
 *     理由：录制是"人在教"，松手立停才好控制、录进去的时长就等于人按住的时长；
 *     而且录制时避障已经被 C14 屏蔽掉了，**再让车"锁定式"一直往前跑很危险**。
 *     配套：**弧线松手也停**（"回前进"这个动作本来是为了配合锁定式前进的，
 *     录制中前进既然变成按住才走，弧线松手就没有"回到前进"可回了）。
 * =========================================================================*/
static void ir_holdchk(void)
{
    unsigned int d;

    if (cur_act == ACT_STOP)
        return;                             /* 本来就在停 -> 不用管 */

    if (avst != AV_HUMAN && !recon) {       /* ★ C15：录制中不做"前进锁定式" */
        if (cur_act == ACT_FORWARD)
            return;                         /* 前进：锁定式，不因松手停车 */
    }

    d = (unsigned int)(tick_get() - lastt);
    if (d < HOLD_TMO_TICKS)
        return;                             /* 还没到 300ms */

    /* 超时 = 松手了。弧线松手 -> 回到前进（前进本来是锁定式，弧线只是临时叠加）；
     * 其余动作照旧 -> 停车。
     * ★ C15：**录制中例外** —— 录制时前进是"按住才走"，所以弧线松手**直接停**，
     *   不能"回到前进"（那等于没人按键车还在跑）。 */
    if (!recon && (cur_act == ACT_ARC_L || cur_act == ACT_ARC_R))
        cur_act = ACT_FORWARD;
    else
        cur_act = ACT_STOP;

    motor_set(cur_act, cur_act == ACT_STOP ? 0 : gear);
    show_state();                           /* 显示也要跟着更新，否则 D3 还亮着"在动" */
    lastcmd = LASTCMD_NONE;                 /* 允许同一个键再按一次 */

    if (avst == AV_HUMAN)
        avst = AV_FREE;                     /* 接管只用一次 -> 避障重新武装 */
    prt_release();
}

/*=========================================================================
 * ★ A（2026-09-21 用户需求）：back_guard —— **倒车限时**
 *   手动/录制中，**连续倒车超过 BACK_TMO_TICKS 就自动停车**并响两声提示。
 *   为什么要有它：倒车时超声波和车头红外都在车头、看不到车后，软件帮不上忙，
 *   所以只能"不让它一直倒下去"—— **必须人看着**，这条是兜底。
 *   要继续倒：**松开后退键再按一次**（重复帧不会重启，与 R10"按住才走"一致）。
 *   ★ 只在**手动模式**里生效：回放要**忠实复现**录下来的动作，不能被这里截断
 *     （回放的安全是"遇障立即停车终止"）。
 *   ★ 计时用系统时基，不用空循环（本工程铁律）。
 * =========================================================================*/
static void back_guard(void)
{
    if (mode != MODE_MANUAL)                /* 回放/自主模式不改写 */
        return;

    if (cur_act != ACT_BACK) {              /* 没在倒车 -> 复位计时 */
        back_on = 0;
        return;
    }

    if (!back_on) {                         /* 刚开始倒车：记下时刻 */
        back_on = 1;
        back_t0 = tick_get();
        return;
    }

    if ((unsigned int)(tick_get() - back_t0) < BACK_TMO_TICKS)
        return;                             /* 还没到时限 */

    /* ---- 到时限：停车 + 两声（与其它提示音区分）---- */
    back_on = 0;
    cur_act = ACT_STOP;
    motor_set(ACT_STOP, 0);
    show_state();
    beepwhy('B');                           /* ★ 诊断：倒车限时自停 */
    beep(BEEP_KEY);
    d_20ms();
    beep(BEEP_KEY);
}

/*=========================================================================
 * ★ C9（2026-09-21 用户需求）：prox_beep —— **超声近距提示音（"倒车雷达"）**
 *   只有在**超声波避障关闭**（`us_avoid_on == 0`）时才响：
 *   避障关掉之后车不会自己刹了，这时用"**叫得越来越急**"把距离交给人判断。
 *   ★ 门限**复用避障那一套常数**，不引入新的距离阈值：
 *       d >= US_NEAR(12 ≈ 21cm) 或读不到  -> **不响**
 *       US_STOP(3) <= d < US_NEAR        -> **间歇响**，越近间隔越短
 *                                            （d=3 ≈5cm ≈100ms；d=11 ≈19cm ≈510ms）
 *       d <  US_STOP(3 ≈ 5cm)            -> **连续响**（最急 = "贴上了"）
 *   ★ 四条刻意约定（为了"不吵、不干扰别的功能"）：
 *     1) **手动 / 寻光**里生效，**循迹不参与**（与 C3"超声波不参与循迹"一致）；
 *     2) **回放不参与**（回放的安全是 T7"遇障立即停车终止"，不掺提示音）；
 *     3) 与避障**互斥**：避障开着时它不响（那时由避障自己的刹停/间歇响负责）；
 *     4) ★ **C12：倒车时不响** —— 倒车已有 C8 的"限速 2 档 + 3 s 自停"兜底，
 *        而且是"按住才走"、人就在旁边盯着，再按距离叫只是噪音。
 *   ★★ 2026-09-21 行为**定稿**（用户两轮反馈后的结论）：
 *      **停车后再响 `PROX_HOLD_TICKS`（2.0s）就自动静音**。
 *      演变过程：初版"只在动时响"（被否：停着听不出来）→
 *      改成"停着也一直响"（太吵）→ **定稿"停下继续响 2s 然后静音"**，
 *      即真·倒车雷达的做法：停下的瞬间还能听出离墙多远，响完就安静。
 *      另外**最近档（<5cm）在"停着"时不用长鸣**，改用最急的间歇（≈100ms），
 *      否则停在墙前那 2 秒会是一声长叫。
 *   ★ 非阻塞：只置 `beep()` 的计数，真正发声由 Timer0 中断做。
 * =========================================================================*/
#define PROX_INT_MIN   1000     /* 最近间歇档的间隔：1000 tick ≈ 100ms */
#define PROX_INT_SH    9        /* 每远 1 tick，间隔 + 2^9 = 512 tick ≈ 51ms */
#define PROX_SOLID     200      /* "连续响"每次续上的半周期数（200 ≈ 100ms > 主循环周期）*/
#define PROX_HOLD_TICKS 20000   /* ★ 停车后**继续提示** 2.0s（20000 × 99.83us ≈ 2.0s），
                                 *   响完自动静音 —— 真·倒车雷达的做法 */

static void prox_beep(void)
{
    unsigned int d, wait;

    if (avoid_off() == 0)                   /* 避障在参与 -> 不响（避障自己负责）*/
        return;                             /* ★ C14：录制中也算"不参与" -> 提示音响 */
    if (mode == MODE_PLAY || mode == MODE_TRACK)
        return;

    /* ---- ★ C12（2026-09-21 用户需求）：**倒车时不响** ----
     *   顺手把 `prox_moving` 清掉 ⇒ **也不从"倒车"起算"停车后 2s"那段宽限**
     *   （否则"倒车→停下"还会再响 2s，等于白禁了）。 */
    if (cur_act == ACT_BACK) {
        prox_moving = 0;
        prox_hold = 0;                      /* 倒车不算"停车宽限" */
        return;
    }

    /* ---- ★ 停车后只再响 2.0s（真·倒车雷达）：停下的瞬间还能听出离墙多远 ----
     * ★★ C13 修订2（**2026-09-21 靠串口实测定位的真凶**）：
     *   原来这里写的是 `if ((tick_get() - prox_stop_t) >= PROX_HOLD_TICKS) return;`
     *   而 **`tick_get()` 是 16 位、每 65536 × 99.83us ≈ 6.55s 就绕回一次**！
     *   绕回之后 `(now - prox_stop_t)` 又变成小值 ⇒ 判断重新认为"刚停下、还在宽限内"
     *   ⇒ **停着的车每 6.5s 左右白白响 2 秒，永远如此**
     *   （现场表现就是用户报的"停着的时候时不时响一下"）。
     *   改法：用**一次性标志** `prox_hold` —— 宽限到点就**永久置 0**，
     *   直到车"再次动起来"才撤销。这样绕回最多让宽限**提前结束**（无害），
     *   **绝不会**让它重新开始。
     *   ⚠️ 同类的 `(tick_get() - t0) >= 门限` 在 ir_holdchk / ir_recv 里也有，
     *      但那些只会让超时**晚一点**、不会误触发，所以不用改。 */
    if (cur_act == ACT_STOP) {
        if (prox_moving) {                  /* 刚从"动"变成"停"：开始 2s 宽限 */
            prox_moving = 0;
            prox_hold = 1;
            prox_stop_t = tick_get();
        }
        if (prox_hold && (unsigned int)(tick_get() - prox_stop_t) >= PROX_HOLD_TICKS)
            prox_hold = 0;                  /* 宽限到点 -> 永久静音 */
        if (!prox_hold)
            return;                         /* ★ 停稳超过 2s -> 一声都不响 */
    } else {
        prox_moving = 1;
        prox_hold = 0;                      /* 又动了 -> 撤销静音（重新武装）*/
    }

    d = us_read();                          /* 非阻塞；内部已做 ≥60ms 节流 */
    if (d >= US_NEAR)                       /* 够远 / 读不到(US_FAR) -> 不响 */
        return;

    if (d < US_STOP && cur_act != ACT_STOP) {   /* 最近档 **且正在动** -> 连续响 */
        beepwhy('P');                       /* ★ 诊断：近距连续响 */
        beep(PROX_SOLID);
        return;
    }

    /* 间歇响：越近间隔越短。
     * ★ 用**移位**、不要用乘法：C51 的 `*` 会引出库函数 `?C?IMUL`，
     *   而本工程的自制链接器**硬拒** `EXTRN CODE`（见 c51_link.py 的检查）——
     *   这与 prt_gear 里"用加法代替 ×5"是同一个原因。
     * ★ 车停着时最近档**不用长鸣**，改用最急的间歇（≈100ms），
     *   否则停在墙前会一直尖叫；但**停着照样响**（2026-09-21 用户要求）。 */
    if (d < US_STOP)
        wait = PROX_INT_MIN;
    else
        wait = PROX_INT_MIN + ((unsigned int)(d - US_STOP) << PROX_INT_SH);
    if ((unsigned int)(tick_get() - prox_t) < wait)
        return;
    prox_t = tick_get();
    beepwhy('Q');                           /* ★ 诊断：近距间歇响 */
    beep(BEEP_KEY);
}

/*=========================================================================
 * 三十八、录制
 *   录制 = **叠加在手动模式上的一个标志**（recon），不是模式 ——
 *   因为录制时遥控键仍然要驱动电机（人得把车"开"给车看）。
 *
 *   记什么：每 10ms 采一次 (当前动作, 当前档位)，记的是"**操作意图**"。
 *   所以避障把动作改写成"原地右转"时，记录里仍是人的原动作。
 *   ⇒ 演示示教时请保持前方畅通：录制时车会绕障，但回放时不会（回放遇障是停车终止）。
 * =========================================================================*/

/* 立刻停车 */
static void rec_halt(void)
{
    cur_act = ACT_STOP;
    motor_set(ACT_STOP, 0);
}

/* 把 (pack, cur_dur) 写入第 recn 条记录
 * 出：1 = 写入成功；0 = 已满（未写入）
 * ★ 前导停止不记录：一条都还没录到时，动作 = STOP 的片段直接丢弃
 *   （省记录、演示干净）。已经有记录之后 STOP 也要记，因为序列里需要"停止"。 */
static bit rec_commit(void)
{
    unsigned int addr;

    if ((pack & ACTPK_MASK) == 0 && recn == 0) {
        cur_dur = 0;                        /* 前导 STOP -> 丢弃 */
        return 1;
    }

    if (recn >= REC_MAX) {
        recfull = 1;                        /* 已满 80 条 */
        return 0;
    }

    addr = REC_ADDR(recn);
    XBYTE[REC_BASE + addr]     = pack;      /* Byte0 = (动作<<4)|档位 */
    XBYTE[REC_BASE + addr + 1] = (unsigned char)cur_dur;          /* 时长低 */
    XBYTE[REC_BASE + addr + 2] = (unsigned char)(cur_dur >> 8);   /* 时长高 */

    recn++;
    if (recn >= REC_MAX)
        recfull = 1;

    cur_dur = 0;
    return 1;
}

/* 空记录 / 非法操作提示：闪 'E' + 两声短响，然后恢复显示 */
static void rec_err(void)
{
    P2 = d3_mix(DISP_E);
    beep(BEEP_KEY);
    d_20ms();
    d_20ms();
    beep(BEEP_KEY);
    d_20ms();
    d_20ms();
    show_state();
}

/* 录满 80 条：自动停录 + 停车 + 显示 'F' + 长响约 400ms
 * ★ 已录数据**保留**，仍可按回放键放这 80 条。 */
static void rec_fullstop(void)
{
    unsigned char i;

    recon = 0;
    cur_dur = 0;
    rec_halt();

    for (i = 0; i < 20; i++) {              /* 20 × 20ms = 400ms */
        P2 = d3_mix(DISP_F);
        beep(BEEP_TICKS);
        d_20ms();
    }
    show_state();
}

/* 录制采样（每趟主循环调用一次；内部按 10ms 时基判断到点没有）
 *   ① delta = 10ms 时基 - samp；delta == 0 -> 直接返回（还没到下一个 10ms）
 *   ② 打包当前 (动作, 档位) 与 pack 比：
 *        相同 -> cur_dur += delta（**累计**，所以主循环偶发阻塞也不丢时间）
 *        不同 -> 提交上一条，pack 换新，cur_dur 归零
 *   ③ 单条时长到上限 / 16 位溢出 -> 拆条（同 pack 再起一条，总时长守恒）
 *   ★ 两条相邻同 (动作,档位) 的记录在回放时与一条长记录完全等价
 *     （motor_set 幂等、两条之间不停车无间隙），所以演示看不出差别。 */
static void rec_sample(void)
{
    unsigned int now, delta, nd;
    unsigned char pk;

    if (recfull) {                          /* 已满 -> 不再采，去收尾 */
        rec_fullstop();
        return;
    }

    now = ms10_get();
    delta = (unsigned int)(now - samp);
    if (delta == 0)
        return;                             /* 还不到一个 10ms */
    samp = now;                             /* 基准推进到"现在" */

    pk = (unsigned char)(((cur_act << 4) & ACTPK_MASK) | (gear & GEAR_MASK));

    if (pk == pack) {
        nd = (unsigned int)(cur_dur + delta);
        if (nd < cur_dur) {                 /* 16 位溢出 -> 拆条 */
            rec_commit();
            return;
        }
        cur_dur = nd;
        if ((cur_dur >> 8) >= RECCAP_H)     /* 到单条上限 -> 拆条 */
            rec_commit();
        return;
    }

    /* 动作/档位变了：提交上一条，再开新的一条 */
    if (rec_commit())
        pack = pk;
}

/* 进入录制：停车 -> 清空上一段 -> 复位累计/基准 -> recon=1 -> 显示 'r' + 响一声 */
static void rec_enter(void)
{
    rec_halt();                             /* 录制从静止开始 */
    recn = 0;                               /* 清空上一段未保存记录 */
    recfull = 0;
    cur_dur = 0;
    samp = ms10_get();                      /* 采样基准 = 现在 */
    pack = (unsigned char)(gear & GEAR_MASK);   /* pack = (STOP << 4) | 当前档位 */
    recon = 1;
    show_state();                           /* recon = 1 -> 显示 'r' */
    beep(BEEP_TICKS);
}

/* 退出录制：封存余量 -> 回档位显示 + 响两声 */
static void rec_exit(void)
{
    if (cur_dur != 0)
        rec_commit();                       /* 最后一段还有内容就封存 */
    recon = 0;
    cur_dur = 0;
    show_state();                           /* recon 已清 -> 显示档位 */
    beep(BEEP_TICKS);                       /* 退出响**两声**（与进入的一声区分）*/
    d_20ms();
    beep(BEEP_TICKS);
}

/* 录制键（数字键 7）：录制中 -> 退出；否则 -> 进入 */
static void rec_key(void)
{
    if (recon) rec_exit();
    else       rec_enter();
}

/* 清空键（数字键 9）
 * ★ **只允许"车停着"且"不在回放"时清空**（防误触）；
 *   录制中按也可以（= 丢弃整段并退出录制）。 */
static void clr_key(void)
{
    if (mode == MODE_PLAY)
        return;                             /* 回放中 -> 忽略（先退出回放再清）*/
    if (cur_act != ACT_STOP)
        return;                             /* 车在动 -> 忽略（防误清）*/

    recon = 0;
    recn = 0;
    recfull = 0;
    cur_dur = 0;
    show_state();
    beep(BEEP_TICKS);                       /* 清空响**两声**（与进入录制的一声区分）*/
    d_20ms();
    beep(BEEP_TICKS);
}

/*=========================================================================
 * 三十九、回放
 *   ★ 回放走主循环**最前面的独立分支**：不进避障闸门、不进按键扫描。
 *     原因：闸门在近区的动作是"把动作改写成原地右转绕过去"，
 *     而回放要求"遇障**立即停车并终止**、不擅自改变示教路径" —— 语义正好相反。
 *     闸门一行都不用改，回放自己用 play_safety 判。
 *   ★ 节拍用 ms10（中断里维护的 10ms 时基），不用主循环数节拍。
 *   ★ 档位从记录里恢复（不恢复则"复现"不完整 —— 速度直接决定落点），
 *     退出回放时再恢复成进入前的值。
 * =========================================================================*/

/* 读第 playidx 条记录 -> 拆包 -> 设档位 + 驱动电机 + 记起始时刻 */
static void play_load(void)
{
    unsigned int addr = REC_ADDR(playidx);
    unsigned char pk = XBYTE[REC_BASE + addr];

    play_dur = (unsigned int)XBYTE[REC_BASE + addr + 1]
             | ((unsigned int)XBYTE[REC_BASE + addr + 2] << 8);

    gear    = pk & GEAR_MASK;               /* 恢复记录里的档位 */
    cur_act = (unsigned char)((pk >> 4) & 0x0F);

    motor_set(cur_act, gear);
    play_t0 = ms10_get();                   /* 本条的起始时刻 */
}

/* 回放安全检测（优先级最高）
 * 出：1 = 危险（调用方停车 + 终止回放）；0 = 安全
 * ★★ 与手动/寻光的避障**语义不同**：这里只判"要不要终止"，
 *    **绝不改写路径、不绕行** —— 这正是"复现示教路径"与"自主重新规划"的定义性差别。
 * ★ 车头红外**每趟**查：零成本、量程 1~2cm，兜"已经贴上了"的最后一道。
 * ★ 超声波**每 >= 60ms 一次**：HC-SR04 规格要求测距周期 >= 60ms，
 *   太密会让上一次的余振被当成回波 -> 误报 -> 回放被无端终止。
 * ⚠️ 节流计时复用 samp：录制与回放互斥（回放时 recon = 0，rec_sample 不会跑），
 *    所以这个变量在回放期间是空闲的 —— 这是**有意复用**，不是笔误。 */
static bit play_safety(void)
{
    unsigned int now;

    if (ir_det())
        return 1;                           /* 车头红外"贴上了" -> 立刻危险 */

    now = ms10_get();
    if ((unsigned int)(now - samp) < PSF_GAP)
        return 0;                           /* 还没到 60ms -> 这次不测（留给红外兜底）*/
    samp = now;

    if (us_read() < US_STOP)                /* < 5cm -> 太近 */
        return 1;
    return 0;
}

/* 退出回放：停车 -> 回手动 -> 恢复进入前的档位 -> 避障重新武装 -> 刷显示 */
static void play_exit(void)
{
    rec_halt();
    mode = MODE_MANUAL;
    gear = play_gear0;
    avst = AV_FREE;
    lastcmd = LASTCMD_NONE;                 /* 允许同一个键再按一次 */
    playidx = 0;
    show_state();
}

/* 回放被**安全**终止：停车 + 标记 + 两声短响 + 退出
 * ★ 这里**不绕行、不续播** —— 就是设计要的"安全复现"。 */
static void play_abort(void)
{
    playerr = 1;
    rec_halt();
    beep(BEEP_KEY);                         /* 两声短响（与"正常播完"区分）*/
    d_20ms();
    beep(BEEP_KEY);
    play_exit();
}

/* 进入回放 */
static void play_enter(void)
{
    if (recn == 0) {                        /* 空记录 -> 拒绝（闪 'E' + 两声，不进回放）*/
        rec_err();
        return;
    }

    play_gear0 = gear;                      /* 记下进入前的档位（退出时恢复）*/
    /* ★★ 关键：回放不进闸门，但 motor_set 会读 avst 决定要不要改写动作。
     *    若 avst 停在 AV_TURN，回放的**每一个动作**都会被改写成"原地右转"。
     *    所以进回放必须显式放行。 */
    avst = AV_FREE;
    playidx = 0;
    cur_act = ACT_STOP;
    mode = MODE_PLAY;
    lastcmd = LASTCMD_NONE;
    play_load();                            /* 装载第 0 条 */
    show_mode();                            /* 显示 'P' */
    beep(BEEP_TICKS);
}

/* 回放一步（主循环最前面的独立分支调用）
 *   ① 安全（最高优先）：危险 -> 立刻停车 + 终止（**不等待本条播完**）
 *   ② 遥控（非阻塞）：停止键 / 任意方向键 / 回放键 -> 人工终止
 *   ③ 计时：本条到点 -> 下一条；索引到头 -> 正常播完 */
static void play_step(void)
{
    unsigned int elapsed;

    if (play_safety()) {
        play_abort();                       /* ★ 危险 -> 停车终止（不绕行）*/
        return;
    }

    ir_recv_nb();
    if (irstat == 0) {
        if (ir_ib2 == KEY_PLAY) {           /* 再按回放键 = 退出 */
            play_exit();
            return;
        }
        /* 停止键与任意方向键都算"人工终止"（停止最高人工优先）。
         * 用现成的 key2act 判：方向键/停止键给动作码，其余键给 ACT_NONE。
         * ★ 只退出 + 停车，**不顺便执行该方向**。 */
        if (key2act(ir_ib2) != ACT_NONE) {
            play_exit();
            return;
        }
    }

    /* ---- 本条到点了吗 ---- */
    elapsed = (unsigned int)(ms10_get() - play_t0);
    if (elapsed < play_dur)
        return;

    playidx++;
    if (playidx >= recn) {                  /* 先判后读，绝不越界 */
        play_exit();                        /* 播完 -> 正常结束 */
        return;
    }
    play_load();
}

/* 回放键（数字键 8）
 *   录制中按 -> 先封存录制，再进回放；已在回放中按 -> 退出回放 */
static void play_key(void)
{
    if (recon)
        rec_exit();
    else if (mode == MODE_PLAY) {
        play_exit();
        return;
    }
    play_enter();
}

/*=========================================================================
 * 四十、手动模式的一步（收红外 -> 处理键 -> 松键判定）
 * =========================================================================*/
static void manual_step(void)
{
    ir_recv();

    if (irstat == 0) {                      /* 完整帧 */
        stamp_now();
        lastcmd = ir_ib2;                   /* 记下来（诊断用；已不参与去重）*/
        do_key();
    } else if (irstat == 3) {               /* 重复帧：只刷新"还按着"的时刻 */
        stamp_now();
    } else if (irstat == 2) {               /* 见到边沿但没解成 NEC */
        ir_errpr();
#if DIAG_IR
        diag_errshow();                     /* 诊断版：两声短响 + 轮播 lo/hi/cmd/~cmd */
#endif
    }
    /* irstat == 1（静默）什么都不做 */

#if DIAG_IR
    /* ★ 诊断版：把"解出的键值"送到数码管（不依赖串口 —— 打印本身会吃掉 NEC 帧）。
     *   重复帧（irstat=3）不动显示，这样按住不放时数码管会稳稳停在上次的键值上。 */
    if (irstat == 0)
        diag_keyshow();
#endif

    if (HOLD_MODE)
        ir_holdchk();
}

/*=========================================================================
 * 四十一、非手动模式的一步
 *   模式动作已经跑完，这里只收听遥控，且只认三种键：
 *     停止键（急停回手动）、数字键 1/2/3（直选模式）、加/减档。
 * =========================================================================*/
static void auto_step(void)
{
    unsigned char tgt;

    ir_recv();
    if (irstat != 0)
        return;                             /* 不是完整帧 -> 不管 */

    if (ir_ib2 == KEY_STOP) {               /* 停止最高优先：急停 -> 回手动 */
        mode = MODE_MANUAL;
        cur_act = ACT_STOP;
        motor_set(ACT_STOP, 0);
        lastcmd = LASTCMD_NONE;
        show_state();
        beep(BEEP_TICKS);
        return;
    }

    tgt = key2mode(ir_ib2);                 /* 数字键 1/2/3 直接选模式（可直接按 1 退回手动）*/
    if (tgt != 0xFF) {
        if (tgt != mode)
            mode_goto(tgt);
        return;
    }

    /* ★ 遥控数字键 5 = **超声波**避障开关：**非手动模式下也生效**，与"长按 S4"一致
     *（长按 S4 是在主循环的按键扫描里处理的，本来就跟模式无关）。
     * 寻光模式下尤其用得上：避障是它的安全保障，遥控上要够得着开关。 */
    if (ir_ib2 == KEY_AVOID) {
        avoid_toggle();
        return;
    }

    if (ir_ib2 == KEY_SPD_UP) {
        if (gear < MAXGEAR) {
            gear++;
            ml_apply();
        }
    } else if (ir_ib2 == KEY_SPD_DN) {
        if (gear > 0) {
            gear--;
            ml_apply();
        }
    }
}

/*=========================================================================
 * 四十二、变档后的统一收尾（板载按键和遥控加减档共用）
 *   手动模式：档位直接驱动电机（档位非 0 = 前进）；
 *   非手动模式：档位交给模式动作去用，这里只刷新模式代号显示。
 * =========================================================================*/
static void ml_apply(void)
{
    beepwhy('G');                           /* ★ 诊断：板载按键加减档 */
    beep(BEEP_TICKS);                       /* 变档提示音 */

    if (mode != MODE_MANUAL) {
        show_mode();
        prt_gear();
        return;
    }

    if (gear == 0 || cur_act == ACT_STOP) {
        apply_gear();                       /* 档位 0 或没有遥控动作 -> "档位即前进" */
    } else {
        motor_set(cur_act, gear);           /* 遥控动作正在跑 -> 只换速度，不改方向 */
        show_state();
    }
    prt_gear();
}

/*=========================================================================
 * 四十三、诊断（DIAG_IR = 1 时编入）
 *   收到完整帧 -> 数码管持续交替显示键值的高/低半字节（每 0.6s 换）
 *   帧被拒    -> 两声短响，然后依次轮播 4 个值（每值 1.2s，高/低半字节各 0.6s）：
 *                引导码低电平 -> 引导码高电平 -> 命令 -> 命令取反 -> 循环
 *   全程不看串口也能读出。拔电复位即可回到正常档位显示。
 * =========================================================================*/
#if DIAG_IR
#define DIAGSW_TICKS  6000                  /* 诊断显示每 600ms 换一格（6000 × 99.83us）*/

static void diag_keyshow(void)
{
    diag_cmd = ir_ib2;
    diag_on = 1;
    diag_seq = 0;
}

static void diag_errshow(void)
{
    beep(BEEP_KEY);
    d_20ms();
    d_20ms();
    d_20ms();
    d_20ms();
    beep(BEEP_KEY);
    diag_on = 2;
    diag_seq = 0;
}

static void diag_dly(void)
{
    unsigned char i;
    for (i = 0; i < 8; i++)
        d_20ms();
}

static unsigned char diag_getval(void)
{
    if (diag_on != 2)
        return diag_cmd;
    switch (diag_seq & 0x06) {
    case 0:  return ir_ledlo;
    case 2:  return ir_ledhi;
    case 4:  return ir_ib2;
    default: return ir_ib3;
    }
}

static void diag_update(void)
{
    unsigned char v;

    /* 每 600ms（6000 tick × 99.83us）推进一格显示：
     *   键值模式（diag_on=1）：只用到 diag_seq 的 bit0 -> 高半字节 / 低半字节交替；
     *   被拒模式（diag_on=2）：用 bit1..2 -> 引导码低 / 引导码高 / 命令 / 命令取反 轮播。 */
    if (diag_on == 0) {
        diag_t0 = tick_get();               /* 还没东西可显示：随时准备从头计时 */
        return;
    }
    if ((unsigned int)(tick_get() - diag_t0) >= DIAGSW_TICKS) {
        diag_t0 = tick_get();
        diag_seq = (unsigned char)((diag_seq + 1) & 0x07);
    }

    v = diag_getval();
    if (diag_seq & 0x01)
        v &= 0x0F;                          /* 低半字节 */
    else
        v = (v >> 4) & 0x0F;                /* 高半字节 */
    P2 = d3_mix(hex_seg[v]);
}
#endif

/*=========================================================================
 * 四十四、初始化
 *   ★ 铁律：内部 RAM 上电是随机值，**凡是被"读"的变量都要显式清零**。
 *     历史上漏清 MODE / 避障开关都踩过坑 ——
 *     比如不清 mode，一开机就可能不在手动模式；
 *     不清 recn，回放会去读记录区里的垃圾（虽不越界，但车会乱跑）。
 *   ⚠️ 必须在开中断（ET0 / EA / TR0）**之前**清完，否则中断已经在改 ms_div / ms10。
 * =========================================================================*/
static void init_all(void)
{
    /* ---- 上电先停车 + 静音（此刻中断还没开，直接写 P0 是安全的）---- */
    pwm_div  = 0;
    pwm_cnt  = 0;
    buz_left = 0;
    buz_quiet = 1;
    dirbits  = DIR_STOP;
    duty_a   = 0;
    duty_b   = 0;
    gear     = 0;
    klast    = 0;
    cur_act  = ACT_STOP;
    back_on  = 0;                           /* ★ A：倒车限时状态 */
    back_t0  = 0;
    prox_t   = 0;                           /* ★ C9：近距提示音计时 */
    prox_moving = 0;
    prox_hold = 0;                          /* ★ C13 修订2：上电不在宽限内（免得上电就响）*/
    prox_stop_t = 0;
    av_beep_n = 0;                          /* ★ C13：锁存提醒音已响次数 */
    av_clear_on = 0;                        /* ★ C13 修订：障碍"退远"计时 */
    av_clear_t = 0;

    /* ---- 时基与红外 ---- */
    tick_l = 0;
    tick_h = 0;
    irstat = 1;
    lastcmd = LASTCMD_NONE;
    lastt = 0;
    last_err = 0;
    ir_ledlo = 0;
    ir_ledhi = 0;

    /* ---- 模式与避障 ---- */
    mode = MODE_MANUAL;
    us_avoid_on = 1;                        /* 超声波避障上电默认开启（长按 S4 / 按 5 可关）*/
    avst = AV_FREE;                         /* 开机先放行，主循环第一趟就会刷新 */
    av_beep_t = 0;
    last_line = 0;

    /* ---- 录制 / 回放 ---- */
    recon = 0;
    playerr = 0;
    recfull = 0;
    ms_div = 0;
    ms10_l = 0;
    ms10_h = 0;
    pack = 0;
    cur_dur = 0;
    samp = 0;
    recn = 0;
    playidx = 0;
    play_dur = 0;
    play_t0 = 0;
    play_gear0 = 0;

#if DIAG_IR
    diag_on = 0;
    diag_seq = 0;
    diag_cmd = 0;
#endif

    /* ---- IO 初始状态 ---- */
    P0 = 0xC0;                              /* ENA/ENB 拉低 + 蜂鸣器静音 + P0.7 = 1 */
    P1 = 0xFF;
    P2 = d3_mix(DISP_0);                    /* 数码管 "0"（D3 由 d3_mix 给：此时避障=开 -> 亮）*/
    P3 = 0xFF;

    /* ---- 超声波状态机（★ 必须放在 P1 配好之后：us_init 会把触发脚拉低）---- */
    us_init();

    /* ---- 车头红外极性：上电自动校准 ----
     * 以"上电那一刻 P3.7 的电平"当作"无反射（前面没东西）"的参考，
     * 之后"检测到" ⇔ 当前电平与参考相反。
     * ⇒ 不管硬件是"有反射=低"还是"有反射=高"，都自动正确。
     * ⚠️ 前提：上电时车头 1~2cm 内没有东西（正常摆放就是如此）。 */
    if (IR_AVOID)
        ir_inv = 0;                         /* 上电读到高 -> 高 = 无反射 -> 检测到 = 低 */
    else
        ir_inv = 1;                         /* 上电读到低 -> 低 = 无反射 -> 检测到 = 高 */

    /* ---- 串口 9600 8N1（T1 方式2）+ T0 方式2 做 100us 时基 ---- */
    TMOD = 0x22;                            /* 高半字节 T1 方式2，低半字节 T0 方式2 */
    TH1  = 0xFD;                            /* 11059200/(384*3) = 9600 */
    TL1  = 0xFD;
    SCON = 0x50;                            /* 方式1，允许接收 */
    PCON = 0x00;                            /* SMOD = 0 */
    TR1  = 1;

    TH0  = T0_RELOAD;
    TL0  = T0_RELOAD;
    ET0  = 1;
    EA   = 1;
    TR0  = 1;

    lastt = tick_get();                     /* 让松键超时从"现在"开始算 */
    prox_stop_t = tick_get();               /* ★ C9：上电当作"刚停下"（2s 后静音）*/
    prt_boot();
    apply_gear();                           /* 档位 0 = 停车 + 显示 "0" */

#if DIAG_IR
    /* 上电响 3 声 + 显示 "8"：证明程序在跑 */
    P2 = d3_mix(DISP_8);
    beep(BEEP_TICKS); diag_dly();
    beep(BEEP_TICKS); diag_dly();
    beep(BEEP_TICKS); diag_dly();
    show_state();
#endif
}

/*=========================================================================
 * 四十五、主程序
 *   主循环一趟的顺序是有讲究的：
 *     ① 回放分支   —— 必须在避障闸门之前（语义相反，见回放一节）
 *     ② 避障闸门   —— 先测一次，只更新 avst；真正的"改写/刹停"在 motor_set 出口
 *     ③ 录制采样   —— 放在闸门之后、模式分派之前：
 *                     这样录到的是"闸门已经作用过一轮"的现场，
 *                     也保证手动/寻光/循迹任何模式下只要在录制就会被采样
 *     ④ 模式分派   —— 手动收红外遥控；寻光/循迹跑各自的模式动作
 *     ⑤ 板载按键   —— 两条路共用
 * =========================================================================*/
#if AV_SCOPE
/*-------------------------------------------------------------------------
 * ★★ 超声波自测版（AV_SCOPE=1，出 us_scope.hex）
 *
 *   只干一件事：不停地跑**本固件自己那一份 `us_read()`**，把结果直接显在数码管上。
 *   车全程停车，不响应任何输入。
 *
 *   为什么要它：`usprobe.hex` 用**它自己的**测距代码，只能证明"模块 + 接线"好不好；
 *   而我们要知道的是 **`main.c` 里这份 `us_read()` 到底能不能测到**。
 *   两者用的是同一套硬件、同一个引脚，但代码路径完全不同 —— 这个自测版才是
 *   对"避障不生效"最直接的定位工具。
 *
 *   数码管读法：
 *     `-`（只亮中间一横）= 读不到回波 / 已经够远（d >= US_NEAR = 12 tick）
 *     `0`~`9`            = **固件内部用的 tick 数本身**（就是 `us_read()` 的返回值）
 *                          距离(cm) ≈ 数字 × 1.72
 *   参考：避障门限是 **3**（<5cm 刹停）和 **12**（<21cm 右转避让），
 *         所以手放 10~15cm 时数码管应该显示 **6~9 之间的数字**。
 *
 *   同时（DEBUG_UART=1 一起编）串口会打 `S=xx`（原始 tick 数），
 *   有电脑的话对着串口更省事。
 *-------------------------------------------------------------------------*/
static const unsigned char code scope_seg[10] = {
    0x03, 0x9F, 0x25, 0x0D, 0x99, 0x49, 0x41, 0x1F, 0x01, 0x09   /* 0..9 */
};
#define SCOPE_E     0x61            /* "E" = **等不到回波上升沿**（模块没响应触发）*/
#define SCOPE_H     0x91            /* "H" = 回波来了，但**宽度 >= 12 tick**（够远）*/
#define SCOPE_DASH  0xFD            /* 只亮 g = 中间一横 "-"（bit0 = D3 = 1 灭）*/

void main(void)
{
    unsigned char d;

    /* ---- 只初始化这个自测要用的东西 ---- */
    dirbits = DIR_STOP;             /* 全程停车 */
    duty_a  = 0;
    duty_b  = 0;
    buz_quiet = 1;                  /* 静音 */
    P0 = 0xC0;
    P1 = 0xFF;
    P2 = 0xFF;
    P3 = 0xFF;

    tick_l = 0;
    tick_h = 0;
    us_init();                      /* ★ 超声波状态机初始化（C7 非阻塞版）*/

    TMOD = 0x22;                    /* T1 方式2（串口）+ T0 方式2（100us 时基）*/
    TH1  = 0xFD;
    TL1  = 0xFD;
    SCON = 0x50;
    PCON = 0x00;
    TR1  = 1;
    TH0  = T0_RELOAD;
    TL0  = T0_RELOAD;
    ET0  = 1;
    EA   = 1;
    TR0  = 1;

    prt_boot();

    while (1) {
        d = us_read();              /* ★ 就是 main.c 里那一份，一字不改
                                     *   C7 起它是**非阻塞**的：只是"取上次结果 + 必要时
                                     *   发个触发脉冲"，立刻返回，绝不会停在这儿等。 */

        /* ★ 三种失败/成功分开显示，一眼看出卡在哪一步。
         *   us_stage 由**中断**在每次测距收场时写：0 = 超时 / 1 = 够远 / 2 = 量到了，
         *   所以它反映的是"最近一次测距的结论"。 */
        if (us_stage == 0)
            P2 = SCOPE_E;           /* E：等不到回波上升沿（模块没响应触发）*/
        else if (us_stage == 1)
            P2 = SCOPE_H;           /* H：回波来了但太远（>=12 tick ≈ 21cm）*/
        else
            P2 = scope_seg[d > 9 ? 9 : d];   /* 0~9 = 固件内部 tick 数 */

        d_20ms();                   /* 20ms 一轮：刷新更及时。
                                     * ≥60ms 的测距节流由 us_read 内部保证，这里不用管。 */
    }
}
#else
void main(void)
{
    unsigned char k;

    init_all();

    while (1) {
#if DIAG_IR
        diag_update();
#endif
        /* ---- ① 回放中：走独立分支，不碰闸门也不碰按键扫描 ---- */
        if (mode == MODE_PLAY) {
            play_step();
            continue;
        }

        /* ---- ② 避障闸门 ---- */
        av_gate();

        /* ---- ③ 录制采样 ---- */
        if (recon)
            rec_sample();

        /* ---- ④ 模式分派 ---- */
        if (mode == MODE_MANUAL) {
            manual_step();
        } else {
            if (mode == MODE_LIGHT)
                light_step();
            else if (mode == MODE_TRACK)
                track_step();
            auto_step();
        }

        /* ---- ★ A：倒车限时（只在手动/录制里生效，回放不受影响）---- */
        back_guard();

        /* ---- ★ C9：避障关闭时的超声近距提示音（"倒车雷达"）---- */
        prox_beep();

        /* ---- ⑤ 板载按键（S3 短按加档 / S4 短按减档 / 长按切模式、避障开关）---- */
        k = key_scan();

        if (k == 3) {                       /* S3 长按 */
            if (recon) {
                /* 录制中长按 S3 也不许切模式（遥控 1/2/3 那条已拦截）*/
                beep(BEEP_KEY);
                d_20ms();
                beep(BEEP_KEY);
            } else {
                mode_switch();
            }
            continue;
        }
        if (k == 4) {                       /* S4 长按 -> 避障开关 */
            avoid_toggle();
            continue;
        }
        if (k == 1) {                       /* S3 短按 -> 加档 */
            if (gear >= MAXGEAR)
                continue;                   /* 已经最高档 */
            gear++;
            ml_apply();
        } else if (k == 2) {                /* S4 短按 -> 减档 */
            if (gear == 0)
                continue;                   /* 已经 0 档 */
            gear--;
            ml_apply();
        }
    }
}
#endif  /* AV_SCOPE */
