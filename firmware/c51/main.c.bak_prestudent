/*=========================================================================
 * main.c  --  智能移动机器人 正式固件（C 版）
 *-------------------------------------------------------------------------
 * 姓名     : 李家乐
 * 学号     : 03231312
 * 目标器件 : STC89C52RC @ 11.0592 MHz
 * 编译工具 : Keil C51（C51.EXE）
 *            命令行脚本见 firmware\c51\build_c_abs.ps1
 *            产物：main.hex（正常）/ main_dbg.hex（诊断）
 *-------------------------------------------------------------------------
 * 功能总览
 *   · 电机层    软件 PWM 五档调速 + 数码管档位显示 + 无源蜂鸣器提示音
 *   · 红外遥控  NEC 协议软件解码（0038 接收头），方向控制 + 加减档 + 急停
 *   · 模式状态机 手动 / 寻光 / 循迹（板载 S3 长按循环切换）
 *   · 避障闸门  超声波（近区转向避让、太近刹停锁存）+ 车头红外对管（最后 1~2cm 兜底）
 *   · 动作录制  遥控数字键 7 开始 / 结束，每 10ms 采样一次（动作 + 档位）
 *   · 动作回放  遥控数字键 8 回放，遇障立即停车终止（不绕行）
 *   · 清空记录  遥控数字键 9
 *
 * 遥控按键一览
 *   46 前进   15 后退   44 左转   43 右转   40 停止（急停回手动）
 *   5A 加档   08 减档
 *   0C 手动   18 寻光   5E 循迹        ← 直接选模式
 *   1C **超声波**避障开/关              ← ★ 与"长按 S4"等效（数字键 5）
 *   42 录制   52 回放   4A 清空
 *   （方向键在"正在前进"时按左/右 = 弧线转弯，原地不动时按 = 原地转）
 *
 * ★★ 避障分**两条独立通道**（2026-09-20 改动 C2 / C3）：
 *   ① **车头红外对管**（P3.7，1~2cm）—— **全局**，**手动/寻光/循迹都有**；
 *        触发时**直接刹车**（不转向避让、不改模式），且**关不掉**。
 *   ② **超声波**（5~21cm）—— 受手动开关（长按 S4 / 遥控数字键 5）控制；
 *        **只在手动/寻光生效**，循迹不参与（它的"右转避让"会把车推离黑线）。
 *
 * 板载按键
 *   S3 短按 = 加档       S3 长按约 1 秒 = 切下一个模式
 *   S4 短按 = 减档       S4 长按约 1 秒 = 超声波避障开关（遥控数字键 5 等效）
 *-------------------------------------------------------------------------
 * 架构约定（全部代码都遵守，改动时不要破坏）
 *   1) **主循环永不直接写 P0**。P0 只在 Timer0 中断里组装：
 *        低 4 位 = 方向位（dirbits）
 *        P0.4 / P0.5 = ENA / ENB（PWM 比较结果）
 *        P0.6 = 蜂鸣器位（1 = 静音）
 *        P0.7 恒写 1（该脚未使用，且 P0 是开漏口）
 *      这样"主循环改方向"与"中断打 PWM"各自只碰自己的变量，不会互相踩。
 *   2) 动作码 -> 电机图案的映射**只有一处**（motor_set），
 *      所有会驱动电机的地方都必须调它（档位路径走 apply_gear，它内部同源）。
 *   3) 位级标志用 bit 类型（放位寻址区，访问快、省 RAM）；
 *      中断与主循环共享的字节变量一律加 volatile，否则优化器会把它缓存进寄存器。
 *   4) 所有"到点了没有"的判断都用系统时基（tick / ms10），**不要用空循环计数**——
 *      空循环的耗时取决于编译器生成的代码，改一个优化级别就全变了。
 *-------------------------------------------------------------------------
 * 引脚（均已实测确认；现场核对以 firmware\car\config.h 为准）
 *   P0.0~P0.3 = L293D INPUT1~4（方向）      P0.4 / P0.5 = ENA / ENB（高 = 使能）
 *   P0.6 = 蜂鸣器（PNP 驱动，低 = 发声，无源需方波）
 *   P0.7 = 未使用（写 1）
 *   P2.7~P2.1 = 数码管 a~g（共阳，写 0 点亮；a 在最高位、g 在 P2.1）
 *   P2.0 = D3 指示灯（写 0 亮）—— 它与段码共用 P2，所以 P2 只能整字节写
 *          ★ C10（2026-09-21 用户需求）：D3 表示 **超声波避障开关状态**
 *            （**亮 = 开着 / 灭 = 关着**）；**不再表示"电机在动"**。
 *            规则只有一个出口 `d3_mix()` —— 所有写 P2 的地方都要过它。
 *   P3.2 = 按键 S4      P3.4 = 按键 S3      P3.3 = 红外 0038 输出
 *   P3.5 / P3.6 = 循迹左右探头（压黑线 = 高）
 *   P3.7 = 车头红外避障对管（极性由固件上电自动校准）
 *   P1.0 / P1.1 = 右 / 左光敏（见光 = 低）
 *   P1.2 / P1.3 = 超声波 Echo / Trig
 *   P3.1 = TXD（9600 调试串口，见 DEBUG_UART 开关）
 *-------------------------------------------------------------------------
 * 三个必须记住的硬件约束（都是踩过坑换来的）
 *   ① 动作记录缓冲区 240 B 放在**片内扩展 RAM**，只能用 DPTR 访问：
 *        XBYTE[] 或 xdata 指针（生成 MOVX @DPTR）。
 *      **绝不能用 pdata 指针** —— 它生成 MOVX @Ri，会拿 P2 当高 8 位地址，
 *      而 P2 整口是数码管段选，一用就把显示打花。
 *   ② 中断服务程序必须远短于 99.83us（tick 间隔）。C 的函数进出开销比手写汇编大，
 *      所以 PWM 不是每个 tick 都刷，而是每 5 个 tick 刷一次 => PWM 频率 100 Hz。
 *      100~200 Hz 是这类直流减速电机的合适区间，不会有可闻啸叫、也不会堵转发热。
 *   ③ P0 是开漏口，输出高电平靠外接排阻上拉，上升沿偏慢。
 *      所以 P0 只做"方向电平 + 低速 PWM 开关"，不做高速开关。
 *=========================================================================*/

#include <reg52.h>
#include <absacc.h>             /* XBYTE[]：片内扩展 RAM 访问（生成 MOVX @DPTR） */
#include <intrins.h>            /* _nop_()：超声波触发脉冲要精确的 ~13µs */

/*=========================================================================
 * 一、编译开关
 *   两个开关默认关掉：正式使用时开着调试串口会让红外接收漏帧。
 *   原因：9600 baud 下每个字符约 1 ms，打一行 40 字符要 42 ms，
 *         而一整帧 NEC 只有 67 ms —— 打印期间会错过下一帧的开头，
 *         于是从帧中间截到数据 -> 引导码不符 -> 被拒 -> 又打印 -> 又错过……
 *         表现就是"按遥控器完全没反应"或"按不同键都解出同一个值"。
 *   调代码时按需打开即可。
 *
 *   ★ 用 #ifndef 包起来是为了能在**命令行临时打开**，不用改源码：
 *       C51.EXE main.c SMALL DEBUG CODE DEFINE(DEBUG_UART=1)
 *     见 build_c_abs.ps1 的 -Debug 开关（额外产出一条带串口的诊断 hex）。
 *=========================================================================*/
#ifndef DEBUG_UART
#define DEBUG_UART  0           /* 1 = 编入串口打印（开发期用） */
#endif
#ifndef DIAG_IR
#define DIAG_IR     0           /* 1 = 编入数码管键值显示（排查"遥控没反应"用） */
#endif
/* ★ 超声波自测版（-Scope）：把**本固件自己的 us_read()** 单独抽出来跑，
 *   结果显示在数码管上，用来判定"是 us_read() 测不到，还是避障逻辑没用上"。
 *   见文件末尾的 scope 版 main()。 */
#ifndef AV_SCOPE
#define AV_SCOPE    0
#endif

/* 松键停车方式：1 = 前进以外松手约 0.3s 自动停；0 = 全部改成"按一下持续动"。
 * 如果发现按住遥控键时小车一颠一颠的，说明这只遥控器不发 NEC 重复帧，
 * 把这里改成 0 重编即可。 */
#define HOLD_MODE   1

/*=========================================================================
 * 二、引脚
 *=========================================================================*/
sbit KEY_S3  = P3^4;            /* 低 = 按下（短按加档 / 长按切模式） */
sbit KEY_S4  = P3^2;            /* 低 = 按下（短按减档 / 长按避障开关） */
sbit IR_IN   = P3^3;            /* 红外 0038 输出：空闲高，收到 38kHz 载波为低 */

sbit LDR_LEFT  = P1^1;          /* 左光敏：见光 = 低 */
sbit LDR_RIGHT = P1^0;          /* 右光敏：见光 = 低 */

sbit TRACK_L = P3^5;            /* 循迹左探头：压黑线 = 高 */
sbit TRACK_R = P3^6;            /* 循迹右探头：压黑线 = 高 */

sbit US_TRIG = P1^3;            /* 超声波触发（输出，高脉冲 >= 10us） */
sbit US_ECHO = P1^2;            /* 超声波回波（输入，高电平宽度正比于距离） */

sbit IR_AVOID = P3^7;           /* 车头红外对管：量程只有 1~2cm（最后一道兜底） */

/*=========================================================================
 * 三、时间参数
 *   1 个 tick = 99.83us（Timer0 方式 2，重装值 164：256-164 = 92 机器周期）
 *=========================================================================*/
#define T0_RELOAD    164        /* Timer0 重装值 */
#define PWM_DIV      5          /* 每 5 个 tick 走一个 PWM 步 => 500us/步 */
#define PWM_STEPS    20         /* 20 步 = 10ms = 100Hz；占空比 5% 一档 */
#define BUZ_DIV      5          /* 蜂鸣器每 5 个 tick 翻一次 = 1kHz */
#define MAXGEAR      5          /* 档位 0（停）.. 5（100%） */

/* ---- ★ A（2026-09-21 用户需求）：**倒车安全化**（不加硬件）----------------
 * 背景：超声波与车头红外对管**都装在车头、只朝前** ⇒ 倒车时看不到车后，
 *       软件**无法**做"后向避障"（真要做得加后向传感器）。所以倒车改成三条硬约束：
 *   ① **限速**：倒车最高 BACK_GEAR_MAX 档（数码管仍显示你设的档位，只封顶实际出力）
 *   ② **限时**：连续倒车超过 BACK_TMO_TICKS 自动停车 + 两声提示音
 *              （要继续倒就**松开再按** —— 与 R10"按住才走"同一套手感）
 *   ③ **前向超声波不参与倒车**（见 av_gate）：不再把倒车改写成"原地右转"、
 *      也不因**前方**太近而刹停 —— 否则"倒车离开前方障碍"这种安全动作会被拦下。
 * 注：**车头红外（1~2cm）保持全局、关不掉**（C2/C3 冻结语义不变）。
 * ⚠️ 限速做在 motor_set 出口，所以**回放里的倒车段也会被限速**（回放要安全，可接受）。 */
#define BACK_GEAR_MAX  2        /* 倒车最高档：2/5 ≈ 40% 占空比 */
#define BACK_TMO_TICKS 30000    /* 连续倒车最长 3.0s（30000 × 99.83us ≈ 2.995s）*/

#define BEEP_TICKS   40         /* 提示音：40 个半周期 ≈ 20ms */
#define BEEP_KEY     24         /* 收到遥控键的短提示音 ≈ 12ms */

#define MS10_DIV     100        /* 100 tick = 9.983ms ≈ 10ms：录制/回放的节拍单位 */

/* 时基超时门限（单位 tick，换成时间见注释） */
#define LP_TMO_TICKS   9984     /* S3/S4 长按门限 39×256 ≈ 1.0s */
#define HOLD_TMO_TICKS 3000     /* 松键停车：11×256+184 = 3000 tick ≈ 300ms */
#define TRK_TMO_TICKS  4864     /* 循迹脱线超时 19×256 ≈ 0.5s */
#define ERRTMO_TICKS   2000     /* "帧被拒"诊断打印限流 ≈ 200ms */
#define AVBEEP_TICKS   6912     /* 刹停锁存期间间歇响的间隔 27×256 ≈ 0.69s */
/* ★ C13（2026-09-21 用户需求）：**锁存的提醒音只响 AVBEEP_N 声，之后安静**
 *   （含"刹停那一声"在内）。锁存本身不变 —— 车仍然停着等遥控接管。
 *   用户场景：车停在障碍前 5cm 内，锁存提示音每 0.7s 一声一直响，嫌吵。
 *   ⚠️ 想恢复"一直响到接管"：把这个值改大（比如 255）即可。 */
#define AVBEEP_N       3
/* ★ C13 修订（2026-09-21，**修的是"还是会响"**）：
 *   障碍要**持续**退到 `US_CLEAR` 之外这么久，才算"真走了"、才把提醒重新武装。
 *   5000 tick ≈ 0.5s。
 *   ⚠️ 为什么必需：超声读数在**贴得极近**时会抖（有时读到 <3、有时读不到回波 FF），
 *      而一读到 `>= US_STOP` 就会把 `avst` 清成 `AV_FREE` ⇒ **锁存被反复重立**。
 *      没有这段滞回的话，每次重立都会"再响 3 声"，听起来就是"过一会儿又响"。 */
#define AV_CLEAR_TICKS 5000

/* ★ C11（2026-09-21 用户需求）：**车头红外的提示音全部静音**（**刹车保留**）
 *   1 = 静音（当前，用户选定）；0 = 让红外那一路也参与"锁存提醒"
 *   ⚠️ 改成 0 **不会**完全回到 C11 之前的行为：C13 的"一次遭遇只响 N 声"
 *      与"红外贴着就静音"这两条是叠加的，0 只放开了"贴着时是否静音"这一条。
 *   ⚠️ 这只关**声音**：**红外刹车仍然是全局的、关不掉的**（C2/C3 语义不变）。 */
#define IR_BEEP_SILENT 1
#define D20MS_TICKS    200      /* 20ms：按键去抖 / 提示音间隔 */
#define US_TRIG_TICKS  2        /* 超声波触发脉冲宽度：2 tick ≈ 200us（规格要求 >= 10us） */

/*=========================================================================
 * 四、红外 NEC 门限（单位 tick = 100us）
 *   完整帧：9ms 低 + 4.5ms 高，然后 32 位数据；每位 = 0.56ms 低 + 高电平，
 *           高电平 0.56ms 表示位 0，1.69ms 表示位 1。
 *   重复帧：9ms 低 + 2.25ms 高，之后不再变低（表示"这个键还按着"）。
 *=========================================================================*/
#define IR_LEAD_MIN   70        /* 引导码低电平下限 7ms（标称 9ms，放宽） */
#define IR_LEAD_MAX   120       /* 引导码低电平上限 12ms */
#define IR_LEADHCAP   60        /* 引导码高电平只量到 6ms 就收手：到点还高 = 重复帧 */
#define IR_LEADH_MIN  25        /* 完整帧的引导码高电平至少 2.5ms */
#define IR_REP_MIN    12        /* >= 1.2ms 才可能是引导码，短于此当噪声 */
#define IR_BIT_TH     11        /* 位高电平 >= 1.1ms 判为位 1（0.56 / 1.69 的中间） */
#define IR_BITCAP     12        /* 最后一位只量到 1.2ms 就下结论（后面是空闲高电平） */

/*=========================================================================
 * 五、动作码与电机图案
 *=========================================================================*/
#define ACT_STOP      0x00
#define ACT_FORWARD   0x01
#define ACT_BACK      0x02
#define ACT_LEFT      0x03
#define ACT_RIGHT     0x04
#define ACT_ARC_L     0x05      /* 弧线左转：两轮都正转，左轮（内轮）慢 */
#define ACT_ARC_R     0x06      /* 弧线右转：两轮都正转，右轮（内轮）慢 */
#define ACT_NONE      0xFF      /* key2act 用：不认识的键 */

#define GEAR_DEFAULT  3         /* 挂在 0 档时按方向键 -> 自动跳到这一档（60%） */

/* P0 低 4 位方向图案（IN1..IN4） */
#define DIR_STOP      0x00
#define DIR_FWD       0x05      /* IN1 + IN3 -> 两轮同向正转 */
#define DIR_BACK      0x0A      /* IN2 + IN4 -> 两轮同向反转 */
#define DIR_LEFT      0x06      /* IN2 + IN3 -> 左轮反转 + 右轮正转 = 原地左转 */
#define DIR_RIGHT     0x09      /* IN1 + IN4 -> 左轮正转 + 右轮反转 = 原地右转 */

/*=========================================================================
 * 六、避障闸门状态
 *   闸门只在"手动 / 寻光"两种模式下生效（循迹模式是主动找线，不参与）。
 *=========================================================================*/
#define AV_FREE       0         /* 放行：无障碍 */
#define AV_TURN       1         /* 近区：动作一律改写成"原地右转避让" */
#define AV_HOLD       2         /* 太近：刹停 + 锁存，车不动，决定权交给遥控 */
#define AV_HUMAN      3         /* 遥控已接管：完全放行；距离回到安全值后自动回 AV_FREE */

/* 超声波门限（1 tick ≈ 1.72cm：回波高电平 ≈ 58.3us/cm） */
#define US_NEAR       12        /* 12 tick ≈ 21cm：更近 -> 转向避让 */
#define US_STOP       3         /* 3 tick ≈ 5cm：更近 -> 刹停锁存 */
#define US_CLEAR      7         /* 7 tick ≈ 12cm：退到这儿才停止间歇响（滞回，防止抖动） */
#define US_TOUT_TICKS 250       /* ★★ 等回波上升沿的限时 = 250 tick ≈ **25ms**（C7 起由中断计时）。
                                 *   汇编版的限时是拿**高字节**和 US_UPTO(20) 比的：
                                 *       SUBB A,#20   ⇒ 实际门限 = 20×256 = 5120 tick ≈ **511ms**
                                 *   ⚠️ 这个数**不能照抄进 C 版**：C 版每趟主循环都要测一次，模块万一不响应
                                 *      就会"每趟白等一整个窗口"，窗口给到 511ms 直接把主循环拖死
                                 *      （2026-09-21 实测：遥控抽风、车几乎不动）。
                                 *   HC-SR04 正常 1ms 内就回波，25ms 已有 25 倍余量；而且 C7 起
                                 *   这个超时也不再阻塞主循环了（中断自己收场）。 */
#define US_GAP_MS10   6         /* ★★ 两次测距的最小间隔 = 6 × 10ms = **60ms**。
                                 *   HC-SR04 规格要求测距周期 ≥60ms；太密时模块会**不响应**，
                                 *   于是每一趟都白等满窗口 —— 这正是上面那个"车不动"的根因。 */
#define US_FAR        0xFF      /* 没回波 / 太远（> 255 tick ≈ 4.4m）：当作"够远" */
#define PSF_GAP       6         /* 回放中测距节流：6 × 10ms = 60ms（HC-SR04 规格要求） */

/*=========================================================================
 * 七、运行模式
 *   模式切换只靠板载 S3 长按循环（遥控数字键 1/2/3 可直接选）。
 *   避障**不是模式**，它是全局闸门。
 *=========================================================================*/
#define MODE_MANUAL   0
#define MODE_LIGHT    1         /* 寻光 */
#define MODE_TRACK    2         /* 循迹 */
#define NMODES        3         /* S3 长按循环只在这 3 个模式里转 */
#define MODE_PLAY     3         /* 回放：故意等于 NMODES -> 长按 S3 的循环永远选不到它，
                                 * 它只能靠遥控数字键 8 进入、播完自动退出。 */

/*=========================================================================
 * 八、遥控键值（cmd 字节，全部实测确认）
 *=========================================================================*/
#define KEY_FORWARD   0x46
#define KEY_BACK      0x15
#define KEY_LEFT      0x44
#define KEY_RIGHT     0x43
#define KEY_STOP      0x40
#define KEY_SPD_UP    0x5A      /* 数字键 6 */
#define KEY_SPD_DN    0x08      /* 数字键 4 */
#define KEY_M1        0x0C      /* 数字键 1 -> 手动 */
#define KEY_M2        0x18      /* 数字键 2 -> 寻光 */
