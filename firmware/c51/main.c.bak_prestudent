/*=========================================================================
 * 九、录制 / 回放参数
 *   记录单元 3 字节：Byte0 = (动作码 << 4) | (档位 & 0x0F)
 *                    Byte1 = 时长低 8 位
 *                    Byte2 = 时长高 8 位      单位 = 10ms
 *   80 条 × 3 B = 240 B，放片内扩展 RAM 的 0x0000~0x00EF。
 *=========================================================================*/
#define REC_BASE      0x0000    /* 记录区起点（XBYTE 的偏移基址） */
#define REC_MAX       80        /* 最多 80 条 */
#define REC_UNIT      3         /* 每条 3 字节 */
