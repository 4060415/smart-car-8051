static void prt_hex(unsigned char v)
{
    unsigned char hi = (v >> 4) & 0x0F;
    unsigned char lo = v & 0x0F;
    put_char(hi < 10 ? (char)('0' + hi) : (char)('A' + hi - 10));
    put_char(lo < 10 ? (char)('0' + lo) : (char)('A' + lo - 10));
}

/* ★ 2026-09-21：16 位十六进制（专为"开机计时"加，用来**判断有没有复位**）。
 *   `ms10` 是 10ms 计数：65536 × 10ms ≈ 655s ≈ 11 分钟才绕回一次，
 *   所以只要看到这个数**突然变回很小的值**，就是**复位过一次**（重启后 init_all 清零）。 */
static void prt_hex4(unsigned int v)
{
    prt_hex((unsigned char)(v >> 8));
    prt_hex((unsigned char)v);
}

