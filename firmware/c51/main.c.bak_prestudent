#define RECCAP_H      0x0B      /* 单条时长上限，按高字节判：0x0B00 × 9.983ms ≈ 28~30s。
                                 * 按高字节判是为了省掉 16 位比较；这里只要"别无限延长"，
                                 * 精度无所谓。 */

/* 记录单元的字节地址 = 索引 × 3
 * ★ 写成"移位 + 加法"而不是 * 3：16 位乘法会让编译器去调库例程 ?C?IMUL，
 *   模块里就多出一个外部符号 —— 而本固件是**手工排地址**出来的（见 tools\c51_link.py），
 *   模块内外部符号越少越好。目前除了自己写的启动代码，一个都不剩。 */
#define REC_ADDR(idx)  ((unsigned int)(((unsigned int)(idx) << 1) + (idx)))

