/*=========================================================================
 * 十四、Timer0 中断：100us 时基 + 软件 PWM + 蜂鸣器方波 + 10ms 节拍
 *   using 1 换寄存器组：中断里不必保存主循环的 R0~R7，省一大截进出开销。
 *   ★ 普通 tick 只做两次加法和一次比较；真正组装 P0 每 5 个 tick 才发生一次。
 *   ★ 中断总时长必须 < 99.83us，否则会丢 tick、PWM 会崩。
 *=========================================================================*/
void timer0_isr(void) interrupt 1 using 1
{
    unsigned char a;

    /* ---- ① 100us 系统时基：红外脉宽测量、各种超时都靠它，必须每次都加 ---- */
    if (++tick_l == 0)
        tick_h++;

    /* ---- ② PWM：每 PWM_DIV 个 tick 走一步 ---- */
    if (++pwm_div >= PWM_DIV) {
        pwm_div = 0;

        if (++pwm_cnt >= PWM_STEPS)
            pwm_cnt = 0;

        ena = (pwm_cnt < duty_a);
        enb = (pwm_cnt < duty_b);

        /* ---- ③ 蜂鸣器方波：每个 PWM 步（500us）翻一次 = 1kHz ---- */
        if (buz_left) {
            buz_left--;
            buz_quiet = ~buz_quiet;
        } else {
            buz_quiet = 1;                  /* 半周期用完 -> 静音 */
        }

        /* ---- ④ 组装 P0（主循环永不写 P0，只改上面这几个变量）---- */
        a = 0x80;                           /* P0.7 恒 1（未使用，且 P0 是开漏口） */
        a |= dirbits;                       /* D0~D3 = IN1~IN4 方向 */
        if (ena) a |= 0x10;                 /* P0.4 = ENA */
        if (enb) a |= 0x20;                 /* P0.5 = ENB */
        if (buz_quiet) a |= 0x40;           /* P0.6 = 1 -> 静音 */
        P0 = a;
    }

    /* ---- ⑤ 10ms 节拍分频：每个 tick 都加（100 tick × 99.83us = 9.983ms）----
     * 放在 P0 写入之后，所以对 PWM 时序零影响。
     * 必须放中断里：主循环一趟最长会被红外接收阻塞 25.6ms，
     * 用它数 10ms 节拍会有 ±26ms 误差 —— 100ms 的动作会跑成 126ms，远超 ±5% 要求。 */
    if (++ms_div >= MS10_DIV) {
        ms_div = 0;
        if (++ms10_l == 0)
            ms10_h++;
    }

    /* ---- ⑥ ★ 超声波回波采样（非阻塞状态机；同样放在 P0 写入之后，PWM 零影响）----
     * 中断每 99.83µs 精确跑一次，所以数出来的回波宽度**与主循环快慢无关**。
     * 主循环只负责"发触发"和"取结果"，**一次都不等**（见二十八节）。
     * 开销：空闲时（绝大多数 tick）只有一条 `MOV A,us_st / JZ` ≈ 4 个机器周期；
     *       只有测距那 1~12 个 tick 才往下多走几层判断，可以忽略。 */
    if (us_st != US_ST_IDLE) {
        if (us_st == US_ST_WAIT) {
            if (US_ECHO) {                  /* 上升沿到了：开始数宽度 */
                us_wid = 0;
                us_st  = US_ST_HIGH;
            } else if (us_wait < US_TOUT_TICKS) {
                us_wait++;                  /* 还没来，接着等（主循环不受影响）*/
            } else {                        /* 超时：模块没响应这次触发 */
                us_st  = US_ST_IDLE;
                us_res = US_FAR;
                us_got = 1;
#if AV_SCOPE
                us_stage = 0;               /* 自测版 E：等不到上升沿 */
#endif
            }
        } else {                            /* US_ST_HIGH：数回波宽度 */
            if (US_ECHO) {
                if (us_wid < US_NEAR) {
                    us_wid++;               /* 还没够远，接着数 */
                } else {                    /* 已经够远，不必再等下降沿 */
                    us_st  = US_ST_IDLE;
                    us_res = US_FAR;
                    us_got = 1;
#if AV_SCOPE
                    us_stage = 1;           /* 自测版 H：回波够远 */
#endif
                }
            } else {                        /* 下降沿：宽度就是距离 */
                us_st  = US_ST_IDLE;
                us_res = us_wid;
                us_got = 1;
#if AV_SCOPE
                us_stage = 2;               /* 自测版：正常量到了 */
#endif
            }
        }
    }
}

/*=========================================================================
 * 十五、时基读取（原子）
 *   16 位计数器分两个字节，读的中途若被中断打断，可能读到"半新半旧"的组合
 *   （例如低字节刚进位：应读到 0x0100，却读成 0x00FF）。
 *   关中断只有几个机器周期，远小于一个 tick，不会丢计时。
 *=========================================================================*/
static unsigned int tick_get(void)
{
    unsigned int t;
    ET0 = 0;
    t = ((unsigned int)tick_h << 8) | tick_l;
    ET0 = 1;
    return t;
}

static unsigned int ms10_get(void)
{
    unsigned int t;
    ET0 = 0;
    t = ((unsigned int)ms10_h << 8) | ms10_l;
    ET0 = 1;
    return t;
}

/*=========================================================================
 * 十六、短延时
 *   用系统时基实现，不用空循环 —— 空循环的耗时随编译器优化级别变化，
 *   而这里要的是"实实在在的 20ms"（按键去抖、提示音间隔）。
 *   中断仍在后台跑 PWM，所以延时期间电机不停。
 *=========================================================================*/
static void d_20ms(void)
{
    unsigned int t0 = tick_get();
    while ((unsigned int)(tick_get() - t0) < D20MS_TICKS)
        ;
}

/*=========================================================================
 * 十七、蜂鸣器
 *   入：half_cycles = 半周期个数（每个半周期 500us ≈ 1kHz）
 *   只置计数，真正翻转由中断做，主循环不阻塞。
 *   改 buz_left / buz_quiet 时短暂关中断，免得中断正好读到"改了一半"的状态。
 *=========================================================================*/
static void beep(unsigned char half_cycles)
{
    if (half_cycles == 0) {                 /* 关掉鸣叫 */
        ET0 = 0;
        buz_left = 0;
        buz_quiet = 1;
        ET0 = 1;
        return;
    }
    ET0 = 0;
    buz_left = half_cycles;
    buz_quiet = 0;                          /* 低电平 -> PNP 导通 -> 开始发声 */
    ET0 = 1;
}

/*=========================================================================
 * 十八、串口调试输出（9600 8N1）
 *   DEBUG_UART = 0 时全部是空函数，调用点照旧，不占体积。
